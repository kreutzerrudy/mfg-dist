local FILE = "/storecheck-results.txt"

local findings = 0
local mismatches = {}

local function append(text)
local handle = fs.open(FILE, fs.exists(FILE) and "a" or "w")
if not handle then return end
handle.write(text .. "\n")
handle.close()
end




local function say(label, value)
local line = ("  %-46s %s"):format(label, tostring(value))
print(line)
append(line)
findings = findings + 1
end

local function note(text)
print("    " .. text)
append("    " .. text)
end




local function expect(label, got, want, why)
local ok = got == want
say(label .. (ok and "  [MATCHES]" or "  [DIFFERS]"), got)
if not ok then
mismatches[#mismatches + 1] = ("%s: got %s, code assumes %s -- %s")
:format(label, tostring(got), tostring(want), why or "")
end
return ok
end

local function heading(text)
print("")
print("== " .. text)
append("")
append("== " .. text)
end

append("")
