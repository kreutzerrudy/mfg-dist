heading("S8.11: may an inventory push to itself?")

local selfDevice = status.devices[1]










local function slotsHolding(device, item)
local found = {}
for slot, stack in pairs(inv.list(device) or {}) do
if stack.name == item then
found[#found + 1] = {slot = slot, count = stack.count}
end
end
table.sort(found, function(a, b) return a.count < b.count end)
return found
end

local function firstEmptySlot(device)
local listing = inv.list(device) or {}
local size = inv.size(device) or 0
for slot = 1, size do
if not listing[slot] then return slot end
end
return nil
end

local held = slotsHolding(selfDevice, sampleItem)
local splitMade = false

if #held == 1 and held[1].count >= 2 then
local empty = firstEmptySlot(selfDevice)
if empty then
local split = inv.push(selfDevice, selfDevice, held[1].slot, 1, empty)
expect("split one item into an empty slot (self-push, easy case)",
split or 0, 1, "defrag needs same-device pushes to work at all")
splitMade = (split or 0) == 1
if not splitMade then
note("self-push into an EMPTY slot of the same inventory failed, so a")
note("one-device volume cannot be reorganised at all. store.defrag")
note("degrades to needing a second device (S8.11).")
end
held = slotsHolding(selfDevice, sampleItem)
else
note("no empty slot to split into -- cannot establish the precondition")
end
end

if #held < 2 then
say("self-push merge", "NOT TESTED -- could not create two stacks of one item")
note("needs one item with at least 2 of it, and one free slot")
else
local totalBefore = store.count("/pool", sampleItem)
local donor, target = held[1], held[#held]

local moved, pushErr = inv.push(selfDevice, selfDevice, donor.slot,
donor.count, target.slot)
expect("self-push merged two stacks of one item", moved or 0, donor.count,
"defrag on a single-device volume depends on this (S8.11)")

if not moved or moved == 0 then
note("SELF-PUSH DOES NOT MERGE on this block. Consequence: a volume of ONE")
note("device cannot consolidate -- defrag needs a second device to route")
note("through. store.defrag skips a refusing target, so it degrades rather")
note("than failing, but a one-chest pool stays fragmented.")
if pushErr then note("error: " .. tostring(pushErr)) end
else
note("self-push works, so a single-device volume CAN defragment --")
note("a one-chest pool is not a special case (S8.11).")
end

expect("conservation across split and merge",
store.count("/pool", sampleItem), totalBefore,
"nothing may be created or destroyed by a probe")
say("slots holding " .. sampleItem .. " afterwards",
#slotsHolding(selfDevice, sampleItem))
end







heading("S8.1: pushing onto a different item must refuse")

local other, otherSlot = nil, nil
for slot, stack in pairs(inv.list(selfDevice) or {}) do
if stack.name ~= sampleItem then other, otherSlot = stack.name, slot end
end

if not other then
say("mixed-slot push", "NOT TESTED -- pool holds only one item type")
note("put a second item type in the pool chest to settle it")
else
local src = nil
for slot, stack in pairs(inv.list(selfDevice) or {}) do
if stack.name == sampleItem then src = slot end
end
local before = store.count("/pool")
local refused = inv.push(selfDevice, selfDevice, src, 1, otherSlot)
expect("pushing " .. sampleItem .. " onto " .. other, refused or 0, 0,
"S8.1 assumes no exchange primitive exists")
say("conservation", store.count("/pool") == before and "OK" or "ITEMS LOST")
end



heading("defragmenting /pool")

local pressureBefore = store.slots("/pool")
local totalBefore = 0
for _, count in pairs(store.manifest("/pool") or {}) do
totalBefore = totalBefore + count
end

local result, defragErr = store.defrag("/pool")
if not result then
say("defrag refused", tostring(defragErr))
else
say("items merged", result.merged)
say("slots freed", result.slotsFreed)
say("peripheral calls", result.calls)
say("keys considered", result.keys)

local pressureAfter = store.slots("/pool")
say("slots used before / after",
("%d / %d"):format(pressureBefore.used, pressureAfter.used))

local totalAfter = 0
for _, count in pairs(store.manifest("/pool") or {}) do
totalAfter = totalAfter + count
end
expect("total items conserved across defrag", totalAfter, totalBefore,
"S8.9: a defrag never voids")

if pressureAfter.used > pressureBefore.used then
mismatches[#mismatches + 1] = "defrag INCREASED slot usage"
end
end






