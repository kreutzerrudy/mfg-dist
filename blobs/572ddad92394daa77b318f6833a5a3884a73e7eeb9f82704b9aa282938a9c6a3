heading("item identity: does list() carry nbt?")

local sawNbtField, sampleItem, sampleDevice, sampleSlot = false, nil, nil, nil
for _, device in ipairs(status.devices) do
for slot, stack in pairs(inv.list(device) or {}) do
if not sampleItem then
sampleItem, sampleDevice, sampleSlot = stack.name, device, slot
end
if stack.nbt ~= nil then sawNbtField = true end
end
end

if not sampleItem then
printError("/pool is empty -- put ~100 of one stacking item in it and re-run")
append("ABORTED: /pool empty")
return
end

say("a sample item", sampleItem)
say("any stack reported an nbt field", sawNbtField)
if not sawNbtField then
note("NOT a failure by itself: plain items legitimately have no nbt.")
note("It means this run could not confirm nbt reporting works. Put an")
note("ENCHANTED or NAMED item in /pool and re-run to settle it.")
note("If nbt is never reported, keys degrade to ids alone (S4.5) and two")
note("variants of one id would be treated as fungible -- the one failure here")
note("that can actually mix items.")
end










heading("item attributes: maxCount and tags")

local detail = inv.detail(sampleDevice, sampleSlot)
if not detail then
say("getItemDetail returned", "nil -- attributes unavailable")
note("room() would fall back to an assumed 64 and report exact=false (S5.4)")
else
say("detail.name", detail.name)
say("detail.maxCount", tostring(detail.maxCount))
say("detail.displayName", tostring(detail.displayName))




local tagCount, firstTags, vanilla = 0, {}, {}
for tag in pairs(detail.tags or {}) do
tagCount = tagCount + 1
if tag:sub(1, 10) == "minecraft:" then vanilla[#vanilla + 1] = tag
elseif #firstTags < 4 then firstTags[#firstTags + 1] = tag end
end
table.sort(vanilla)
for _, tag in ipairs(vanilla) do table.insert(firstTags, 1, tag) end
while #firstTags > 4 do table.remove(firstTags) end
say("detail.tags count", tagCount)
if tagCount > 0 then
note("tags: " .. table.concat(firstTags, ", ") .. (tagCount > 4 and ", ..." or ""))
note("tag selectors are viable -- '#" .. (firstTags[1] or "?") .. "' would match this")
else
note("NO TAGS reported. Tag-shaped bills of material (S10.3) would not")
note("work on this pack, and recipes must stay keyed on exact ids.")
end


local wrapped = peripheral.wrap(sampleDevice)
if wrapped and wrapped.getItemLimit then
local ok, limit = pcall(wrapped.getItemLimit, sampleSlot)
say("getItemLimit for the same slot (NEVER used)", ok and tostring(limit) or "error")
