local function editDocument(view, height)
local close = doc.button("close", {key = "x", action = {kind = "close-editor"},
keep = doc.REQUIRED, name = "close-editor"})
local rows = {app.header(view, editor.title(view.editor), close)}
editor.document(view.editor, rows, height)
return rows
end

function machines.document(view, width, height)
local rows
if view.screen == "edit" and view.editor then
rows = editDocument(view, height)
elseif view.screen == "machine" then
rows = machineDocument(view, height)
elseif view.screen == "limit" and view.limit then
rows = limitDocument(view, height)
elseif view.screen == "confirm" then
rows = confirmDocument(view)
else
rows = listDocument(view, height)
end
return doc.stack(rows, {name = "machines"})
end

function machines.settle(view, report)
if view.screen == "list" then return app.settle(view.list, report, "machine") end
if view.screen == "types" then return app.settle(view.typeList, report, "type") end
if view.screen == "machine" then return app.settle(view.runs, report, "run") end
if view.screen == "limit" then return app.settle(view.itemList, report, "item") end
if view.screen == "edit" and view.editor then return editor.settle(view.editor, report) end
return false
end



local function ask(view, command, params)
app.ask(view, {kind = "act", command = command, params = params})
end

function machines.act(view, action)
local kind = action and action.kind
if view.screen == "edit" and view.editor then
if kind == "close-editor" then
local ed = view.editor
if ed.state and ed.state.dirty then
view.result = {text = ("your changes to %s are kept as a draft on this "
.. "computer"):format(ed.state.tree.machine or "the new script"),
colour = "warn"}
end
view.editor, view.screen = nil, view.editFrom or "types"
view.readAt = nil
return true
end
return editor.act(view.editor, action)
end
if kind == "edit" then
view.editFrom = view.screen
view.editor = editor.new(view, action.script)
view.screen = "edit"
return true
end
local lists = {list = view.list, types = view.typeList, limit = view.itemList,
machine = view.runs}
local list = lists[view.screen]
if list and app.page(list, kind, action) then return true end

if kind == "show" then
view.screen = action.screen
if action.screen ~= "machine" then view.openRun = nil end
return true
elseif kind == "open" then
if view.chosen ~= action.machine then
view.detail, view.openRun = nil, nil
view.runs = app.newList()
end
view.chosen, view.screen, view.detailAt = action.machine, "machine", nil
return true
elseif kind == "run" then
view.openRun = (view.openRun ~= action.index) and action.index or nil
return true
elseif kind == "signal" then


local path = ("/%s/%s"):format(view.chosen, action.port)
if action.op == "on" or action.op == "off" then
ask(view, "set_signal", {signal = path, level = action.op == "on" and 15 or 0})
elseif action.op == "pulse" then
ask(view, "pulse", {signal = path, level = 15, length = 20})
elseif action.op == "release" then
ask(view, "release_signal", {signal = path})
end
return true
elseif kind == "enable" then
ask(view, "enable_machine", {machine = view.chosen})
return true
elseif kind == "disable" then
ask(view, "disable_machine", {machine = view.chosen})
return true
elseif kind == "forget" then
view.screen = "confirm"
return true
elseif kind == "yes" then
view.screen = "machine"
ask(view, "forget_machine", {machine = view.chosen})
return true
elseif kind == "no" then
view.screen = "machine"
return true
elseif kind == "open-limit" then
local current = view.detail and view.detail.limit
view.limit = {item = current and current.item,
at = current and tostring(current.at) or "",
resume = current and current.resume ~= current.at and tostring(current.resume)
or "",
field = "at"}
view.itemList = app.newList()
view.screen = "limit"
app.ask(view, {kind = "items"})
return true
elseif kind == "limit-item" then
view.limit.item = action.item
return true
elseif kind == "focus" then
if view.limit then view.limit.field = action.field end
return true
elseif kind == "set-limit" then
if machines.limitBlocked(view) then return false end
local limit = view.limit
ask(view, "limit_machine", {machine = view.chosen, item = limit.item,
at = tonumber(limit.at), resume = tonumber(limit.resume)})
view.screen = "machine"
return true
elseif kind == "clear-limit" then
ask(view, "limit_machine", {machine = view.chosen})
view.screen = "machine"
return true
end
return false
end



function machines.searching(view)
if not view.machines then return nil end
if view.screen == "list" then return view.list end
if view.screen == "types" then return view.typeList end
return nil
end



local function limitKeyboard(view, event)
local limit, list = view.limit, view.itemList
if event.kind == "char" and type(event.char) == "string" and event.char:match("^%d$") then
local value = limit[limit.field]
if #value < machines.AMOUNT_DIGITS then
limit[limit.field] = ((value .. event.char):gsub("^0+", ""))
end
return true
end
if event.kind == "key" and keys
and (event.key == keys.backspace or event.key == keys.delete) then
local value = limit[limit.field]
if value ~= "" then
limit[limit.field] = event.key == keys.delete and "" or value:sub(1, -2)
return true
end
end
if view.items then return app.type(list, event) end
return false
end




function machines.keyboard(view, event)
if not event then return false end
if view.screen == "edit" and view.editor then return editor.keyboard(view.editor, event) end
if view.screen == "limit" and view.limit then return limitKeyboard(view, event) end
if view.screen == "machine" then
if event.kind == "scroll" then
app.scroll(view.runs, event.dir or 0)
return true
end
if event.kind == "key" and keys and (event.key == keys.pageDown
or event.key == keys.pageUp) then
app.page(view.runs, event.key == keys.pageDown and "next" or "prev")
return true
end
return false
end
local list = machines.searching(view)
if list then return app.type(list, event) end
return false
end


function machines.handle(view, event, grid)
local took, chose = machines.keyboard(view, event)
if took then
if chose then machines.act(view, chose) end
return true
end
if not input.heard(event) then return false end
local action = input.actionFor(grid, event)
if not action then return false end
return machines.act(view, action)
end

return machines
