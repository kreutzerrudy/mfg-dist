






























local doc = require("mfg.hmi.doc")
local input = require("mfg.hmi.input")
local app = require("mfg.hmi.app")
local cart = require("mfg.hmi.cart")

local storage = {}

storage.EVERY = 5
storage.BACKGROUND = 30
storage.READ = {timeout = 3, attempts = 2}

storage.TAKE = {timeout = 20, attempts = 1}

storage.STACK = 64
storage.AMOUNT_DIGITS = 6



function storage.new(opts)
opts = opts or {}
return {
host = opts.host or "mfg",
display = opts.display,
transport = opts.transport,
now = opts.now,

items = nil,
version = nil,
names = opts.names or {},
pending = {}, waiting = {},
bound = {},
readWhy = nil,
readAt = nil,

offer = nil,

screen = "browse",
item = nil,
amount = "",
field = "search",
list = app.newList(),

cart = cart.new(opts.cartStore),
cartList = app.newList(),
editing = nil,
editText = "",
run = nil,
holding = nil,
holdDue = false,
holdWhy = nil,

sending = nil,
result = nil,
link = {state = "unknown"},
queue = {},
}
end



function storage.nameOf(view, item)
local known = view.names and view.names[item]
return (known and known.name) or app.shortName(item)
end

local function stackOf(view, item)
local known = view.names and view.names[item]
return (known and known.stack) or storage.STACK
end

local function sortedItems(view)
local items = {}
for item in pairs(view.items or {}) do items[#items + 1] = item end
table.sort(items, function(a, b)
local na, nb = storage.nameOf(view, a):lower(), storage.nameOf(view, b):lower()
if na ~= nb then return na < nb end
return a < b
end)
return items
end


local function freeOf(view, item)
local entry = view.items and view.items[item]
return entry and entry.free or 0
end


local function mineOf(view, item)
local entry = view.items and view.items[item]
return entry and entry.mine or 0
end


local function lineFree(view, item)
return freeOf(view, item) + mineOf(view, item)
end


function storage.count(view)
local wanted = tonumber(view.amount) or 0
if view.item then wanted = math.min(wanted, freeOf(view, view.item)) end
return math.max(0, wanted)
end


function storage.blocked(view)
if view.sending or view.run then return "a withdrawal is being sent" end
if not view.items then return "reading the pool.." end
if view.bound.output == false then return "bind /io/out first, in Bind" end
if not view.item then return "pick an item" end
if freeOf(view, view.item) < 1 then return "none of it is free" end
if storage.count(view) < 1 then return "type how many" end
return nil
end



function storage.addBlocked(view)
if not view.items then return "reading the pool.." end
if not view.item then return "pick an item" end
if (tonumber(view.amount) or 0) < 1 then return "type how many" end
if not cart.find(view.cart, view.item) and #view.cart.lines >= cart.MAX_LINES then
return ("the cart holds %d lines at most"):format(cart.MAX_LINES)
end
return nil
end


function storage.cartTakes(view)
local n = 0
for _, line in ipairs(view.cart.lines) do
n = n + math.min(line.amount, lineFree(view, line.item))
end
return n
end

local function cartShort(view)
local short = 0
for _, line in ipairs(view.cart.lines) do
if line.amount > lineFree(view, line.item) then short = short + 1 end
end
return short
end


local function cartChanged(view)
view.holdDue = true
end





function storage.holdNeeded(view)
if not view.holding or not view.items then return false end
local wanted = {}
for _, line in ipairs(view.cart.lines) do
wanted[line.item] = line.amount
local mine = mineOf(view, line.item)
if mine > line.amount then return true end
if mine < line.amount and freeOf(view, line.item) > 0 then return true end
end
for item, entry in pairs(view.items) do
if (entry.mine or 0) > 0 and not wanted[item] then return true end
end
return false
end




function storage.refresh(view)
view.readAt = nil
end





function storage.nextJob(view)
local job = table.remove(view.queue, 1)
if job then return job end
if view.run and #view.run.todo > 0 then
local line = table.remove(view.run.todo, 1)
return {kind = "withdraw", item = line.item, count = line.count, cart = true}
end
if view.holdDue and view.holding and not view.run then
view.holdDue = false
return {kind = "hold"}
end
local every = (view.onScreen == false) and storage.BACKGROUND or storage.EVERY
if not view.readAt or (app.clock(view) - view.readAt) >= every * 1000 then
return {kind = "read"}
end
return nil
end

function storage.exchange(view, job)
local body, opts
if job.kind == "read" then
view.readAt = app.clock(view)
body, opts = {command = "available", since = view.version}, storage.READ
elseif job.kind == "withdraw" then
body = {command = "withdraw", item = job.item, count = job.count, operator = true}


if job.cart and view.holding then body.held = true end
opts = storage.TAKE
view.sending = {item = job.item, count = job.count, since = app.clock(view)}
if not job.cart then view.result = nil end
elseif job.kind == "hold" then
local lines = {}
for _, line in ipairs(view.cart.lines) do lines[line.item] = line.amount end
body, opts = {command = "hold", lines = lines}, storage.READ
else
return false
end
storage.apply(view, job, view.transport.request(body, opts) or {})
return true
end



local function cartLineDone(view, job, answer)
local run = view.run
if not run then return end
local moved = (answer.status == app.COMPLETED and answer.moved) or 0
run.moved = run.moved + moved
local _, line = cart.find(view.cart, job.item)
if line then cart.set(view.cart, job.item, line.amount - moved) end
cartChanged(view)
if answer.status ~= app.COMPLETED then
run.failed[#run.failed + 1] = ("%s: %s"):format(storage.nameOf(view, job.item),
tostring(answer.reason or answer.status))
end
run.left = run.left - 1
if run.left > 0 then return end

view.run = nil
local stays = #view.cart.lines
local text = ("took %d items to /io/out"):format(run.moved)
if stays > 0 then
text = text .. ("; %d line%s short, kept in the cart"):format(stays,
stays == 1 and "" or "s")
end
if #run.failed > 0 then text = text .. " -- " .. table.concat(run.failed, "; ") end
view.result = {text = text, colour = (stays > 0 or #run.failed > 0) and "warn"
or "good"}
app.sound(view, (stays == 0 and #run.failed == 0) and "done" or "refused")
end

function storage.apply(view, job, answer)
app.noteLink(view, answer)
if job.kind == "read" then
local delta = answer.full == false and view.items ~= nil
if answer.status == app.COMPLETED and (delta or type(answer.items) == "table") then


local changed = false
if delta then
for item, record in pairs(answer.changed or {}) do
view.items[item] = record
changed = true
end
for _, item in ipairs(answer.removed or {}) do
view.items[item] = nil
changed = true
end
else
view.items = answer.items
changed = true
end
view.version = answer.version
view.readWhy = nil
view.holding = answer.holding == true
view.pending, view.waiting = answer.pending or {}, answer.waiting or {}
view.bound = answer.bound or {}

for item, known in pairs(answer.names or {}) do
view.names[item] = known
changed = true
end


if changed then view.entries = nil end
view.offer = view.offer or {name = "available"}
if storage.holdNeeded(view) then view.holdDue = true end
else
view.readWhy = tostring(answer.reason or answer.status or "no answer")
end
elseif job.kind == "hold" then


if answer.status == app.COMPLETED then
view.holdWhy = nil
else
view.holdWhy = tostring(answer.reason or answer.status or "no answer")
end
view.readAt = nil
elseif job.kind == "withdraw" then
view.sending = nil
view.readAt = nil
if job.cart then return cartLineDone(view, job, answer) end
view.result = {status = answer.status or app.REJECTED, reason = answer.reason,
fields = answer, item = job.item, count = job.count}
app.sound(view, (answer.status == app.COMPLETED and not answer.short)
and "done" or "refused")
end
end



local function summary(view, label, items, name)
local parts = {}
for item, count in pairs(items or {}) do
parts[#parts + 1] = ("%d %s"):format(count, storage.nameOf(view, item))
end
table.sort(parts)
if #parts == 0 then return nil end
return doc.text((" %s: %s"):format(label, table.concat(parts, ", ")),
{colour = "dim", truncate = doc.TRUNCATED, keep = 5, name = name})
end




local function statusRow(view)
local function line(text, colour)
return doc.text(" " .. text, {colour = colour, wrap = true,
keep = app.KEEP_STATUS, name = "status"})
end
if view.run then
return line(("withdrawing the cart: %d of %d lines.."):format(
view.run.lines - view.run.left, view.run.lines), "warn")
end
if view.sending then
return line(("withdrawing %d %s.."):format(view.sending.count,
storage.nameOf(view, view.sending.item)), "warn")
end
local result = view.result
if not result then return line("", "text") end
if result.text then return line(result.text, result.colour or "text") end
local fields = result.fields or {}
if result.status == app.COMPLETED then
local text = ("%d %s in /io/out"):format(fields.moved or 0,
storage.nameOf(view, result.item))
if fields.short then text = text .. " -- " .. tostring(fields.reason) end
return line(text, fields.short and "warn" or "good")
elseif result.status == app.TIMED_OUT then
return line(("no answer from %s -- look in /io/out before asking again")
:format(view.host), "warn")
end
return line("refused: " .. tostring(result.reason), "bad")
end



local function whyRow(rows, why)
if why and why ~= "" then
rows[#rows + 1] = doc.text(" " .. why, {colour = "dim", wrap = true,
keep = app.KEEP_STATUS - 1, name = "why-blocked"})
end
end

local function footer(view, rows)
rows[#rows + 1] = statusRow(view)
rows[#rows + 1] = summary(view, "coming in", view.pending, "pending")
or doc.text("", {keep = 1, name = "pending"})
rows[#rows + 1] = summary(view, "in /io/out", view.waiting, "waiting")
or doc.text("", {keep = 1, name = "waiting"})
rows[#rows + 1] = doc.spacer()
end


local function chosenRow(view)
if not view.item then

return doc.text(" pick an item above", {colour = "dim", keep = doc.REQUIRED,
truncate = doc.TRUNCATED, name = "chosen"})
end
local entry = view.items[view.item] or {}
local free = ("%d free"):format(entry.free or 0)
if (entry.promised or 0) > 0 then
free = free .. (", %d promised"):format(entry.promised)
end
local others = (entry.holds or 0) - (entry.mine or 0)
if others > 0 then free = free .. (", %d held"):format(others) end
local _, line = cart.find(view.cart, view.item)
if line then free = free .. (", %d in cart"):format(line.amount) end
return doc.row({
doc.gap(1),
doc.text("  ", {bg = app.chipFor(view.item), name = "chosen-chip"}),
doc.gap(1),
doc.text(storage.nameOf(view, view.item), {colour = "title", width = "fill",
truncate = doc.TRUNCATED, name = "chosen-name"}),
doc.gap(1),
doc.text(free, {colour = "dim", keep = 3, name = "chosen-free"}),
doc.gap(1),
}, {keep = doc.REQUIRED, name = "chosen"})
end



local function amountRow(view)
local focused = view.field == "amount"
local shown = view.amount .. (focused and "_" or "")
local note, noteColour = "", "dim"
local free = view.item and freeOf(view, view.item)
local typed = tonumber(view.amount)
if free and typed and typed > free then
note, noteColour = ("only %d free"):format(free), "warn"
elseif view.item then
note = ("stack %d"):format(stackOf(view, view.item))
end
return doc.row({
doc.gap(1),
doc.text("Amount", {colour = "label", keep = doc.REQUIRED, name = "amount-label"}),
doc.gap(1),
doc.text(" " .. shown, {width = 8, colour = focused and "title" or "text",
bg = "field", truncate = doc.TRUNCATED, keep = doc.REQUIRED,
action = {kind = "focus", field = "amount"}, name = "amount"}),
doc.gap(1),


doc.button("+1 stack", {action = {kind = "stack"}, keep = 3, name = "stack"}),
doc.gap(1),
doc.button("all", {action = {kind = "all"}, keep = 4, name = "all"}),
doc.gap(1),
doc.text(note, {colour = noteColour, truncate = doc.TRUNCATED, keep = 2,
name = "amount-note"}),
}, {keep = doc.REQUIRED, name = "amount-row"})
end

local function cartButton(view)
local n = #view.cart.lines
return doc.button(n > 0 and ("Cart %d"):format(n) or "Cart", {key = ">",
colour = "selected", action = {kind = "open-cart"}, keep = doc.REQUIRED,
name = "open-cart"})
end

local function browseDocument(view, height)
local rows = {app.header(view, "STORAGE", cartButton(view)), doc.rule({keep = 2})}

if not view.items then
rows[#rows + 1] = doc.text(view.readWhy and ("the controller refused: "
.. view.readWhy) or "reading the pool..", {colour = view.readWhy and "bad"
or "dim", wrap = true, keep = doc.REQUIRED, name = "read-state"})
footer(view, rows)
return rows
end





if not view.entries then
local built = {}
for _, item in ipairs(sortedItems(view)) do
local entry = view.items[item]

local away = {}
if (entry.promised or 0) > 0 then
away[#away + 1] = ("%d promised"):format(entry.promised)
end
if (entry.holds or 0) > 0 then
away[#away + 1] = ("%d held"):format(entry.holds)
end
local note = tostring(entry.free)
if #away > 0 then note = note .. " (" .. table.concat(away, ", ") .. ")" end
built[#built + 1] = {value = item, label = storage.nameOf(view, item),
note = note, chip = app.chipFor(item)}
end
view.entries = built
end
local entries = view.entries
for _, entry in ipairs(entries) do entry.selected = (entry.value == view.item) end
if #entries == 0 then
rows[#rows + 1] = doc.text("the pool is empty -- put things in /io/in",
{colour = "warn", wrap = true, keep = 20, name = "empty"})
end


for _, row in ipairs(app.listRows(view.list, entries, "item",
function(entry) return {kind = "item", item = entry.value} end,
{pickKeys = false, arrows = true, limit = height})) do
rows[#rows + 1] = row
end



local addWhy, takeWhy = storage.addBlocked(view), storage.blocked(view)
local count = storage.count(view)
rows[#rows + 1] = doc.text("", {keep = doc.REQUIRED, name = "above-controls"})
rows[#rows + 1] = chosenRow(view)
rows[#rows + 1] = amountRow(view)
rows[#rows + 1] = doc.text("", {keep = doc.REQUIRED, name = "between-controls"})


local function addButton(label, when, name)
return doc.button(label, {key = (not addWhy) and "enter" or nil,
colour = addWhy and "dim" or "selected",
action = (not addWhy) and {kind = "add"} or nil,
keep = doc.REQUIRED, name = name, when = when})
end
rows[#rows + 1] = doc.row({
doc.gap(1),
addButton("Add to cart", {minWidth = 30}, "add"),
addButton("+ Cart", {maxWidth = 29}, "add-short"),
doc.gap(1),
doc.button(count > 0 and ("Take %d now"):format(count) or "Take now", {
colour = takeWhy and "dim" or "good",
action = (not takeWhy) and {kind = "withdraw"} or nil,
keep = 6, name = "withdraw"}),
}, {keep = doc.REQUIRED, name = "actions"})

whyRow(rows, (view.bound.output == false and "bind /io/out first, in Bind")
or addWhy or takeWhy)
footer(view, rows)
return rows
end




local function cartLine(view, index, line)
local free = lineFree(view, line.item)
local short = line.amount - free
local editing = view.editing == line.item
local amount = editing and (view.editText .. "_") or tostring(line.amount)
local status, statusColour = ("of %d"):format(free), "dim"
if short > 0 then
status, statusColour = ("short %d"):format(short), "bad"
elseif view.holding and mineOf(view, line.item) >= line.amount then
status, statusColour = "held", "good"
end
return doc.row({
doc.gap(1),
doc.text("  ", {bg = app.chipFor(line.item), name = "line-chip:" .. index}),
doc.gap(1),
doc.text(storage.nameOf(view, line.item), {width = "fill",
truncate = doc.TRUNCATED, name = "line-name:" .. index}),
doc.gap(1),
doc.text(" " .. amount, {width = 7, bg = "field", truncate = doc.TRUNCATED,
colour = editing and "title" or (short > 0 and "bad" or "text"),
action = {kind = "edit-line", item = line.item}, keep = doc.REQUIRED,
name = "line-amount:" .. index}),
doc.gap(1),
doc.text(status, {width = 9, colour = statusColour, truncate = doc.TRUNCATED,
keep = 2, name = "line-status:" .. index}),
doc.gap(1),
doc.button("x", {colour = "bad", action = {kind = "remove-line", item = line.item},
keep = doc.REQUIRED, name = "line-remove:" .. index}),
doc.gap(1),
}, {keep = 20 + (#view.cart.lines - index), name = "line:" .. index,
bg = index % 2 == 0 and "zebra" or nil})
end

local function backButton()
return doc.button("Storage", {key = "<", action = {kind = "browse"},
keep = doc.REQUIRED, name = "browse"})
end

local function cartDocument(view, height)
local rows = {app.header(view, "CART", backButton()), doc.rule({keep = 2})}
local lines = view.cart.lines
local list = view.cartList
list.total = #lines
list.from = math.max(1, math.min(list.from, math.max(1, #lines - (list.shown or 0) + 1)))

if #lines == 0 then
rows[#rows + 1] = doc.text(" the cart is empty: choose an item in Storage, "
.. "type how many, Enter", {colour = "dim", wrap = true, keep = 20,
name = "cart-empty"})
end
local upto = math.min(#lines, list.from + height - 1)
list.listed = math.max(0, upto - list.from + 1)
for index = list.from, upto do
rows[#rows + 1] = cartLine(view, index, lines[index])
end

local takes, short = storage.cartTakes(view), cartShort(view)
rows[#rows + 1] = doc.text("", {keep = doc.REQUIRED, name = "above-controls"})
local tally = {doc.text((" %d line%s, %d item%s"):format(#lines,
#lines == 1 and "" or "s", cart.total(view.cart),
cart.total(view.cart) == 1 and "" or "s"), {colour = "dim",
keep = doc.REQUIRED, truncate = doc.TRUNCATED, name = "tally"})}
if short > 0 then
tally[#tally + 1] = doc.text((", %d short"):format(short), {colour = "bad",
keep = 3, name = "tally-short"})
end
rows[#rows + 1] = doc.row(tally, {keep = doc.REQUIRED, name = "tally-row"})
if view.holdWhy and #lines > 0 then
rows[#rows + 1] = doc.text(" not held: " .. view.holdWhy, {colour = "warn",
wrap = true, keep = 4, name = "hold-why"})
end
rows[#rows + 1] = doc.text("", {keep = doc.REQUIRED, name = "between-controls"})

local why
if view.run or view.sending then why = "a withdrawal is being sent"
elseif #lines == 0 then why = "the cart is empty"
elseif view.bound.output == false then why = "bind /io/out first, in Bind"
elseif takes < 1 then why = "none of it is free" end
rows[#rows + 1] = doc.row({
doc.gap(1),
doc.button(takes > 0 and ("Withdraw all %d"):format(takes) or "Withdraw all", {
key = (not why and not view.editing) and "enter" or nil,
colour = why and "dim" or "good",
action = (not why) and {kind = "withdraw-all"} or nil,
keep = doc.REQUIRED, name = "withdraw-all"}),
doc.gap(1),
doc.button("Clear cart", {colour = #lines > 0 and "bad" or "dim",
action = #lines > 0 and {kind = "clear-cart"} or nil, keep = 5,
name = "clear-cart"}),
}, {keep = doc.REQUIRED, name = "cart-actions"})
whyRow(rows, why)
footer(view, rows)
return rows
end


local function confirmDocument(view)
local rows = {app.header(view, "CART"), doc.rule({keep = 2})}
local takes = storage.cartTakes(view)
rows[#rows + 1] = doc.text((" Withdraw %d items to /io/out?"):format(takes),
{colour = "title", wrap = true, keep = doc.REQUIRED, name = "confirm"})
for index, line in ipairs(view.cart.lines) do
local take = math.min(line.amount, lineFree(view, line.item))
local text = ("  %d %s"):format(take, storage.nameOf(view, line.item))
local colour = "text"
if take < line.amount then
text = text .. (" (%d short, stays in the cart)"):format(line.amount - take)
colour = "warn"
end
rows[#rows + 1] = doc.text(text, {colour = colour, truncate = doc.TRUNCATED,
keep = 20 + (#view.cart.lines - index), name = "confirm-line:" .. index})
end
rows[#rows + 1] = doc.text(" What is free now is taken; anything short stays "
.. "in the cart.", {colour = "dim", wrap = true, keep = 6, name = "note"})
rows[#rows + 1] = doc.text("", {keep = doc.REQUIRED, name = "above-controls"})
rows[#rows + 1] = doc.row({
doc.gap(1),
doc.button("yes", {key = "y", colour = "good", action = {kind = "yes"},
keep = doc.REQUIRED, name = "yes"}),
doc.gap(1),
doc.button("no", {key = "n", colour = "bad", action = {kind = "no"},
keep = doc.REQUIRED, name = "no"}),
}, {keep = doc.REQUIRED, name = "confirm-actions"})
rows[#rows + 1] = doc.spacer()
return rows
end

function storage.document(view, width, height)
local rows
if view.screen == "confirm" then
rows = confirmDocument(view)
elseif view.screen == "cart" then
rows = cartDocument(view, height)
else
rows = browseDocument(view, height)
end
return doc.stack(rows, {name = "storage"})
end

function storage.settle(view, report)
if view.screen == "cart" then return app.settle(view.cartList, report, "line") end
if view.screen == "browse" then return app.settle(view.list, report, "item") end
return false
end




local function finishEdit(view)
if view.editing and view.editText ~= "" then
cart.set(view.cart, view.editing, tonumber(view.editText) or 0)
cartChanged(view)
end
view.editing, view.editText = nil, ""
end

function storage.act(view, action)
local kind = action and action.kind
if view.screen == "browse" and app.page(view.list, kind, action) then return true end
if kind == "item" then
view.item = action.item
return true
elseif kind == "focus" then
view.field = action.field
return true
elseif kind == "stack" then
local step = view.item and stackOf(view, view.item) or storage.STACK
view.amount = tostring((tonumber(view.amount) or 0) + step)
view.field = "amount"
return true
elseif kind == "all" then
if not view.item then return false end
view.amount = tostring(freeOf(view, view.item))
view.field = "amount"
return true
elseif kind == "add" then
local why = storage.addBlocked(view)
if why then
view.result = {status = app.REJECTED, reason = why}
return true
end
local n = tonumber(view.amount)
local line, err = cart.add(view.cart, view.item, n)
if not line then
view.result = {status = app.REJECTED, reason = err}
return true
end
cartChanged(view)

view.result = {text = ("added %d %s to the cart (%d in it)"):format(n,
storage.nameOf(view, view.item), line.amount), colour = "good"}
view.amount, view.field = "", "search"
app.sound(view, "added")
return true
elseif kind == "withdraw" then
local why = storage.blocked(view)
if why then
view.result = {status = app.REJECTED, reason = why}
return true
end

app.ask(view, {kind = "withdraw", item = view.item, count = storage.count(view)})
return true
elseif kind == "open-cart" then
view.screen = "cart"
return true
elseif kind == "browse" then
finishEdit(view)
view.screen = "browse"
return true
elseif kind == "edit-line" then
finishEdit(view)
view.editing, view.editText = action.item, ""
return true
elseif kind == "remove-line" then
if view.editing == action.item then view.editing, view.editText = nil, "" end
cart.remove(view.cart, action.item)
cartChanged(view)
return true
elseif kind == "clear-cart" then
view.editing, view.editText = nil, ""
cart.clear(view.cart)
cartChanged(view)
view.result = {text = "the cart is empty", colour = "text"}
return true
elseif kind == "withdraw-all" then
finishEdit(view)
if storage.cartTakes(view) < 1 or view.run or view.sending then return false end
view.screen = "confirm"
return true
elseif kind == "yes" then
view.screen = "cart"
local todo = {}
for _, line in ipairs(view.cart.lines) do
local take = math.min(line.amount, lineFree(view, line.item))
if take > 0 then todo[#todo + 1] = {item = line.item, count = take} end
end
if #todo == 0 then return true end
view.run = {todo = todo, left = #todo, lines = #todo, moved = 0, failed = {}}
view.result = nil
return true
elseif kind == "no" then
view.screen = "cart"
return true
end
return false
end


function storage.searching(view)
return view.screen == "browse" and view.items and view.list or nil
end




local function cartKeyboard(view, event)
if event.kind == "scroll" then
app.scroll(view.cartList, event.dir or 0)
return true
end
if not view.editing then
if event.kind == "key" and keys and (event.key == keys.pageDown
or event.key == keys.pageUp) then
app.page(view.cartList, event.key == keys.pageDown and "next" or "prev")
return true
end
return false
end
if event.kind == "char" then
if type(event.char) == "string" and event.char:match("^%d$") then
if #view.editText < storage.AMOUNT_DIGITS then
view.editText = ((view.editText .. event.char):gsub("^0+", ""))
end
return true
end
return false
end
if event.kind == "key" and keys then
if event.key == keys.backspace then
view.editText = view.editText:sub(1, -2)
return true
elseif event.key == keys.delete then
view.editText = ""
return true
elseif event.key == keys.enter or event.key == keys.numPadEnter then
finishEdit(view)
return true
end
end
return false
end







function storage.keyboard(view, event)
if not event then return false end
if view.screen == "cart" then return cartKeyboard(view, event) end
if view.screen ~= "browse" or not view.items then return false end
local list = view.list
if event.kind == "char" then
if type(event.char) == "string" and event.char:match("^%d$") then
if #view.amount < storage.AMOUNT_DIGITS then
view.amount = ((view.amount .. event.char):gsub("^0+", ""))
end
view.field = "amount"
return true
end
if app.type(list, event) then
view.field = "search"
return true
end
return false
end
if event.kind == "key" and keys
and (event.key == keys.backspace or event.key == keys.delete) then
local clear = event.key == keys.delete
local function editAmount()
if view.amount == "" then return false end
view.amount = clear and "" or view.amount:sub(1, -2)
return true
end
local function editSearch() return (app.type(list, event)) end
if view.field == "amount" then return editAmount() or editSearch() end
return editSearch() or editAmount()
end
return app.type(list, event)
end


function storage.handle(view, event, grid)
local took, chose = storage.keyboard(view, event)
if took then
if chose then storage.act(view, chose) end
return true
end
if not input.heard(event) then return false end
local action = input.actionFor(grid, event)
if not action then return false end
return storage.act(view, action)
end

return storage
