local function statusText(ed)
if ed.sending then return ("asking %s.."):format(ed.view.host), "warn" end
local row = currentRow(ed)
local marks = row and ed.marks and ed.marks[row.node.id]
if row and row.kind ~= "else" and marks then
return marks[1].message, marks[1].level == "error" and "bad" or "warn"
end
if ed.result then return ed.result.text, ed.result.colour end
local r = ed.report
if r then
if r.ok then
return ("ok -- %d warning%s"):format(#r.warnings, #r.warnings == 1 and "" or "s"),
"good"
end
return ("%d to fix before it can be saved"):format(#r.errors), "warn"
end
return "", "text"
end

