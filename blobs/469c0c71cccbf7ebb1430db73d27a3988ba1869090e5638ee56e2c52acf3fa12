keep = 400, name = "ed-why"})
end
end




function editor.clauseFixed(i, op, value)
return #(" %d."):format(i) + 5 + 10 + 1 + 3 + 1 + #op + #value
end



local function clauseRow(ed, i, clause, choosing)
local function part(label, name, what, colour)
local active = choosing and choosing.part == what
or (what == "left" and choosing and choosing.part == "item")
return doc.button(label, {colour = active and "selected" or (colour or "action"),
action = {kind = "ed-clause", clause = i, part = what}, keep = doc.REQUIRED,
name = ("clause-%s:%d"):format(name, i)})
end
local itemName = itemName(ed)




local op = clauses.words(clause.op) or "?"
local value = clauses.valueText(clause.right) or "?"
local reading = clauses.readingText(clause.left, itemName) or "choose.."
local room = math.max(editor.READING_MIN, math.min(editor.READING_MAX,
editor.WIDTH - editor.clauseFixed(i, op, value)))
if #reading > room then
reading = reading:sub(1, room - #doc.TRUNCATED) .. doc.TRUNCATED
end
return doc.row({
doc.text((" %d."):format(i), {colour = "dim", keep = doc.REQUIRED,
name = "clause-n:" .. i}),
doc.gap(1),
part(reading, "left", "left"),
doc.gap(1),
part(op, "op", "op"),
doc.gap(1),
part(value, "right", "right"),
doc.spacer({min = 1}),
part(clause.neg and "NOT" or "not", "not", "not", clause.neg and "bad" or "dim"),
doc.gap(1),
part("x", "remove", "remove", "bad"),
doc.gap(1),
}, {keep = 350 - i, name = "clause:" .. i})
end

