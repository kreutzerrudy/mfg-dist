local app = require("mfg.hmi.app")
local schema = require("mfg.common.script.schema")
local edit = require("mfg.common.script.edit")
local parse = require("mfg.common.script.parse")
local format = require("mfg.common.script.format")
local check = require("mfg.common.script.check")
local lex = require("mfg.common.script.lex")
local clauses = require("mfg.common.script.clauses")

local editor = {}

editor.DRAFTS = "/mfg/drafts"
editor.READ = {timeout = 3, attempts = 2}
editor.SAVE = {timeout = 10, attempts = 1}
editor.INDENT = 2
editor.MARGIN = 2
editor.READING_MAX = 22
editor.WIDTH = 51
editor.READING_MIN = 6


local VERB_ACTIONS = {}
for _, action in pairs(check.VERBS) do VERB_ACTIONS[action] = true end



local function draftPath(name)
return fs.combine(editor.DRAFTS, (name or "_new") .. ".tree")
end

function editor.loadDraft(name)
local path = draftPath(name)
if not fs.exists(path) then return nil end
local handle = fs.open(path, "r")
if not handle then return nil end
local data = textutils.unserialize(handle.readAll())
handle.close()
return type(data) == "table" and data.tree and data or nil
end

local function saveDraft(ed)
if not ed.state.dirty then return end
local handle = fs.open(draftPath(ed.state.tree.machine), "w")
if not handle then return end
handle.write(textutils.serialize({tree = ed.state.tree, rev = ed.rev}))
handle.close()
end

function editor.dropDraft(name)
local path = draftPath(name)
if fs.exists(path) then fs.delete(path) end
end





function editor.new(view, name)
local ed = {
view = view,
name = name,
rev = name and nil or 0,
state = nil,
cursor = 1, slot = 1,
lines = app.newList(),
chooser = nil,
decls = {}, items = nil,
queue = {},
result = nil,
confirm = nil,
stale = nil,
machines = {},
draft = false,
version = 0,
}
local draft = editor.loadDraft(name)
if draft then
ed.state = edit.open(draft.tree)
ed.state.dirty = true
ed.rev = draft.rev or ed.rev
ed.draft = true
ed.result = {text = "your unsaved draft -- discard it with the button above",
colour = "warn"}
elseif not name then
ed.state = edit.blank(nil)
end
if name then ed.queue[#ed.queue + 1] = {kind = "script"} end
for action in pairs(VERB_ACTIONS) do
ed.queue[#ed.queue + 1] = {kind = "offer", name = action}
end
ed.queue[#ed.queue + 1] = {kind = "items"}
return ed
end

function editor.title(ed)
local name = ed.state and ed.state.tree.machine or ed.name
return ("EDIT %s%s%s"):format(name or "new script",
(ed.rev and ed.rev > 0) and (" rev " .. ed.rev) or "",
(ed.state and ed.state.dirty) and " *" or "")
end



local function rows(ed)
return ed.state and edit.rows(ed.state) or {}
end

local function currentRow(ed)
local list = rows(ed)
ed.cursor = math.max(1, math.min(ed.cursor, #list))
return list[ed.cursor], list
end


local function report(ed)
if not ed.state then return nil end
if ed.checked ~= ed.version then
local complete = true
for action in pairs(VERB_ACTIONS) do
if not ed.decls[action] then complete = false end
end
local itemSet = nil
if ed.items then
itemSet = {}
for item in pairs(ed.items) do itemSet[item] = true end
end
ed.report = check.check(ed.state.tree, {decls = complete and ed.decls or nil,
items = itemSet})
ed.marks = edit.marks(ed.report)
ed.checked = ed.version
end
return ed.report
end

local function itemName(ed)
return function(item)
local known = ed.view.names and ed.view.names[item]
return (known and known.name) or app.shortName(item)
end
end



local NAME_PIECE = {field = "machine", type = "name"}
local function parts(ed, row)
if row.kind == "machine" then
return {{text = "machine"}, {text = row.node.machine or schema.HOLE, piece = NAME_PIECE}}
elseif row.kind == "else" then
return {{text = "else"}}
end
return schema.parts(row.node, {itemName = itemName(ed), offer = true})
end

local function slotsOf(ed, row)
local out = {}
for _, part in ipairs(parts(ed, row)) do
if part.piece then out[#out + 1] = part end
end
return out
end


local function changed(ed)
ed.version = ed.version + 1
ed.stale = nil
saveDraft(ed)
currentRow(ed)
end



function editor.nextJob(ed)
return table.remove(ed.queue, 1)
end

function editor.exchange(ed, job)
local body, opts = nil, editor.READ
if job.kind == "script" then
body = {command = "scripts", script = ed.name, brief = true}
elseif job.kind == "offer" then
body = {command = "offer", name = job.name}
elseif job.kind == "items" then
body = {command = "available"}
elseif job.kind == "check" then
body = {command = "check_script", source = format.format(ed.state.tree)}
elseif job.kind == "save" then
body = {command = "register_script", source = format.format(ed.state.tree),
expect = job.expect, operator = true}
opts = editor.SAVE
ed.sending = job
elseif job.kind == "add" then
body = {command = "add_machine", machine = job.machine,
script = ed.state.tree.machine, operator = true}
opts = editor.SAVE
ed.sending = job
else
return false
end
editor.apply(ed, job, ed.view.transport.request(body, opts) or {})
return true
end




local function translate(ed, errors)
local reparsed = parse.parse(format.format(ed.state.tree))
local theirs, mine = {[0] = 0}, {}
schema.each(reparsed, function(n) theirs[#theirs + 1] = n.id end)
schema.each(ed.state.tree, function(n) mine[#mine + 1] = n.id end)
local map = {[0] = 0}
for i, id in ipairs(theirs) do map[id] = mine[i] end
local out = {}
for _, e in ipairs(errors or {}) do
out[#out + 1] = {node = map[e.node] or 0, message = e.message, line = e.line}
end
return out
end

local function say(ed, text, colour)
ed.result = {text = text, colour = colour or "text"}
end

function editor.apply(ed, job, answer)
app.noteLink(ed.view, answer)

ed.version = ed.version + 1
local ok = answer.status == app.COMPLETED
if job.kind == "script" then
if not ok then
say(ed, "the controller refused: " .. tostring(answer.reason or answer.status), "bad")
return
end
for _, t in ipairs(answer.scripts or {}) do
if t.script == ed.name then
ed.machines = t.machines or {}
if not ed.draft or ed.reload then
ed.state = edit.open(t.tree)
ed.rev = t.rev
ed.reload, ed.draft = nil, false
elseif ed.rev ~= t.rev then
say(ed, ("your draft is from rev %s; the controller has rev %d")
:format(tostring(ed.rev), t.rev), "warn")
end
end
end
if not ed.state then say(ed, "no script called " .. tostring(ed.name), "bad") end
elseif job.kind == "offer" then
local decl = ok and answer.actions and answer.actions[1]
if decl then ed.decls[job.name] = decl end
elseif job.kind == "items" then
if ok and type(answer.items) == "table" then
ed.items = answer.items
for item, known in pairs(answer.names or {}) do ed.view.names[item] = known end
end
elseif job.kind == "check" then
if not ok then
say(ed, "the controller could not check it: " .. tostring(answer.reason), "bad")
elseif answer.ok then
local f = answer.footprint or {}
say(ed, ("the controller agrees: no errors. It supplies %s; collects %s")
:format(#(f.supplies or {}) > 0 and table.concat(f.supplies, ", ") or "nothing",
#(f.collects or {}) > 0 and table.concat(f.collects, ", ") or "nothing"),
"good")
else
local errs = translate(ed, answer.errors)
ed.remoteErrors = errs
say(ed, ("the controller finds %d error%s: %s"):format(#errs,
#errs == 1 and "" or "s", errs[1] and errs[1].message or "?"), "bad")
end
elseif job.kind == "save" then
ed.sending = nil
if ok then
ed.rev = answer.rev
ed.state.dirty = false
editor.dropDraft(ed.state.tree.machine)
if ed.name == nil then editor.dropDraft(nil) end
ed.name = answer.script
ed.machines = answer.machines or {}
local follow = #ed.machines > 0 and ("; " .. table.concat(ed.machines, ", ")
.. " take it between runs") or ""
say(ed, ("saved %s rev %d%s"):format(answer.script, answer.rev, follow), "good")
ed.madeNew = job.expect == 0
ed.view.readAt = nil
app.sound(ed.view, "done")
elseif answer.stale then
ed.stale = {rev = answer.rev}
say(ed, tostring(answer.reason), "bad")
app.sound(ed.view, "refused")
elseif answer.status == app.TIMED_OUT then
say(ed, "no answer -- look in the Types list before saving again", "warn")
else
if answer.errors then ed.remoteErrors = translate(ed, answer.errors) end
say(ed, "refused: " .. tostring(answer.reason), "bad")
app.sound(ed.view, "refused")
end
elseif job.kind == "add" then
ed.sending = nil
if ok then
say(ed, ("made %s from %s -- bind it on its page in Machines, then enable it"):format(
job.machine, ed.state.tree.machine), "good")
ed.madeNew = false
ed.view.readAt = nil
else
say(ed, "refused: " .. tostring(answer.reason), "bad")
end
end
end



local function portEntries(ed, piece)
local out = {}
for _, port in ipairs(ed.state.tree.ports) do
local kindOk = not piece.kind or (piece.kind == "volume" and port.type == "volume")
or (piece.kind == "signal" and port.type and port.type ~= "volume")
local dirOk = not piece.direction or port.direction == piece.direction
if port.name and kindOk and dirOk then
out[#out + 1] = {value = port.name, label = port.name,
note = ("%s %s"):format(port.direction or "?", port.type or "?")}
end
end
return out
end

local function itemEntries(ed)
local out = {}
for item, entry in pairs(ed.items or {}) do
out[#out + 1] = {value = item, label = itemName(ed)(item),
note = tostring(entry.free or entry.held or ""), chip = app.chipFor(item)}
end
table.sort(out, function(a, b)
if a.label:lower() ~= b.label:lower() then return a.label:lower() < b.label:lower() end
return a.value < b.value
end)
return out
end


local function portNamed(ed, name)
for _, port in ipairs(ed.state.tree.ports) do
if port.name == name then return port end
end
return nil
end


