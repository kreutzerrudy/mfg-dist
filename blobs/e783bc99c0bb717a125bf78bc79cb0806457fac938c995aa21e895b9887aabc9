




























local firmware = require("mfg.common.firmware")
local config = require("mfg.common.config")
local state = require("mfg.common.state")

local apply = {}

local function P(root, path) return fs.combine(root or "/", path) end

local loaderLib
local function loader()
if not loaderLib then
local fn, err = loadfile("/mfg/boot/loader.lua", nil, _ENV)
if not fn then error("cannot load stage 0 as a library: " .. tostring(err), 0) end
loaderLib = fn("--lib")
end
return loaderLib
end
apply.loader = loader



function apply.stageZero()
local text = state.readText("/mfg/boot/loader.lua")
if not text then return nil, "no stage 0 at /mfg/boot/loader.lua" end
local fn, err = load(text, "=startup", "t", {})
if not fn then return nil, "stage 0 does not compile: " .. tostring(err) end
return text
end

local function writeBytes(path, bytes)
return state.writeText(path, bytes, true)
end



local function fetch(source, f)
local ok, bytes = pcall(source, f.path, f.sha256)
if not ok then return nil, ("%s: %s"):format(f.path, tostring(bytes)) end
if type(bytes) ~= "string" then return nil, f.path .. ": the source returned nothing" end
if #bytes ~= f.size or firmware.hashBytes(bytes) ~= f.sha256 then
return nil, f.path .. ": does not match the manifest"
end
return bytes
end

apply.fetch = fetch


function apply.localSource(from)
return function(path)
local bytes = state.readText(P(from or "/", path), true)
if not bytes then error("not on this computer", 0) end
return bytes
end
end




