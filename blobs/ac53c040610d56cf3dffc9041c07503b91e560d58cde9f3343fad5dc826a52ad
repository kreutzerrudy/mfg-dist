local rpc = require("mfg.common.rpc")
local schedules = require("mfg.controller.schedules")



return {
name        = "unschedule",
label       = "Remove a schedule",
tier        = "node",
destructive = true,

parameters = {
{name = "id", label = "Name", type = "text", required = true},
},

returns = {entry = "table"},

run = function(params)
local entry, why = schedules.remove(params.id)
if not entry then return rpc.REJECTED, {reason = why} end
return rpc.COMPLETED, {entry = entry}
end,
}
