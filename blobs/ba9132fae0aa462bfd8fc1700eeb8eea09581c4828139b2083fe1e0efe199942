local rpc = require("mfg.common.rpc")
local actions = require("mfg.common.actions")
local store = require("mfg.storage")
local ports = require("mfg.controller.ports")
local alarms = require("mfg.controller.alarms")
local flows = require("mfg.controller.flows")

















local TRASH = "/trash"


local function trashOverflow(pool, left)
local trashed = {}
if not next(left) or not store.isGroup(pool) or not store.isBound(TRASH) then
return trashed
end
local keys = {}
for item in pairs(left) do keys[#keys + 1] = item end
local stores = store.storesFor(pool, keys)
for item, count in pairs(left) do
local storePath = stores[item]
local status = storePath and store.status(storePath)
if status and status.bound and not status.degraded
and store.room(pool, item) == 0 then
local moved = store.move(ports.IN, TRASH, item, count)
if moved and moved > 0 then trashed[item] = moved end
end
end
return trashed
end

return {
name        = "take_in",
label       = "Take in what is in /io/in",
tier        = "orchestrated",
uses        = {"drain"},
policy      = true,
destructive = false,

parameters = {},

returns = {taken = "items", left = "items"},

run = function(_, ctx)
if not store.isBound(ports.IN) then
return rpc.REJECTED, {reason = ("%s is not bound -- mfgctl bind %s "
.. "<chest>"):format(ports.IN, ports.IN)}
end
local pool = require("mfg.common.config").setting("source")

local status, fields = actions.invoke("drain", {from = ports.IN, to = pool}, ctx)
if status ~= rpc.COMPLETED then
return rpc.REJECTED, {reason = tostring(fields.reason)}
end

flows.addAll(fields.drained, "in", "operator")
local left = ports.contents(ports.IN)
local trashed = trashOverflow(pool, left)
if next(trashed) then left = ports.contents(ports.IN) end
local key = "io.intake.full"
if next(left) then

alarms.raise(key, ports.fullText(pool, left, ports.IN),
{source = ports.IN, severity = "hold"})
else
alarms.clear(key)
end

return rpc.COMPLETED, {taken = fields.drained or {}, left = left, trashed = trashed}
end,
}
