


















local check = require("mfg.common.script.check")
local format = require("mfg.common.script.format")

local schema = {}

schema.HOLE = "?"

local L = check.LIMITS

local function slot(field, type, extra)
local s = extra or {}
s.field, s.type = field, type
return s
end



local function optional(field, type, word)
return {field = field, type = type, word = word, optional = true}
end

local COUNT = {min = 1, max = L.supplyMax}


schema.KINDS = {
port = {place = "header", label = "port", pieces = {
slot("direction", "direction"), slot("name", "name"), ":", slot("type", "porttype"),
optional("slots", "slots", "slots"), optional("safe", "safe", "safe")},
new = {direction = "input", type = "volume"}},

every = {place = "top", label = "every", block = true, pieces = {
"every", slot("every", "duration", {min = L.everyMin, max = 24 * 72000})},
new = {every = {n = 10, unit = "s"}}},
when = {place = "top", label = "when", block = true, pieces = {
"when", slot("cond", "cond")}},
on = {place = "top", label = "on", block = true, pieces = {
"on", slot("event", "event")}, new = {event = "start"}},

["if"] = {place = "block", label = "if", block = true, pieces = {
"if", slot("cond", "cond")}},
["repeat"] = {place = "block", label = "repeat", block = true, pieces = {
"repeat", slot("n", "count", {min = 1, max = L.repeatMax})}},
supply = {place = "block", label = "supply", pieces = {
"supply", slot("n", "count", COUNT), slot("item", "item"), "to",
slot("port", "port", {kind = "volume", direction = "input"})}},
stock = {place = "block", label = "stock", pieces = {
"stock", slot("port", "port", {kind = "volume", direction = "input"}), "with",
slot("n", "count", COUNT), slot("item", "item")}},
collect = {place = "block", label = "collect", pieces = {
"collect", slot("port", "port", {kind = "volume", direction = "output"})}},
move = {place = "block", label = "move", pieces = {
"move", slot("n", "count", COUNT), slot("item", "item"),
"from", slot("from", "port", {kind = "volume"}),
"to", slot("to", "port", {kind = "volume", direction = "input"})}},
set = {place = "block", label = "set", pieces = {
"set", slot("port", "port", {kind = "signal", direction = "output"}), "to",
slot("value", "value", {by = "port"})}},
pulse = {place = "block", label = "pulse", pieces = {
"pulse", slot("port", "port", {kind = "signal", direction = "output"}), "for",
