local rpc = require("mfg.common.rpc")
local binder = require("mfg.controller.binder")







return {
name        = "bind_pages",
label       = "What is waiting to be bound",
tier        = "node",
destructive = false,
quiet       = true,

parameters = {
{name = "prefix", label = "Prefix", type = "text", required = false},
},

returns = {pages = "table", show = "table", last = "table", now = "number"},

run = function(params)
local scripts = require("mfg.controller.scripts")
local out = binder.status(params.prefix)
out.printBlocked = binder.printBlocked()
out.doors = binder.doors()
out.todo = binder.todo()
out.kinds = binder.kinds()
out.types, out.machines = {}, {}
for _, record in ipairs(scripts.all()) do


local slotted = false
for _, port in ipairs(record.ports or {}) do
if port.slots then slotted = true end
end
out.types[#out.types + 1] = {script = record.name, rev = record.rev,
slotted = slotted}
end
for _, record in ipairs(scripts.machines()) do
out.machines[#out.machines + 1] = record.name
end
return rpc.COMPLETED, out
end,
}
