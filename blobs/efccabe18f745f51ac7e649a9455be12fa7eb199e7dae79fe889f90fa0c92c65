







local backend = {}

backend.name = "real"



function backend.list()
local out = {}
for _, name in ipairs(peripheral.getNames()) do
out[name] = {peripheral.getType(name)}
end
return out
end



function backend.methods(name)
local methods = peripheral.getMethods(name)
if not methods then return nil, "no such peripheral: " .. tostring(name) end
table.sort(methods)
return methods
end




function backend.call(name, method, args)
args = args or {n = 0}
local started = os.epoch("utc")
local result = table.pack(pcall(peripheral.call, name, method,
table.unpack(args, 1, args.n or #args)))
local took = os.epoch("utc") - started
if not result[1] then return false, tostring(result[2]), took end
return true, table.pack(table.unpack(result, 2, result.n)), took
end

return backend
