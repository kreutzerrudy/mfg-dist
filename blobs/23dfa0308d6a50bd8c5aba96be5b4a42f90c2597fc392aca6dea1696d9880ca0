local function addEntries(view)
local entries = {}
for _, choice in ipairs(view.detail and view.detail.channelChoices or {}) do
if not choice.have then
local parts = {}
for item, n in pairs(choice.inputs or {}) do
parts[#parts + 1] = ("%d %s"):format(n, res.nameOf(view, item))
end
table.sort(parts)
entries[#entries + 1] = {value = choice.recipe or choice.type,
label = ("%-7s %s"):format(choice.kind, tostring(choice.label)),
note = #parts > 0 and table.concat(parts, ", ") or nil,
chip = choice.kind == "source" and "cyan" or "lime", choice = choice}
end
end
return entries
end

local function addDocument(view, height)
local rows = {app.header(view, "ADD A CHANNEL", back("group")), doc.rule({keep = 2})}
local entries = addEntries(view)
if #entries == 0 then
rows[#rows + 1] = doc.text(" nothing else makes it -- register a recipe, or give a "
.. "machine a `makes` or `yields` line", {colour = "dim", wrap = true, keep = 20,
name = "none"})
end
for _, row in ipairs(app.listRows(view.addList, entries, "add",
function(entry) return {kind = "add", choice = entry.choice} end,
{pickKeys = false, arrows = true, limit = height})) do
rows[#rows + 1] = row
end
rows[#rows + 1] = doc.spacer()
rows[#rows + 1] = statusRow(view)
return rows
end

local function choiceEntries(view)
local entries = {}
for _, choice in ipairs(view.choices or {}) do
local name = res.nameOf(view, choice.item)
entries[#entries + 1] = {value = choice.item, label = name,
note = choice.group and "grouped" or (choice.made and "made" or amount(choice.free)),
chip = app.chipFor(choice.item), made = choice.made}
end
table.sort(entries, function(a, b)
if (a.made and 1 or 0) ~= (b.made and 1 or 0) then return a.made == true end
if a.label:lower() ~= b.label:lower() then return a.label:lower() < b.label:lower() end
return a.value < b.value
end)
return entries
end

local function newDocument(view, height)
local rows = {app.header(view, "A GROUP OF WHAT?", back("list")), doc.rule({keep = 2})}
if not view.choices then
rows[#rows + 1] = doc.text(" reading what can be grouped..", {colour = "dim",
keep = doc.REQUIRED, name = "read-state"})
else
rows[#rows + 1] = doc.text(" the form you use: the ingot, not the block",
{colour = "dim", truncate = doc.TRUNCATED, keep = 8, name = "hint"})
for _, row in ipairs(app.listRows(view.choiceList, choiceEntries(view), "choice",
function(entry) return {kind = "pick", item = entry.value} end,
{pickKeys = false, arrows = true, limit = height})) do
rows[#rows + 1] = row
end
end
rows[#rows + 1] = doc.spacer()
rows[#rows + 1] = statusRow(view)
return rows
end

local function confirmDocument(view)
local d = view.detail or {}
local removing = view.confirming and view.confirming.kind == "remove"
local rows = {app.header(view, removing and "REMOVE CHANNEL" or "FORGET GROUP"),
doc.rule({keep = 2})}
rows[#rows + 1] = doc.text(removing and (" Remove channel %s from %s?"):format(
tostring(view.channel), tostring(d.name))
or (" Forget the group %s?"):format(tostring(d.name)),
{colour = "title", keep = doc.REQUIRED, truncate = doc.TRUNCATED, name = "confirm"})
rows[#rows + 1] = doc.text(" A job it already queued still runs.", {colour = "dim",
wrap = true, keep = 6, name = "note"})
rows[#rows + 1] = doc.text("", {keep = doc.REQUIRED, name = "above-controls"})
rows[#rows + 1] = doc.row({
doc.gap(1),
doc.button("yes", {key = "y", colour = "bad", action = {kind = "yes"},
keep = doc.REQUIRED, name = "yes"}),
doc.gap(1),
doc.button("no", {key = "n", colour = "good", action = {kind = "no"},
keep = doc.REQUIRED, name = "no"}),
}, {keep = doc.REQUIRED, name = "confirm-actions"})
rows[#rows + 1] = doc.spacer()
return rows
end

function res.document(view, width, height)
local rows
if view.screen == "group" then rows = groupDocument(view, height)
elseif view.screen == "channel" then rows = channelDocument(view)
elseif view.screen == "add" then rows = addDocument(view, height)
elseif view.screen == "new" then rows = newDocument(view, height)
elseif view.screen == "confirm" then rows = confirmDocument(view)
else rows = listDocument(view, height) end
return doc.stack(rows, {name = "resources"})
end

function res.settle(view, report)
if view.screen == "list" then return app.settle(view.list, report, "group") end
if view.screen == "new" then return app.settle(view.choiceList, report, "choice") end
if view.screen == "add" then return app.settle(view.addList, report, "add") end
return false
end



local function ask(view, command, params, extra)
local job = {kind = "act", command = command, params = params}
for k, v in pairs(extra or {}) do job[k] = v end
app.ask(view, job)
end

function res.act(view, action)
local kind = action and action.kind
local lists = {list = view.list, new = view.choiceList, add = view.addList}
local list = lists[view.screen]
if list and app.page(list, kind, action) then return true end

if kind == "show" then
view.screen = action.screen
if action.screen == "new" then view.choices, view.choiceList = nil, app.newList() end
if action.screen == "add" then view.addList = app.newList() end
if action.screen == "group" then view.channel = nil end
return true
elseif kind == "open" then
openGroup(view, action.id)
return true
elseif kind == "for-item" then

view.pendingFor = {item = action.item, target = action.target}
view.readAt = nil
resolvePending(view)
return true
elseif kind == "pick" then
local group = groupHolding(view, action.item)
if group then openGroup(view, group.id) return true end
ask(view, "set_resource", {unit = action.item, target = res.STACK},
{open = true, oneForm = true})
return true
elseif kind == "channel" then
view.channel, view.screen, view.reserve = action.id, "channel", nil
return true
elseif kind == "add" then
local c = action.choice or {}
ask(view, "set_channel", {group = view.chosen, recipe = c.recipe, type = c.type},
{open = true})
return true
elseif kind == "focus" then
if view.edit then view.edit.field = action.field end
return true
elseif kind == "save" then
local params = res.saveParams(view)
if not params then return false end
ask(view, "set_resource", params)


view.edit.saved = true
return true
elseif kind == "toggle" then
local d = view.detail
if not d then return false end
ask(view, "set_resource", {id = d.id, enabled = not d.enabled})
return true
elseif kind == "link" then
local d = view.detail
if not d then return false end
ask(view, "set_resource", {id = d.id, link = true})
return true
elseif kind == "forget" then
view.screen, view.confirming = "confirm", {kind = "forget"}
return true
elseif kind == "remove" then
view.screen, view.confirming = "confirm", {kind = "remove"}
return true
elseif kind == "yes" then
local c = view.confirming or {}
view.confirming = nil
if c.kind == "remove" then
view.screen = "channel"
ask(view, "set_channel", {group = view.chosen, id = view.channel, remove = true})
else
view.screen = "group"
ask(view, "forget_resource", {id = view.chosen})
end
return true
elseif kind == "no" then
view.screen = (view.confirming and view.confirming.kind == "remove") and "channel"
or "group"
view.confirming = nil
return true
elseif kind == "mode" then
ask(view, "set_channel", {group = view.chosen, id = view.channel, mode = action.mode})
return true
elseif kind == "move" then
ask(view, "set_channel", {group = view.chosen, id = view.channel, position = action.to})
return true
elseif kind == "channel-toggle" then
local ch = channelOf(view.detail, view.channel)
if not ch then return false end
ask(view, "set_channel", {group = view.chosen, id = view.channel,
enabled = not ch.enabled})
return true
elseif kind == "nudge" then
if not view.reserve then return false end
view.reserve.value = tostring(math.max(0, (tonumber(view.reserve.value) or 0) + action.by))
view.reserve.saved = nil
return true
elseif kind == "reserve" then
local n = view.reserve and tonumber(view.reserve.value)
if not n then return false end
ask(view, "set_channel", {group = view.chosen, id = view.channel, reserve = n})
return true
end
return false
end

function res.searching(view)
if view.screen == "list" and view.groups then return view.list end
if view.screen == "new" and view.choices then return view.choiceList end
if view.screen == "add" then return view.addList end
return nil
end


local function typing(view, event)
local target, field
if view.screen == "group" and view.edit then
target, field = view.edit, view.edit.field
elseif view.screen == "channel" and view.reserve then
target, field = view.reserve, "value"
else
return false
end
if event.kind == "char" or event.kind == "key" then target.saved = nil end
if event.kind == "char" and type(event.char) == "string" and event.char:match("^%d$") then
local value = target[field]
if #value < res.DIGITS then
target[field] = ((value .. event.char):gsub("^0+(%d)", "%1"))
end
return true
end
if event.kind == "key" and keys then
if event.key == keys.backspace or event.key == keys.delete then
local value = target[field]
target[field] = event.key == keys.delete and "" or value:sub(1, -2)
return true
end
end
return false
end

function res.keyboard(view, event)
if not event then return false end
if view.screen == "group" or view.screen == "channel" then return typing(view, event) end
local list = res.searching(view)
if list then return app.type(list, event) end
return false
end

function res.handle(view, event, grid)
local took, chose = res.keyboard(view, event)
if took then
if chose then res.act(view, chose) end
return true
end
if not input.heard(event) then return false end
local action = input.actionFor(grid, event)
if not action then return false end
return res.act(view, action)
end

return res
