or (" one form: " .. res.nameOf(view, d.unit)), {colour = "dim",
truncate = doc.TRUNCATED, keep = #gain > 0 and 35 or 11, name = "forms"}),
doc.spacer({min = 1})}
if #gain > 0 then
formRow[#formRow + 1] = button("+ " .. table.concat(gain, ", "):sub(1, 22), "l",
"action", (not view.sending) and {kind = "link"} or nil, 35, "link")
formRow[#formRow + 1] = doc.gap(1)
end
rows[#rows + 1] = doc.row(formRow, {keep = #gain > 0 and 35 or 11, name = "forms-row"})

view.edit = view.edit or editFrom(d)
rows[#rows + 1] = fieldRow(view, {{"target", "target"}, {"gather", "gather <"}}, "goal-row")
if #fieldsOf(d) == 4 then
rows[#rows + 1] = fieldRow(view, {{"keep", "keep  "}, {"low", "unpack <"}}, "band-row")
end

rows[#rows + 1] = doc.row({doc.text(" channels", {colour = "label", keep = 30,
name = "channels-label"}), doc.spacer({min = 1}),
button("+ channel", "+", "action", {kind = "show", screen = "add"}, 29, "add-channel"),
doc.gap(1)}, {keep = 30, name = "channels-head"})
if #(d.channels or {}) == 0 then
rows[#rows + 1] = doc.text("  none: it only packs, or watches", {colour = "dim",
keep = 28, name = "no-channel"})
end
for index, ch in ipairs(d.channels or {}) do
rows[#rows + 1] = doc.row({
doc.gap(1),
doc.button(channelLine(view, ch), {width = "fill", align = "left",
colour = ch.state == "off" and "dim" or (ch.engaged and "selected" or "action"),
action = {kind = "channel", id = ch.id}, name = "channel:" .. index}),
}, {keep = 28 - index, name = "channel-row:" .. index})
end
if (d.inflow or 0) > 0 or (d.outflow or 0) > 0 then
rows[#rows + 1] = doc.text((" in %s  out %s  net %s%s"):format(rate(d.inflow),
rate(d.outflow), rate(d.net), d.eta and ("  ~%d min to target"):format(
math.ceil(d.eta)) or ""), {colour = "dim", truncate = doc.TRUNCATED, keep = 12,
name = "flows"})
end
rows[#rows + 1] = doc.spacer()

local params, why = res.saveParams(view)
local busy = view.sending ~= nil
rows[#rows + 1] = doc.row({
doc.gap(1),
button("Save", "enter", "selected", params and {kind = "save"} or nil,
doc.REQUIRED, "save"),
doc.gap(1),
d.enabled
and button("Off", "o", "bad", (not busy) and {kind = "toggle"} or nil,
doc.REQUIRED, "toggle")
or button("On", "o", "good", (not busy) and {kind = "toggle"} or nil,
doc.REQUIRED, "toggle"),
doc.gap(1),
button("Forget", "f", "bad", (not busy) and {kind = "forget"} or nil, 5, "forget"),
}, {keep = doc.REQUIRED, name = "actions"})
if why and why ~= "nothing changed" and why ~= "saving.." then
rows[#rows + 1] = doc.text(" " .. why, {colour = "dim", wrap = true,
keep = app.KEEP_STATUS - 1, name = "why-blocked"})
end
rows[#rows + 1] = statusRow(view)
return rows
end

