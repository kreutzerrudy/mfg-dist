
























local doc = require("mfg.hmi.doc")
local input = require("mfg.hmi.input")
local app = require("mfg.hmi.app")

local res = {}

res.EVERY = 5
res.BACKGROUND = 30
res.READ = {timeout = 3, attempts = 2}
res.ACT = {timeout = 10, attempts = 1}
res.DIGITS = 7
res.STACK = 64


res.ORDER = {advice = 1, low = 2, gathering = 3, packing = 4, unpacking = 4, met = 5, off = 6}
res.CHIP = {advice = "red", low = "orange", gathering = "yellow", packing = "cyan",
unpacking = "cyan", met = "lime", off = "gray"}
res.MARK = {advice = "!", low = "v", gathering = "^", packing = "#", unpacking = "#",
met = "=", off = "."}

local FIELDS = {"target", "gather", "keep", "low"}

function res.new(opts)
opts = opts or {}
return {
host = opts.host or "mfg",
display = opts.display,
transport = opts.transport,
now = opts.now,
names = opts.names or {},

groups = nil,
readAt = nil, readWhy = nil,
offer = nil,

screen = "list",
list = app.newList(),

chosen = nil,
channel = nil,
detail = nil, detailAt = nil, detailWhy = nil,
edit = nil,
reserve = nil,
confirming = nil,

choices = nil,
choiceList = app.newList(),
addList = app.newList(),
pendingFor = nil,

namesAt = nil,
jump = nil,
sending = nil,
result = nil,
link = {state = "unknown"},
queue = {},
}
end

function res.nameOf(view, item)
local known = view.names and view.names[item]
return (known and known.name) or app.shortName(item)
end

function res.amount(n)
n = math.floor(tonumber(n) or 0)
if n >= 10000 then return ("%dk"):format(math.floor(n / 1000)) end
if n >= 1000 then return ("%.1fk"):format(n / 1000) end
return tostring(n)
end
local amount = res.amount

local function rate(r)
if not r then return "" end
if r >= 10 then return ("%d/m"):format(math.floor(r + 0.5)) end
return ("%.1f/m"):format(r)
end


local function groupHolding(view, item)
for _, group in ipairs(view.groups or {}) do
for _, form in ipairs(group.forms or {}) do
if form.item == item then return group end
end
end
return nil
end

local function channelOf(d, id)
for index, ch in ipairs(d and d.channels or {}) do
if ch.id == id then return ch, index end
end
return nil
end



function res.refresh(view)
view.readAt, view.detailAt = nil, nil
end

function res.nextJob(view)
local job = table.remove(view.queue, 1)
if job then return job end
if not view.namesAt then return {kind = "names"} end
local every = ((view.onScreen == false) and res.BACKGROUND or res.EVERY) * 1000
local now = app.clock(view)
if view.chosen and view.screen ~= "list" and view.screen ~= "new"
and (not view.detailAt or now - view.detailAt >= every) then
return {kind = "detail", id = view.chosen}
end
if view.screen == "new" and not view.choices then return {kind = "choices"} end
if not view.readAt or now - view.readAt >= every then return {kind = "read"} end
return nil
end

function res.exchange(view, job)
local body, opts = nil, res.READ
if job.kind == "read" then
view.readAt = app.clock(view)
body = {command = "resources"}
elseif job.kind == "detail" then
view.detailAt = app.clock(view)
body = {command = "resources", id = job.id}
elseif job.kind == "choices" then
body = {command = "resources", choices = true}
elseif job.kind == "names" then
view.namesAt = app.clock(view)
body = {command = "available"}
elseif job.kind == "act" then
body = {command = job.command, operator = true}
for k, v in pairs(job.params) do body[k] = v end
opts = res.ACT
view.sending = job
view.result = nil
else
return false
end
res.apply(view, job, view.transport.request(body, opts) or {})
return true
end

local function openGroup(view, id)
if view.chosen ~= id then view.detail = nil end
view.chosen, view.screen, view.detailAt, view.edit = id, "group", nil, nil
end


local function resolvePending(view)
local pending = view.pendingFor
if not pending or not view.groups then return end
view.pendingFor = nil
local group = groupHolding(view, pending.item)
if group then return openGroup(view, group.id) end
app.ask(view, {kind = "act", command = "set_resource", open = true, oneForm = true,
params = {unit = pending.item, target = pending.target or res.STACK}})
end

local function editFrom(d, field)
return {target = d.goal and tostring(d.goal.target) or "",
gather = d.goal and tostring(d.goal.low) or "",
keep = d.band and tostring(d.band.keep) or "",
low = d.band and tostring(d.band.low) or "",
field = field or "target"}
end

function res.apply(view, job, answer)
app.noteLink(view, answer)
local ok = answer.status == app.COMPLETED
if job.kind == "read" then
if ok and type(answer.groups) == "table" then
view.groups, view.readWhy = answer.groups, nil
view.offer = view.offer or {name = "resources"}
resolvePending(view)
else
view.readWhy = tostring(answer.reason or answer.status or "no answer")
end
elseif job.kind == "detail" then
if ok and type(answer.groups) == "table" and answer.groups[1] then
local fresh = answer.groups[1]
view.detail, view.detailWhy = fresh, nil


if not view.edit or view.edit.saved then
view.edit = editFrom(fresh, view.edit and view.edit.field)
end
local ch = channelOf(fresh, view.channel)
if ch and (not view.reserve or view.reserve.saved) then
view.reserve = {value = tostring(ch.reserve or 0)}
end
elseif answer.status == app.REJECTED and view.chosen == job.id then

view.screen, view.chosen, view.detail = "list", nil, nil
view.result = {text = tostring(answer.reason), colour = "warn"}
else
view.detailWhy = tostring(answer.reason or answer.status or "no answer")
end
elseif job.kind == "choices" then
if ok then view.choices = answer.choices or {} end
elseif job.kind == "names" then
if ok then
for item, known in pairs(answer.names or {}) do view.names[item] = known end
end
elseif job.kind == "act" then
view.sending = nil
view.readAt, view.detailAt = nil, nil
if ok then
local text
if job.command == "forget_resource" then
text = ("%s is forgotten"):format(tostring((answer.group or {}).name))
view.screen, view.chosen, view.detail = "list", nil, nil
elseif job.command == "set_channel" then
local ch = answer.channel or {}
if job.params.remove then
text = ("channel %s removed"):format(tostring(ch.id))
view.screen, view.channel = "group", nil
else
text = ("channel %s: %s %s%s"):format(tostring(ch.id),
tostring(ch.kind), tostring(ch.mode),
ch.enabled == false and ", off" or "")
if job.open then view.screen, view.channel = "channel", ch.id end
end
if view.reserve then view.reserve.saved = true end
else
local g = answer.group or {}
text = ("%s: %s"):format(tostring(g.name), g.enabled == false and "off"
or g.goal and ("target %d, gather below %d"):format(g.goal.target,
g.goal.low) or "saved")
if job.open and g.id then openGroup(view, g.id) end
end
view.result = {text = text, colour = "good"}
app.sound(view, "done")
elseif answer.status == app.TIMED_OUT then
view.result = {text = ("no answer from %s -- look again before asking again")
:format(view.host), colour = "warn"}
app.sound(view, "refused")
elseif job.oneForm and job.params.forms == nil
and tostring(answer.reason):find("already in the group", 1, true) then

local params = {}
for k, v in pairs(job.params) do params[k] = v end
params.forms = {}
app.ask(view, {kind = "act", command = job.command, open = job.open,
params = params})
else
view.result = {text = "refused: " .. tostring(answer.reason), colour = "bad"}
app.sound(view, "refused")
end
end
end



local function statusRow(view)
local text, colour = "", "text"
if view.sending then
text, colour = ("asking %s.."):format(view.host), "warn"
elseif view.result then
text, colour = view.result.text, view.result.colour or "text"
end
return doc.text(" " .. text, {colour = colour, wrap = true, keep = app.KEEP_STATUS,
name = "status"})
end

local function button(label, key, colour, action, keep, name, short)
return doc.button(label, {key = action and key or nil,
colour = action and colour or "dim", action = action, keep = keep, name = name,
short = short})
end

local function back(screen)
return doc.button("Back", {key = "<", action = {kind = "show", screen = screen},
keep = doc.REQUIRED, short = "<", name = "back"})
end


function res.doing(view, g)
if g.state == "advice" and g.advice then return (g.advice:gsub("^[^:]+: ", "")) end
if g.state == "off" then return "off" end
if g.state == "packing" or g.state == "unpacking" then return g.state end
local on = {}
for _, ch in ipairs(g.channels or {}) do
if ch.engaged or ch.state == "engaged" then on[#on + 1] = ch.type or ch.label end
end
if #on > 0 then return table.concat(on, ", ") end
if g.state == "low" then return "next minute" end
return ""
end

local function groupEntries(view)
local sorted = {}
for _, g in ipairs(view.groups or {}) do sorted[#sorted + 1] = g end
table.sort(sorted, function(a, b)
local oa, ob = res.ORDER[a.state] or 9, res.ORDER[b.state] or 9
if oa ~= ob then return oa < ob end
return a.id < b.id
end)
local entries = {}
for _, g in ipairs(sorted) do
local of = g.goal and amount(g.goal.target) or "-"
entries[#entries + 1] = {value = g.id,
label = ("%s %-10s %5s/%-5s %s"):format(res.MARK[g.state] or "?",
tostring(g.name):sub(1, 10), amount(g.held), of, res.doing(view, g)),
chip = res.CHIP[g.state] or "gray"}
end
return entries
end

local function listDocument(view, height)
local add = doc.button("+ group", {key = "+", colour = "selected",
action = {kind = "show", screen = "new"}, keep = doc.REQUIRED, short = "+", name = "new-group"})
local rows = {app.header(view, "RESOURCES", add), doc.rule({keep = 2})}
if not view.groups then
rows[#rows + 1] = doc.text(view.readWhy and ("the controller refused: "
.. view.readWhy) or "reading the groups..", {colour = view.readWhy and "bad"
or "dim", wrap = true, keep = doc.REQUIRED, name = "read-state"})
else
local entries = groupEntries(view)
if #entries == 0 then
rows[#rows + 1] = doc.text(" no groups yet -- + group to keep a resource, "
.. "pack it, and gather it", {colour = "dim", wrap = true, keep = 20,
name = "empty"})
end
for _, row in ipairs(app.listRows(view.list, entries, "group",
function(entry) return {kind = "open", id = entry.value} end,
{limit = height})) do
rows[#rows + 1] = row
end
end
rows[#rows + 1] = doc.spacer()
