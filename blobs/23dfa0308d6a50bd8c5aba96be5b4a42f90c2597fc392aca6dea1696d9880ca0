local function amountField(view, field, label, width)
local edit = view.edit
local focused = edit.field == field
return {
doc.text(label, {colour = "label", truncate = doc.TRUNCATED, keep = doc.REQUIRED, name = field .. "-label"}),
doc.gap(1),
doc.text(" " .. edit[field] .. (focused and "_" or ""), {width = width or 8,
colour = focused and "title" or "text", bg = "field",
truncate = doc.TRUNCATED, keep = doc.REQUIRED,
action = {kind = "focus", field = field}, name = field}),
}
end

local function fieldRow(view, specs, name)
local children = {doc.gap(1)}
for index, p in ipairs(specs) do
if index > 1 then children[#children + 1] = doc.gap(2) end
for _, child in ipairs(amountField(view, p[1], p[2])) do children[#children + 1] = child end
end
return doc.row(children, {keep = doc.REQUIRED, name = name})
end


local function fieldsOf(d)
local packed = false
for _, form in ipairs(d and d.forms or {}) do packed = packed or form.role == "store" end
return packed and FIELDS or {"target", "gather"}
end


function res.saveParams(view)
local edit, d = view.edit, view.detail
if view.sending then return nil, "asking the controller.." end
if not edit or not d then return nil, "reading the group.." end
if edit.saved then return nil, "saving.." end
local params, changed = {id = d.id}, false
local target, gather = tonumber(edit.target), tonumber(edit.gather)
if edit.target == "" then target = 0 end
if target and target > 0 then
if not gather then return nil, "type when to gather" end
if gather > target then return nil, "gather below at most the target" end
end
if target and target ~= (d.goal and d.goal.target or 0) then
params.target, changed = target, true
end
if target and target > 0 and gather and gather ~= (d.goal and d.goal.low) then
params.gather, changed = gather, true
end
if #fieldsOf(d) == 4 and edit.keep ~= "" then
local keep, low = tonumber(edit.keep), tonumber(edit.low)
if not keep then return nil, "type how many to keep loose" end
if not low then return nil, "type when to unpack" end
if low > keep then return nil, "unpack below at most keep" end
if keep ~= (d.band and d.band.keep) then params.keep, changed = keep, true end
if low ~= (d.band and d.band.low) then params.low, changed = low, true end
end
if not changed then return nil, "nothing changed" end
return params
end

local function channelLine(view, ch)
local what = ch.kind == "source" and ch.type or tostring(ch.label)
local state = ch.job and ("job " .. ch.job.id) or tostring(ch.state)
return ("%s%d %-17s %-6s %6s %s"):format(ch.engaged and "*" or " ", ch.id,
what:sub(1, 17), ch.mode == "sweep" and "sweep" or "demand", rate(ch.rate), state)
end

