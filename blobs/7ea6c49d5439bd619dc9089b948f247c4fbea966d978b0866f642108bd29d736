function bind.suggestName(view, script)
local letter = (tostring(script):match("%a") or "m"):lower()
local taken = {}
for _, name in ipairs((view.data or {}).machines or {}) do taken[name] = true end
local n = 1
while taken[letter .. n] do n = n + 1 end
return letter .. n
end

function bind.makeBlocked(view)
