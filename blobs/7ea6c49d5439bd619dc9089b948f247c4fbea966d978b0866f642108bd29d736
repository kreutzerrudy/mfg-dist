for _, item in ipairs(view.data.todo or {}) do entries[#entries + 1] = entryFor(item) end
if #entries == 0 then
rows[#rows + 1] = doc.text(" every machine's ports are bound", {colour = "dim",
keep = 20, name = "all-bound"})
end
