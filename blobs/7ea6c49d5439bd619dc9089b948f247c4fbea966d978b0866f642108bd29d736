function bind.storeName(holds)
local word = tostring(holds):match("[^:/]+$") or "store"
word = word:lower():gsub("[^a-z0-9_%-]", "_")
return word:sub(1, bind.NAME_LENGTH)
end

function bind.storeBlocked(view)
