local function typeOf(view, script)
for _, t in ipairs((view.data or {}).types or {}) do
if t.script == script then return t end
end
return nil
end


function bind.manyBlocked(view)
if view.sending then return "asking the controller.." end
local t = typeOf(view, view.many.script)
if t and t.slotted == false then
