return {
doc.text(label, {colour = "label", truncate = doc.TRUNCATED, keep = doc.REQUIRED, name = which .. "-label"}),
doc.gap(1),
doc.text(" " .. value .. (focused and "_" or ""), {width = width,
colour = focused and "title" or "text", bg = "field",
truncate = doc.TRUNCATED, keep = doc.REQUIRED,
action = {kind = "store-focus", field = which}, name = which}),
}
end
local holdsRow = {doc.gap(1)}
for _, child in ipairs(field("holds", st.holds or "", "holds", 24)) do
holdsRow[#holdsRow + 1] = child
end
holdsRow[#holdsRow + 1] = doc.gap(1)
holdsRow[#holdsRow + 1] = doc.text("(click to type a #tag)", {colour = "dim",
truncate = doc.TRUNCATED, keep = 2, name = "tag-hint"})
rows[#rows + 1] = doc.row(holdsRow, {keep = doc.REQUIRED, name = "holds-row"})
local nameRow = {doc.gap(1)}
for _, child in ipairs(field("name /pool/", st.name, "name", 14)) do
nameRow[#nameRow + 1] = child
end
rows[#rows + 1] = doc.row(nameRow, {keep = doc.REQUIRED, name = "name-row"})
local why = bind.storeBlocked(view)
rows[#rows + 1] = doc.row({doc.gap(1), doc.button("Make store", {key = (not why)
and "enter" or nil, colour = why and "dim" or "selected",
action = (not why) and {kind = "make-store"} or nil, keep = doc.REQUIRED,
name = "make-store"})}, {keep = doc.REQUIRED, name = "store-actions"})
rows[#rows + 1] = doc.text(" " .. (why or "then bind its drawer; it takes only this, "
.. "and backs up when full"), {colour = "dim", wrap = true,
keep = app.KEEP_STATUS - 1, name = "why-blocked"})
rows[#rows + 1] = statusRow(view)
return rows
end

function bind.document(view, width, height)
local rows
if view.screen == "methods" then
rows = methodsDocument(view)
elseif view.screen == "flow" then
rows = flowDocument(view)
elseif view.screen == "make" and view.make then
rows = makeDocument(view, height)
elseif view.screen == "many" and view.many then
rows = manyDocument(view, height)
elseif view.screen == "store" and view.newStore then
rows = storeDocument(view, height)
else
rows = listDocument(view, height)
end
return doc.stack(rows, {name = "bind"})
end

function bind.settle(view, report)
if view.screen == "list" then return app.settle(view.list, report, "bind") end
if view.screen == "make" then return app.settle(view.makeList, report, "make-type") end
if view.screen == "many" then return app.settle(view.kindList, report, "kind") end
if view.screen == "store" then return app.settle(view.itemList, report, "store-item") end
return false
end



local function ask(view, command, params, opts)
app.ask(view, {kind = "act", command = command, params = params, opts = opts})
end

function bind.act(view, action)
local kind = action and action.kind
local lists = {list = view.list, make = view.makeList, many = view.kindList,
store = view.itemList}
local list = lists[view.screen]
if list and app.page(list, kind, action) then return true end

if kind == "show" then
if action.screen == "list" then view.walk = nil end
view.screen = action.screen
return true
elseif kind == "pick" then
view.chosen, view.screen = action.path, "methods"
return true
elseif kind == "keep" then
view.keepPages = view.keepPages == false
return true
elseif kind == "method" then
local path = view.chosen
if action.method == "page" then
ask(view, "print_bind_pages", {paths = {path}, keep = view.keepPages ~= false},
bind.PRINT)
else
ask(view, "show_me", {path = path, mode = action.method})
end
return true
elseif kind == "bind-new" and action.path then


view.chosen = action.path
ask(view, "show_me", {path = action.path, mode = "new"})
return true
elseif kind == "answer" then
ask(view, "show_me", {answer = action.yes})
return true
elseif kind == "stop" then
ask(view, "show_me", {cancel = true})
return true
elseif kind == "cancel-page" then
ask(view, "cancel_bind_page", {path = action.path})
return true
elseif kind == "open-make" then
view.make = {script = action.script, name = "", typed = false}
if action.script then view.make.name = bind.suggestName(view, action.script) end
view.makeList = app.newList()
view.screen = "make"
return true
elseif kind == "make-type" then
view.make.script = action.script
if not view.make.typed then view.make.name = bind.suggestName(view, action.script) end
return true
elseif kind == "open-many" then
if not (view.make and view.make.script) then return false end
view.many = {script = view.make.script, group = view.make.script}
view.kindList = app.newList()
view.screen = "many"
return true
elseif kind == "open-store" then
view.newStore = {holds = nil, name = "", field = "search", typed = false}
view.itemList = app.newList()
view.screen = "store"
return true
elseif kind == "store-item" then
local st = view.newStore
st.holds = action.item
if not st.typed then st.name = bind.storeName(action.item) end
st.field = "name"
return true
elseif kind == "store-focus" then
view.newStore.field = action.field
if action.field == "holds" and not view.newStore.holds then view.newStore.holds = "#" end
return true
elseif kind == "make-store" then
if bind.storeBlocked(view) then return false end
ask(view, "add_store", {name = view.newStore.name, holds = view.newStore.holds})
return true
elseif kind == "edit-type" then

view.jump = {app = "machines", action = {kind = "edit", script = action.script}}
return true
elseif kind == "many-kind" then
if bind.manyBlocked(view) then return false end
ask(view, "add_machines", {script = view.many.script, group = view.many.group,
kind = action.block}, bind.PRINT)
return true
elseif kind == "many-new" then
if bind.manyBlocked(view) then return false end
ask(view, "show_me", {mode = "many", script = view.many.script,
group = view.many.group})
return true
elseif kind == "make" then
if bind.makeBlocked(view) then return false end
ask(view, "add_machine", {machine = view.make.name, script = view.make.script})
return true
end
return false
end

function bind.searching(view)
if view.screen == "list" and view.data then return view.list end
return nil
end



function bind.keyboard(view, event)
if not event then return false end
if view.screen == "store" and view.newStore then
local st = view.newStore
if st.field == "search" then
return app.type(view.itemList, event)
end
local pattern = st.field == "holds" and "^[%w_%-:%./#]$" or "^[%w_%-]$"
local value = st.field == "holds" and (st.holds or "") or st.name
if event.kind == "char" and type(event.char) == "string"
and event.char:match(pattern) then
if #value < 40 then value = value .. event.char:lower() end
elseif event.kind == "key" and keys
and (event.key == keys.backspace or event.key == keys.delete) then
value = event.key == keys.delete and "" or value:sub(1, -2)
elseif event.kind == "key" and keys and event.key == keys.enter then
return true, {kind = "make-store"}
else
return app.type(view.itemList, event)
end
if st.field == "holds" then
st.holds = value
if not st.typed then st.name = bind.storeName(value) end
else
st.name, st.typed = value:sub(1, bind.NAME_LENGTH), true
end
return true
end
if view.screen == "many" and view.many then
local many = view.many
if event.kind == "char" and type(event.char) == "string"
and event.char:match("^[%w_%-]$") then
if #many.group < bind.NAME_LENGTH then many.group = many.group .. event.char:lower() end
return true
end
if event.kind == "key" and keys
and (event.key == keys.backspace or event.key == keys.delete) then
many.group = event.key == keys.delete and "" or many.group:sub(1, -2)
return true
end
if event.kind == "key" and keys and event.key == keys.enter then
return true, {kind = "many-new"}
end
return app.type(view.kindList, event)
end
if view.screen == "make" and view.make then
local make = view.make
if not make.script then
if event.kind == "key" and keys and event.key == keys.enter and view.makeList.top then
return true, view.makeList.top
end
return app.type(view.makeList, event)
end
if event.kind == "char" and type(event.char) == "string"
and event.char:match("^[%w_%-]$") then
if #make.name < bind.NAME_LENGTH then
make.name, make.typed = make.name .. event.char:lower(), true
end
return true
end
if event.kind == "key" and keys
and (event.key == keys.backspace or event.key == keys.delete) then
make.name = event.key == keys.delete and "" or make.name:sub(1, -2)
make.typed = true
return true
end
if event.kind == "key" and keys and event.key == keys.enter then
return true, {kind = "make"}
end
return app.type(view.makeList, event)
end
local list = bind.searching(view)
if list then return app.type(list, event) end
return false
end

function bind.handle(view, event, grid)
local took, chose = bind.keyboard(view, event)
if took then
if chose then bind.act(view, chose) end
return true
end
if not input.heard(event) then return false end
local action = input.actionFor(grid, event)
if not action then return false end
return bind.act(view, action)
end

return bind
