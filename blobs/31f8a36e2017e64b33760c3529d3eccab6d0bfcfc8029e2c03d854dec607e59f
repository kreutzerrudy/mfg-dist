






























local doc = require("mfg.hmi.doc")
local app = require("mfg.hmi.app")
local schema = require("mfg.common.script.schema")
local edit = require("mfg.common.script.edit")
local parse = require("mfg.common.script.parse")
local format = require("mfg.common.script.format")
local check = require("mfg.common.script.check")
local lex = require("mfg.common.script.lex")

local editor = {}

editor.DRAFTS = "/mfg/drafts"
editor.READ = {timeout = 3, attempts = 2}
editor.SAVE = {timeout = 10, attempts = 1}
editor.INDENT = 2
editor.MARGIN = 2


local VERB_ACTIONS = {}
for _, action in pairs(check.VERBS) do VERB_ACTIONS[action] = true end



local function draftPath(name)
return fs.combine(editor.DRAFTS, (name or "_new") .. ".tree")
end

function editor.loadDraft(name)
local path = draftPath(name)
if not fs.exists(path) then return nil end
local handle = fs.open(path, "r")
if not handle then return nil end
local data = textutils.unserialize(handle.readAll())
handle.close()
return type(data) == "table" and data.tree and data or nil
end

local function saveDraft(ed)
if not ed.state.dirty then return end
local handle = fs.open(draftPath(ed.state.tree.machine), "w")
if not handle then return end
handle.write(textutils.serialize({tree = ed.state.tree, rev = ed.rev}))
handle.close()
end

function editor.dropDraft(name)
local path = draftPath(name)
if fs.exists(path) then fs.delete(path) end
end





function editor.new(view, name)
local ed = {
view = view,
name = name,
rev = name and nil or 0,
state = nil,
cursor = 1, slot = 1,
lines = app.newList(),
chooser = nil,
decls = {}, items = nil,
queue = {},
result = nil,
confirm = nil,
stale = nil,
machines = {},
draft = false,
version = 0,
}
local draft = editor.loadDraft(name)
if draft then
ed.state = edit.open(draft.tree)
ed.state.dirty = true
ed.rev = draft.rev or ed.rev
ed.draft = true
ed.result = {text = "your unsaved draft -- discard it with the button above",
colour = "warn"}
elseif not name then
ed.state = edit.blank(nil)
end
if name then ed.queue[#ed.queue + 1] = {kind = "script"} end
for action in pairs(VERB_ACTIONS) do
ed.queue[#ed.queue + 1] = {kind = "offer", name = action}
end
ed.queue[#ed.queue + 1] = {kind = "items"}
return ed
end

function editor.title(ed)
local name = ed.state and ed.state.tree.machine or ed.name
return ("EDIT %s%s%s"):format(name or "new script",
(ed.rev and ed.rev > 0) and (" rev " .. ed.rev) or "",
(ed.state and ed.state.dirty) and " *" or "")
end



local function rows(ed)
return ed.state and edit.rows(ed.state) or {}
end

local function currentRow(ed)
local list = rows(ed)
ed.cursor = math.max(1, math.min(ed.cursor, #list))
return list[ed.cursor], list
end


local function report(ed)
if not ed.state then return nil end
if ed.checked ~= ed.version then
local complete = true
for action in pairs(VERB_ACTIONS) do
if not ed.decls[action] then complete = false end
end
local itemSet = nil
if ed.items then
itemSet = {}
for item in pairs(ed.items) do itemSet[item] = true end
end
ed.report = check.check(ed.state.tree, {decls = complete and ed.decls or nil,
items = itemSet})
ed.marks = edit.marks(ed.report)
ed.checked = ed.version
end
return ed.report
end

local function itemName(ed)
return function(item)
local known = ed.view.names and ed.view.names[item]
return (known and known.name) or app.shortName(item)
end
end



local NAME_PIECE = {field = "machine", type = "name"}
local function parts(ed, row)
if row.kind == "machine" then
return {{text = "machine"}, {text = row.node.machine or schema.HOLE, piece = NAME_PIECE}}
elseif row.kind == "else" then
return {{text = "else"}}
end
return schema.parts(row.node, {itemName = itemName(ed)})
end

local function slotsOf(ed, row)
local out = {}
for _, part in ipairs(parts(ed, row)) do
if part.piece then out[#out + 1] = part end
end
return out
end


local function changed(ed)
ed.version = ed.version + 1
ed.stale = nil
saveDraft(ed)
currentRow(ed)
end



function editor.nextJob(ed)
return table.remove(ed.queue, 1)
end

function editor.exchange(ed, job)
local body, opts = nil, editor.READ
if job.kind == "script" then
body = {command = "scripts", script = ed.name, brief = true}
elseif job.kind == "offer" then
body = {command = "offer", name = job.name}
elseif job.kind == "items" then
body = {command = "available"}
elseif job.kind == "check" then
body = {command = "check_script", source = format.format(ed.state.tree)}
elseif job.kind == "save" then
body = {command = "register_script", source = format.format(ed.state.tree),
expect = job.expect, operator = true}
opts = editor.SAVE
ed.sending = job
elseif job.kind == "add" then
body = {command = "add_machine", machine = job.machine,
script = ed.state.tree.machine, operator = true}
opts = editor.SAVE
ed.sending = job
else
return false
end
editor.apply(ed, job, ed.view.transport.request(body, opts) or {})
return true
end




local function translate(ed, errors)
local reparsed = parse.parse(format.format(ed.state.tree))
local theirs, mine = {[0] = 0}, {}
schema.each(reparsed, function(n) theirs[#theirs + 1] = n.id end)
schema.each(ed.state.tree, function(n) mine[#mine + 1] = n.id end)
local map = {[0] = 0}
for i, id in ipairs(theirs) do map[id] = mine[i] end
local out = {}
for _, e in ipairs(errors or {}) do
out[#out + 1] = {node = map[e.node] or 0, message = e.message, line = e.line}
end
return out
end

local function say(ed, text, colour)
ed.result = {text = text, colour = colour or "text"}
end

function editor.apply(ed, job, answer)
app.noteLink(ed.view, answer)

ed.version = ed.version + 1
local ok = answer.status == app.COMPLETED
if job.kind == "script" then
if not ok then
say(ed, "the controller refused: " .. tostring(answer.reason or answer.status), "bad")
return
end
for _, t in ipairs(answer.scripts or {}) do
if t.script == ed.name then
ed.machines = t.machines or {}
if not ed.draft or ed.reload then
ed.state = edit.open(t.tree)
ed.rev = t.rev
ed.reload, ed.draft = nil, false
elseif ed.rev ~= t.rev then
say(ed, ("your draft is from rev %s; the controller has rev %d")
:format(tostring(ed.rev), t.rev), "warn")
end
end
end
if not ed.state then say(ed, "no script called " .. tostring(ed.name), "bad") end
elseif job.kind == "offer" then
local decl = ok and answer.actions and answer.actions[1]
if decl then ed.decls[job.name] = decl end
elseif job.kind == "items" then
if ok and type(answer.items) == "table" then
ed.items = answer.items
for item, known in pairs(answer.names or {}) do ed.view.names[item] = known end
end
elseif job.kind == "check" then
if not ok then
say(ed, "the controller could not check it: " .. tostring(answer.reason), "bad")
elseif answer.ok then
local f = answer.footprint or {}
say(ed, ("the controller agrees: no errors. It supplies %s; collects %s")
:format(#(f.supplies or {}) > 0 and table.concat(f.supplies, ", ") or "nothing",
#(f.collects or {}) > 0 and table.concat(f.collects, ", ") or "nothing"),
"good")
else
local errs = translate(ed, answer.errors)
ed.remoteErrors = errs
say(ed, ("the controller finds %d error%s: %s"):format(#errs,
#errs == 1 and "" or "s", errs[1] and errs[1].message or "?"), "bad")
end
elseif job.kind == "save" then
ed.sending = nil
if ok then
ed.rev = answer.rev
ed.state.dirty = false
editor.dropDraft(ed.state.tree.machine)
if ed.name == nil then editor.dropDraft(nil) end
ed.name = answer.script
ed.machines = answer.machines or {}
local follow = #ed.machines > 0 and ("; " .. table.concat(ed.machines, ", ")
.. " take it between runs") or ""
say(ed, ("saved %s rev %d%s"):format(answer.script, answer.rev, follow), "good")
ed.madeNew = job.expect == 0
ed.view.readAt = nil
app.sound(ed.view, "done")
elseif answer.stale then
ed.stale = {rev = answer.rev}
say(ed, tostring(answer.reason), "bad")
app.sound(ed.view, "refused")
elseif answer.status == app.TIMED_OUT then
say(ed, "no answer -- look in the Types list before saving again", "warn")
else
if answer.errors then ed.remoteErrors = translate(ed, answer.errors) end
say(ed, "refused: " .. tostring(answer.reason), "bad")
app.sound(ed.view, "refused")
end
elseif job.kind == "add" then
ed.sending = nil
if ok then
say(ed, ("made %s from %s -- bind it in mfgctl, then enable it"):format(
job.machine, ed.state.tree.machine), "good")
ed.madeNew = false
ed.view.readAt = nil
else
say(ed, "refused: " .. tostring(answer.reason), "bad")
end
end
end



local function portEntries(ed, piece)
local out = {}
for _, port in ipairs(ed.state.tree.ports) do
local kindOk = not piece.kind or (piece.kind == "volume" and port.type == "volume")
or (piece.kind == "signal" and port.type and port.type ~= "volume")
local dirOk = not piece.direction or port.direction == piece.direction
if port.name and kindOk and dirOk then
out[#out + 1] = {value = port.name, label = port.name,
note = ("%s %s"):format(port.direction or "?", port.type or "?")}
end
end
return out
end

local function itemEntries(ed)
local out = {}
for item, entry in pairs(ed.items or {}) do
out[#out + 1] = {value = item, label = itemName(ed)(item),
note = tostring(entry.free or entry.held or ""), chip = app.chipFor(item)}
end
table.sort(out, function(a, b)
if a.label:lower() ~= b.label:lower() then return a.label:lower() < b.label:lower() end
return a.value < b.value
end)
return out
end


local function portNamed(ed, name)
for _, port in ipairs(ed.state.tree.ports) do
if port.name == name then return port end
end
return nil
end


local function openSlot(ed, row, part)
local piece = part.piece
local t = piece.type
local chooser = {row = ed.cursor, node = row.node, piece = piece, list = app.newList()}
local current = row.node[piece.field]
local function field(hint, text)
chooser.mode, chooser.hint = "field", hint
chooser.text = text or ""
end
if t == "port" then
chooser.mode, chooser.entries = "list", portEntries(ed, piece)
chooser.hint = #chooser.entries > 0 and "choose the port"
or "no port fits here -- add one to the header first"
elseif t == "item" then
chooser.mode, chooser.entries = "list", itemEntries(ed)
chooser.hint = "choose an item, or type an id like minecraft:coal and Enter"
chooser.typed = true
elseif schema.CHOICES[t] then
chooser.mode, chooser.entries = "list", {}
for _, choice in ipairs(schema.CHOICES[t]) do
chooser.entries[#chooser.entries + 1] = {value = choice, label = choice}
end
chooser.hint = "choose one"
elseif t == "value" then
local port = portNamed(ed, row.node.port)
if port and port.type == "flag" then
chooser.mode, chooser.hint = "list", "on or off"
chooser.entries = {{value = "on", label = "on"}, {value = "off", label = "off"}}
else
field("a level, 0-15", current and schema.expr(current) or "")
end
elseif t == "count" then
field(("how many, %d-%d"):format(piece.min or 1, piece.max or 64),
current and tostring(current) or "")
elseif t == "duration" then
field("a duration: 4t, 5s or 2m", current and schema.value(piece, current) or "")
elseif t == "cond" then
field("a condition, like fill < 4 and free minecraft:coal > 0",
current and schema.expr(current) or "")
elseif t == "text" then
field("the alarm's text", current or "")
elseif t == "name" then
field("a name: lowercase letters, digits and _", current or "")
elseif t == "slots" then
field("slots: 2, 1-9 or 1,3", current and format.slots(current) or "")
elseif t == "safe" then
field("safe at: on, off or 0-15", current and schema.expr(current) or "")
else
return false
end
ed.chooser = chooser
return true
end

local function openPalette(ed)
local row = currentRow(ed)
if not row then return false end
local entries = {}
for _, kind in ipairs(edit.palette(row)) do
local k = schema.KINDS[kind]
entries[#entries + 1] = {value = kind, label = k and k.label or kind,
note = k and (k.place == "top" and "handler" or k.place == "header" and "port"
or (k.block and "block" or "")) or "block"}
end
ed.chooser = {mode = "list", palette = true, row = ed.cursor, entries = entries,
list = app.newList(), hint = "add a line: choose what it is"}
return true
end

local function openLine(ed)
local row = currentRow(ed)
if not row or row.kind == "else" then return false end
local text = row.kind == "machine" and ("machine " .. (row.node.machine or ""))
or schema.text(row.node)
if row.node.comment then text = text .. "  --" .. row.node.comment end
ed.chooser = {mode = "field", line = true, row = ed.cursor, node = row.node,
text = text, hint = "type the line; Enter keeps it"}
return true
end


local function typed(ed, piece, text, node)
local t = piece.type
if t == "count" then
local n = tonumber(text)
if not n or n % 1 ~= 0 then return nil, "a whole number" end
if n < (piece.min or 1) or n > (piece.max or math.huge) then
return nil, ("%d-%d"):format(piece.min or 1, piece.max or 64)
end
return n
elseif t == "duration" then
local n, unit = text:match("^%s*(%d+)([tsm])%s*$")
if not n then return nil, "a number then t, s or m: 4t, 5s, 2m" end
local d = {n = tonumber(n), unit = unit}
local ticks = parse.ticks(d)
if ticks < (piece.min or 1) or ticks > (piece.max or math.huge) then
return nil, "out of range for this"
end
return d
elseif t == "cond" then
local n, top, errors = parse.line("if " .. text, "block", ed.state.top)
if not n then return nil, errors[1] and errors[1].message or "not a condition" end
ed.state.top = top
return n.cond
elseif t == "value" or t == "safe" then
local n, top, errors = parse.line("set x to " .. text, "block", ed.state.top)
if not n then return nil, "on, off or a level 0-15" end
ed.state.top = top
return n.value
elseif t == "text" then
if text == "" or text:find('"', 1, true) then return nil, "some text, without \"" end
if #text > check.LIMITS.textMax then
return nil, ("at most %d characters"):format(check.LIMITS.textMax)
end
return text
elseif t == "name" then
if not text:match("^[a-z_][a-z0-9_]*$") then
return nil, "lowercase letters, digits and _, not starting with a digit"
end
if lex.KEYWORDS[text] then return nil, ("`%s` is a keyword"):format(text) end
return text
elseif t == "slots" then
if text == "" then return false end
local n, _, errors = parse.line("input x : volume slots " .. text, "header", 0)
if not n then return nil, errors[1] and errors[1].message or "slots like 1-3" end
return n.slots
elseif t == "item" then
if not text:match("^[a-z0-9_.%-]+:[a-z0-9_./%-]+$") then
return nil, "an item id: namespace:path"
end
return text
end
return nil, "not typed"
end


local function fill(ed, chooser, value)
local node, piece = chooser.node, chooser.piece
if piece.field == "machine" then
edit.set(ed.state, ed.state.tree, "machine", value)
elseif piece.type == "value" and (value == "on" or value == "off") then
edit.set(ed.state, node, piece.field, {kind = "onoff", value = value == "on",
id = edit.nextId(ed.state), span = {}})
else
edit.set(ed.state, node, piece.field, value or nil)
end
ed.chooser = nil

local row = currentRow(ed)
for i, part in ipairs(slotsOf(ed, row)) do
if part.text == schema.HOLE then ed.slot = i; break end
end
changed(ed)
end


local function commit(ed, entry)
local chooser = ed.chooser
if not chooser then return false end
if chooser.palette then
local row = currentRow(ed)
local n, why = edit.insert(ed.state, row, entry.value)
ed.chooser = nil
if not n then say(ed, why, "bad"); return true end

for i, r in ipairs(rows(ed)) do
if (entry.value == "else" and r.kind == "else" and r.node == n)
or (entry.value ~= "else" and r.node == n and r.kind ~= "else") then
ed.cursor = i
end
end
ed.slot = 1
changed(ed)
local new = currentRow(ed)
local first = slotsOf(ed, new)[1]
if first and first.text == schema.HOLE then openSlot(ed, new, first) end
return true
end
if chooser.mode == "list" then
if entry then fill(ed, chooser, entry.value); return true end
if chooser.typed and chooser.list.query ~= "" then
local value, why = typed(ed, chooser.piece, chooser.list.query, chooser.node)
if value == nil then chooser.why = why; return true end
fill(ed, chooser, value)
end
return true
end

if chooser.line then
local row = rows(ed)[chooser.row]
local n, errors = edit.replace(ed.state, row, chooser.text)
if not n then
chooser.why = errors and errors[1] and errors[1].message or "does not parse"
return true
end
ed.chooser = nil
changed(ed)
return true
end
if chooser.name then
local value, why = typed(ed, NAME_PIECE, chooser.text)
if not value then chooser.why = why; return true end
ed.chooser = nil
app.ask(ed, {kind = "add", machine = value})
return true
end
local value, why = typed(ed, chooser.piece, chooser.text, chooser.node)
if value == nil then chooser.why = why; return true end
fill(ed, chooser, value ~= false and value or nil)
return true
end



