local busy = ed.sending ~= nil
local children = {
doc.gap(1),
doc.button("+ add", {key = "+", action = {kind = "ed-palette"}, keep = doc.REQUIRED,
name = "ed-add"}),
doc.gap(1),
doc.button("type", {key = "t", action = {kind = "ed-type"}, keep = 8, name = "ed-type"}),
doc.gap(1),
doc.button("del", {key = "delete", keyLabel = "del", colour = "bad",
action = {kind = "ed-delete"}, keep = 7, name = "ed-delete"}),
doc.gap(1),
doc.button("undo", {key = "u", colour = #ed.state.undo > 0 and "action" or "dim",
action = #ed.state.undo > 0 and {kind = "ed-undo"} or nil, keep = 6,
name = "ed-undo"}),
doc.spacer({min = 1}),
doc.button("Check", {key = "c", action = (not busy) and {kind = "ed-check"} or nil,
colour = busy and "dim" or "action", keep = 9, name = "ed-check"}),
