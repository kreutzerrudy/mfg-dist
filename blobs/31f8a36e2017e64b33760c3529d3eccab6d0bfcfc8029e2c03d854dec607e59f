table.insert(children, 3, doc.gap(1))
end
return doc.row(children, {keep = doc.REQUIRED, name = "ed-toolbar"})
end


local function lineRow(ed, index, row, total)
local marks = ed.marks and ed.marks[row.node.id]
local remote = nil
for _, e in ipairs(ed.remoteErrors or {}) do
if e.node == row.node.id and row.kind ~= "else" then remote = e end
end
local mark, markColour = " ", "dim"
if (marks and marks[1].level == "error") or remote then
mark, markColour = "!", "bad"
elseif marks then
mark, markColour = "~", "warn"
end
local current = index == ed.cursor
local grip = {kind = "ed-line", row = index, drag = {row = index},
drop = {row = index}}
local children = {
doc.text(mark, {colour = markColour, keep = doc.REQUIRED,
name = "mark:" .. index, action = grip}),
doc.text(string.rep(" ", editor.MARGIN - 1 + row.depth * editor.INDENT),
{keep = doc.REQUIRED, name = "indent:" .. index, action = grip}),
}
local slotIndex = 0
for i, part in ipairs(parts(ed, row)) do
if i > 1 then children[#children + 1] = doc.gap(1) end
if part.piece then
slotIndex = slotIndex + 1
local hole = part.text == schema.HOLE
local chosen = current and slotIndex == ed.slot
children[#children + 1] = doc.text(part.text, {
colour = hole and "bad" or "text",
bg = chosen and "selected" or "field", truncate = doc.TRUNCATED,
keep = 60 - i, name = ("slot:%d:%d"):format(index, slotIndex),
action = {kind = "ed-slot", row = index, slot = slotIndex,
drag = {row = index}, drop = {row = index}}})
else
children[#children + 1] = doc.text(part.text, {
colour = (row.kind == "machine" or row.place == "top") and "title" or "label",
keep = 60 - i, name = ("word:%d:%d"):format(index, i), action = grip})
end
end
if row.node.comment and row.kind ~= "else" then
children[#children + 1] = doc.text("  --" .. row.node.comment, {colour = "dim",
truncate = doc.TRUNCATED, keep = 1, name = "comment:" .. index})
end
children[#children + 1] = doc.text(" ", {width = "fill", keep = doc.REQUIRED,
name = "rest:" .. index, action = grip})
local over = ed.carry and ed.carry.over and ed.carry.over.row == index
return doc.row(children, {keep = 20 + (total - index), name = "line:" .. index,
bg = over and "selected" or (current and "zebra" or nil)})
end

local function chooserRows(ed, rowsOut, height)
local chooser = ed.chooser
rowsOut[#rowsOut + 1] = doc.rule({keep = 300, name = "ed-chooser-rule"})
rowsOut[#rowsOut + 1] = doc.row({
doc.text(" " .. (chooser.hint or ""), {colour = "label", width = "fill",
truncate = doc.TRUNCATED, keep = doc.REQUIRED, name = "ed-hint"}),
doc.button("cancel", {action = {kind = "ed-cancel"}, keep = doc.REQUIRED,
name = "ed-cancel"}),
doc.gap(1),
}, {keep = doc.REQUIRED, name = "ed-chooser-head"})
if chooser.mode == "field" then
rowsOut[#rowsOut + 1] = doc.text(" " .. chooser.text .. "_", {bg = "field",
colour = "title", width = "fill", truncate = doc.TRUNCATED,
keep = doc.REQUIRED, name = "ed-field"})
else
local entries = chooser.entries or {}
local rowsBuilt = app.listRows(chooser.list, entries, "choice",
function(entry) return {kind = "ed-choose", value = entry.value} end,
{pickKeys = false, arrows = true, limit = math.max(3, math.floor(height / 2))})
for _, r in ipairs(rowsBuilt) do

r.keep = (type(r.keep) == "number") and (r.keep + 200) or r.keep
rowsOut[#rowsOut + 1] = r
end
if #entries == 0 then
rowsOut[#rowsOut + 1] = doc.text(" nothing to choose from", {colour = "dim",
keep = 250, name = "ed-none"})
end
end
if chooser.why then
rowsOut[#rowsOut + 1] = doc.text(" " .. chooser.why, {colour = "bad", wrap = true,
keep = 400, name = "ed-why"})
end
end



local function statusText(ed)
if ed.sending then return ("asking %s.."):format(ed.view.host), "warn" end
local row = currentRow(ed)
local marks = row and ed.marks and ed.marks[row.node.id]
if row and row.kind ~= "else" and marks then
return marks[1].message, marks[1].level == "error" and "bad" or "warn"
end
if ed.result then return ed.result.text, ed.result.colour end
local r = ed.report
if r then
if r.ok then
return ("ok -- %d warning%s"):format(#r.warnings, #r.warnings == 1 and "" or "s"),
"good"
end
return ("%d to fix before it can be saved"):format(#r.errors), "warn"
end
return "", "text"
end

local function confirmDocument(ed, rowsOut)
local r = report(ed)
local name = ed.state.tree.machine
if ed.confirm == "delete" then
rowsOut[#rowsOut + 1] = doc.text(" Remove this line and everything under it?",
{colour = "title", wrap = true, keep = doc.REQUIRED, name = "ed-confirm"})
else
rowsOut[#rowsOut + 1] = doc.text((" Save %s as rev %d?"):format(name,
(ed.rev or 0) + 1), {colour = "title", keep = doc.REQUIRED, name = "ed-confirm"})
local f = r and r.footprint or {}
local function line(label, list, keep)
if list and #list > 0 then
rowsOut[#rowsOut + 1] = doc.text(("  %s: %s"):format(label,
table.concat(list, ", ")), {colour = "text", truncate = doc.TRUNCATED,
keep = keep, name = "ed-foot-" .. label})
end
end
line("supplies", f.supplies, 30)
line("collects", f.collects, 29)
line("drives", f.drives, 28)
if #ed.machines > 0 then
rowsOut[#rowsOut + 1] = doc.text(("  %s run this type, and take the change "
.. "between runs"):format(table.concat(ed.machines, ", ")),
{colour = "warn", wrap = true, keep = 40, name = "ed-follow"})
end
end
rowsOut[#rowsOut + 1] = doc.text("", {keep = doc.REQUIRED, name = "ed-above"})
rowsOut[#rowsOut + 1] = doc.row({
doc.gap(1),
doc.button("yes", {key = "y", colour = "good", action = {kind = "ed-yes"},
keep = doc.REQUIRED, name = "ed-yes"}),
doc.gap(1),
doc.button("no", {key = "n", colour = "bad", action = {kind = "ed-no"},
keep = doc.REQUIRED, name = "ed-no"}),
}, {keep = doc.REQUIRED, name = "ed-confirm-actions"})
rowsOut[#rowsOut + 1] = doc.spacer()
end


function editor.document(ed, rowsOut, height)
if not ed.state then
rowsOut[#rowsOut + 1] = doc.text(" reading the script..", {colour = "dim",
keep = doc.REQUIRED, name = "ed-reading"})
rowsOut[#rowsOut + 1] = doc.spacer()
return
end
report(ed)
if ed.confirm then return confirmDocument(ed, rowsOut) end
rowsOut[#rowsOut + 1] = toolbar(ed)

local list = rows(ed)
local lines = ed.lines

if ed.cursor < lines.from then lines.from = ed.cursor end
if lines.shown and lines.shown > 0 and ed.cursor > lines.from + lines.shown - 1 then
lines.from = ed.cursor - lines.shown + 1
end
lines.from = math.max(1, math.min(lines.from, #list))
local upto = math.min(#list, lines.from + height - 1)
lines.listed = upto - lines.from + 1
for index = lines.from, upto do
rowsOut[#rowsOut + 1] = lineRow(ed, index, list[index], #list)
end
rowsOut[#rowsOut + 1] = doc.spacer()
if ed.chooser then chooserRows(ed, rowsOut, height) end
if ed.stale then
rowsOut[#rowsOut + 1] = doc.row({
doc.gap(1),
doc.button("reload theirs", {action = {kind = "ed-reload"}, keep = doc.REQUIRED,
name = "ed-reload"}),
doc.gap(1),
doc.button("overwrite with mine", {colour = "bad",
action = {kind = "ed-overwrite"}, keep = doc.REQUIRED, name = "ed-overwrite"}),
}, {keep = 500, name = "ed-stale"})
elseif ed.madeNew and not ed.chooser then
rowsOut[#rowsOut + 1] = doc.row({doc.gap(1), doc.button("Make a machine from it",
{action = {kind = "ed-make"}, keep = doc.REQUIRED, name = "ed-make"})},
{keep = 500, name = "ed-make-row"})
end
local text, colour = statusText(ed)
rowsOut[#rowsOut + 1] = doc.text(" " .. (text or ""), {colour = colour, wrap = true,
keep = app.KEEP_STATUS, name = "status"})
end

function editor.settle(ed, rep)
if ed.chooser and ed.chooser.mode == "list" then
app.settle(ed.chooser.list, rep, "choice")
end
return app.settle(ed.lines, rep, "line")
end





local function drop(ed, from, onto, x)
local list = rows(ed)
local moving, target = list[from], list[onto]
if not moving or not target or from == onto or moving.kind == "machine"
or moving.kind == "else" then return false end
local depth = x and math.floor((x - 1 - editor.MARGIN) / editor.INDENT)
or target.depth
local ok, why = edit.dropAt(ed.state, moving, target, depth)
if not ok then say(ed, why, "bad"); return true end
for i, r in ipairs(rows(ed)) do
if r.node == moving.node and r.kind ~= "else" then ed.cursor = i end
end
changed(ed)
return true
end

local function removeLine(ed)
local row = currentRow(ed)
local ok, why = edit.remove(ed.state, row)
if not ok then say(ed, why, "bad") else changed(ed) end
end

function editor.act(ed, action)
local kind = action and action.kind
if not ed.state then return false end
if ed.chooser and ed.chooser.mode == "list" and app.page(ed.chooser.list, kind, action) then
return true
end
if kind == "carry" then
ed.carry = {drag = action.drag, over = action.over}
return true
elseif kind == "drop" then
ed.carry = nil
if action.drag and action.drag.row and action.over and action.over.row then
return drop(ed, action.drag.row, action.over.row, action.x)
end
return true
elseif kind == "ed-line" then
ed.cursor, ed.slot = action.row, 1
ed.chooser = nil
return true
elseif kind == "ed-slot" then
local wasHere = ed.cursor == action.row and ed.slot == action.slot
ed.cursor, ed.slot = action.row, action.slot
local row = currentRow(ed)
local part = slotsOf(ed, row)[action.slot]

if part and (wasHere or part.text == schema.HOLE) then openSlot(ed, row, part) end
return true
elseif kind == "ed-choose" then
return commit(ed, {value = action.value})
elseif kind == "ed-cancel" then
ed.chooser = nil
return true
elseif kind == "ed-palette" then
return openPalette(ed)
elseif kind == "ed-type" then
return openLine(ed)
elseif kind == "ed-delete" then
local row = currentRow(ed)
if row.kind == "machine" then say(ed, "the machine line stays", "bad"); return true end
if edit.holdsLines(row) then ed.confirm = "delete"; return true end
removeLine(ed)
return true
elseif kind == "ed-undo" then
if edit.undo(ed.state) then changed(ed) end
return true
elseif kind == "ed-check" then
ed.remoteErrors = nil
app.ask(ed, {kind = "check"})
return true
elseif kind == "ed-save" then
local r = report(ed)
if not r.ok then
say(ed, ("%d to fix first -- the lines marked !"):format(#r.errors), "bad")
app.sound(ed.view, "refused")
return true
end
ed.confirm = "save"
return true
elseif kind == "ed-yes" then
local was = ed.confirm
ed.confirm = nil
if was == "delete" then
removeLine(ed)
else
ed.remoteErrors = nil
app.ask(ed, {kind = "save", expect = ed.rev or 0})
end
return true
elseif kind == "ed-no" then
ed.confirm = nil
return true
elseif kind == "ed-overwrite" then
local rev = ed.stale and ed.stale.rev
ed.stale = nil
app.ask(ed, {kind = "save", expect = rev})
return true
elseif kind == "ed-reload" or kind == "ed-discard" then

ed.stale = nil
if kind == "ed-discard" then editor.dropDraft(ed.state.tree.machine) end
if not ed.name then
ed.state, ed.draft = edit.blank(nil), false
ed.result = nil
return true
end
ed.reload, ed.draft = true, false
ed.result = nil
app.ask(ed, {kind = "script"})
return true
elseif kind == "ed-make" then
ed.chooser = {mode = "field", name = true, text = "",
hint = "the new machine's name, like f1"}
return true
end
return false
end

local function moveCursor(ed, step)
local _, list = currentRow(ed)
ed.cursor = math.max(1, math.min(ed.cursor + step, #list))
ed.slot = 1
end

local function shiftLine(ed, fn, ...)
local row = currentRow(ed)
local node = row.node
local ok, why = fn(ed.state, row, ...)
if not ok then say(ed, why, "bad"); return end
for i, r in ipairs(rows(ed)) do
if r.node == node and r.kind ~= "else" then ed.cursor = i end
end
changed(ed)
end



function editor.keyboard(ed, event)
if not ed.state or ed.confirm then return false end
local chooser = ed.chooser
if event.kind == "scroll" and not chooser then
app.scroll(ed.lines, event.dir or 0)
return true
end
if chooser and chooser.mode == "field" then
if event.kind == "char" then
chooser.text = chooser.text .. event.char
chooser.why = nil
return true
elseif event.kind == "key" and keys then
if event.key == keys.backspace then
if chooser.text == "" then ed.chooser = nil
else chooser.text = chooser.text:sub(1, -2) end
return true
elseif event.key == keys.delete then
chooser.text = ""
return true
elseif event.key == keys.enter or event.key == keys.numPadEnter then
commit(ed)
return true
end
end
return false
end
if chooser and chooser.mode == "list" then
if event.kind == "key" and keys and (event.key == keys.enter
or event.key == keys.numPadEnter) then
local chosen = nil
for _, entry in ipairs(chooser.list.matched or {}) do
if entry.selected then chosen = entry end
end
chosen = chosen or (chooser.list.matched or {})[chooser.list.from or 1]
if chooser.typed and chooser.list.query:find(":", 1, true) then

local exact = false
for _, entry in ipairs(chooser.list.matched or {}) do
if entry.value == chooser.list.query then exact = true end
end
if not exact then chosen = nil end
end
commit(ed, chosen)
return true
end
if event.kind == "key" and keys and event.key == keys.backspace
and chooser.list.query == "" then
ed.chooser = nil
return true
end

if chooser.typed and event.kind == "char" and event.char:match("^[%d%.%-/]$") then
chooser.list.query = chooser.list.query .. event.char
chooser.list.from = 1
return true
end
local took, chose = app.type(chooser.list, event)
if chose then
for _, entry in ipairs(chooser.entries) do
entry.selected = (entry.value == chose.value)
end
end
return took
end

if event.kind == "char" then
local c = event.char
if c == "k" then shiftLine(ed, edit.shift, -1); return true
elseif c == "j" then shiftLine(ed, edit.shift, 1); return true
elseif c == "[" then shiftLine(ed, edit.outdent); return true
elseif c == "]" then shiftLine(ed, edit.indent); return true
end
return false
end
if event.kind ~= "key" or not keys then return false end
local key = event.key
if key == keys.up then moveCursor(ed, -1); return true
elseif key == keys.down then moveCursor(ed, 1); return true
elseif key == keys.left or key == keys.right then
local row = currentRow(ed)
local n = #slotsOf(ed, row)
if n > 0 then
ed.slot = ((ed.slot - 1 + (key == keys.right and 1 or -1)) % n) + 1
end
return true
elseif key == keys.enter or key == keys.numPadEnter then
local row = currentRow(ed)
local part = slotsOf(ed, row)[ed.slot]
if part then openSlot(ed, row, part) else openLine(ed) end
return true
elseif key == keys.pageUp or key == keys.pageDown then
app.page(ed.lines, key == keys.pageDown and "next" or "prev")
return true
end
return false
end

return editor
