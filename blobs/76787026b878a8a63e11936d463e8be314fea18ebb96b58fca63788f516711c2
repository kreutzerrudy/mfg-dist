










local equipment = {}

equipment.SIDES = {"left", "right"}


function equipment.fittedSet(fitted)
local set = {}
for _, side in ipairs(equipment.SIDES) do
local id = fitted and fitted[side]
if type(id) == "string" then set[id] = (set[id] or 0) + 1 end
end
return set
end







function equipment.missing(required, fitted)
local items = {}
for _, side in ipairs(equipment.SIDES) do
local id = fitted and fitted[side]
if type(id) == "string" then items[#items + 1] = id end
end

local function accepts(entry, id)
for _, want in ipairs(entry) do
if want == id then return true end
end
return false
end


local function unmet(order)
local used, out = {}, {}
for _, entry in ipairs(required or {}) do
local found = false
for _, i in ipairs(order) do
if not used[i] and accepts(entry, items[i]) then
used[i], found = true, true
break
end
end
if not found then out[#out + 1] = entry[1] or "?" end
end
return out
end

local best = unmet({1, 2})
if #best > 0 and #items == 2 then
local other = unmet({2, 1})
if #other < #best then best = other end
end
return best
end




function equipment.permits(decl, fitted)
if type(decl) ~= "table" or decl.needs == nil then return true end
local set = equipment.fittedSet(fitted)
for _, id in ipairs(decl.needs) do
if not set[id] then return false, id end
end
return true
end



function equipment.read(hw)
if type(hw) ~= "table" or type(hw.equipment) ~= "function" then
return nil, "this HAL cannot report equipment"
end
local ok, fitted = pcall(hw.equipment)
if not ok then return nil, tostring(fitted) end
if type(fitted) ~= "table" then return nil, "the HAL returned no equipment table" end
return fitted
end

return equipment
