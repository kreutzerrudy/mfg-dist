
































local random = require("ccryptolib.random")
local netkeys = require("netkeys")
local ip = require("ip")
local band = require("band")

local args = {...}
local cmd = args[1]


if not random.isInit() then
write("seeding crypto rng... ")
random.initWithTiming()
print("done")
end

netkeys.init()

local function findDisk()
for i = 0, 5 do
local path = i == 0 and "/disk" or ("/disk%d"):format(i)
if fs.exists(path) and fs.isDir(path) then return path end
end
return nil
end




local function parseKeyFile(path)
local f = fs.open(path, "r")
if not f then return nil, "could not open " .. path end
local data = f.readAll()
f.close()

local bare = data:gsub("%s", "")
if #bare == 64 and not bare:find("%X") then
return {exchange = bare}
end

local keys = {}
for label, hex in data:gmatch("(%a+)%s+(%x+)") do
if #hex == 64 then keys[label] = hex end
end


keys.name = data:match("name%s+([%w_%-]+)")
if not keys.exchange then
return nil, path .. " has no exchange key"
end
return keys
end

local function readKeyFile(path)
local keys, err = parseKeyFile(path)
if not keys then return nil, err end
return keys.exchange
end



local function resolveKey(arg)
if type(arg) ~= "string" or arg == "" then
return nil, "expected a key or a file path"
end

local trimmed = arg:gsub("%s", "")
if #trimmed == 64 and not trimmed:find("%X") then return trimmed end

if not fs.exists(arg) then
return nil, ("no such file: %s (and it is not a 64-character key)"):format(arg)
end
if fs.isDir(arg) then return nil, arg .. " is a directory" end

return readKeyFile(arg)
end




local function usage()
local lines = {
"netadmin key",
"netadmin role <server|client|both>",
"netadmin hostname [name]    what this computer asks to be called",
"netadmin substrate <rednet|hopnet>",
"",
"addressing",
"  netadmin ip               this computer's addressing",
"  netadmin iface [<addr>/<len> [modem] | del <addr>]",
"  netadmin subnet [<cidr> [via <ip>] [band <base> <size>] | del <cidr>]",
"  netadmin address <hex|path> <ip>              (server)",
"  netadmin band [<base> <size> | del]  hop channels this subnet uses",
"",
"identity",
"  netadmin export [path]    write our public key out",
"  netadmin pin <hex|path>                       (client)",
"  netadmin allow <hex|path>                     (server)",
"  netadmin name <hex|path> <hostname>           (server)",
"  netadmin revoke <hex>",
"  netadmin chain            the delegation this computer holds",
"  netadmin list",
"",
"ports",
"  netadmin encrypt <service|port>   require encryption",
"  netadmin plain <service|port>     stop requiring it",
}
textutils.pagedPrint(table.concat(lines, "\n"))
end

if cmd == "key" then
print(netkeys.toHex(netkeys.publicKey()))

elseif cmd == "role" then
if args[2] ~= "server" and args[2] ~= "client" and args[2] ~= "both" then
printError("role must be 'server', 'client' or 'both'")
print("'both' is a sub-server: it admits its own subnet and is")
print("itself a client of its parent")
return
end
netkeys.setRole(args[2])
print("role set to " .. args[2])

elseif cmd == "hostname" then
if not args[2] then
print("hostname: " .. (netkeys.hostname() or "(unset)"))
return
end
local ok, reason = pcall(netkeys.setHostname, args[2])
if not ok then
printError(tostring(reason))
return
end
print("hostname set to " .. args[2])
print("re-export so the server sees it: netadmin export")

elseif cmd == "substrate" then
if args[2] ~= "rednet" and args[2] ~= "hopnet" then
printError("substrate must be 'rednet' or 'hopnet'")
print("current: " .. netkeys.substrate())
return
end
netkeys.setSubstrate(args[2])
print("substrate set to " .. args[2])
print("restart netstart for it to take effect")

elseif cmd == "encrypt" or cmd == "plain" then


local target = args[2] or ""
local port = tonumber(target)
if not port then
local ok, net = pcall(require, "net")
port = ok and net.port(target) or nil
end
if not port then
printError(("expected a port number or a known service, got '%s'"):format(target))
return
end
netkeys.setPortEncrypted(port, cmd == "encrypt")
if cmd == "encrypt" then
print(("port %d now requires encryption"):format(port))
print("plaintext arriving on it will be refused")
else
print(("port %d no longer requires encryption"):format(port))
end
print("restart netstart for it to take effect")

elseif cmd == "chain" then
local chain = netkeys.chain()
local network, prefix = netkeys.authority()

print("grant: " .. ip.formatCidr(network, prefix))
if #chain == 0 then
print("no certificates -- this computer is the root authority")
return
end



for i, cert in ipairs(chain) do
local fields = netkeys.parseCert(cert)
if fields then
print(("%d. %-18s %s"):format(i,
ip.formatCidr(fields.network, fields.prefix),
fields.name ~= "" and fields.name or "(unnamed)"))
print(("   signs with %s..."):format(
netkeys.toHex(fields.signer):sub(1, 16)))
end
end

elseif cmd == "ip" then


local ipnet = require("ipnet")

print("link-local: " .. ip.format(ip.linkLocal(os.getComputerID())))

local ifaces = ipnet.interfaces()
if #ifaces == 0 then
print("address:    (none -- run netstart, or declare one with 'iface')")
else
for _, iface in ipairs(ifaces) do
print(("address:    %s  %s"):format(
ip.formatCidr(iface.address, iface.prefix), iface.modem or "(all modems)"))
end
end

local gateway = ipnet.gateway()
print("gateway:    " .. (gateway and ip.format(gateway) or "(none)"))

local routes = ipnet.routes()
if #routes > 0 then
print()
print("routes:")
for _, route in ipairs(routes) do
print(("  %-18s via %s"):format(
ip.formatCidr(route.network, route.prefix), ip.format(route.via)))
end
end

print()
print("declared in /net/interfaces:")
local declared = netkeys.interfaces()
if #declared == 0 then
print("  (none -- this computer takes what the server assigns)")
end
for _, iface in ipairs(declared) do
print(("  %s %s"):format(
ip.formatCidr(iface.address, iface.prefix), iface.modem or ""))
end

elseif cmd == "iface" then
if not args[2] then
local declared = netkeys.interfaces()
if #declared == 0 then print("no interfaces declared") end
for _, iface in ipairs(declared) do
print(("%s %s"):format(
ip.formatCidr(iface.address, iface.prefix), iface.modem or ""))
end
return
end

if args[2] == "del" then
local addr = ip.parse(args[3] or "")
if not addr then
printError("expected an address to remove")
return
end
if netkeys.removeInterface(addr) then
print("removed " .. ip.format(addr))
else
printError("no interface at " .. ip.format(addr))
end
return
end

local addr, prefix = ip.parseCidr(args[2])
if not addr then
printError(tostring(prefix))
print("expected something like 10.0.1.1/24")
return
end

local modem = args[3]
if modem and peripheral.getType(modem) ~= "modem" then
printError(("'%s' is not a modem on this computer"):format(modem))
return
end

netkeys.addInterface(addr, prefix, modem)
print(("interface %s on %s"):format(
ip.formatCidr(addr, prefix), modem or "every modem"))
print("restart netstart for it to take effect")

elseif cmd == "subnet" then
if not args[2] then
for _, subnet in ipairs(netkeys.subnets()) do
print(("%-18s %s"):format(ip.formatCidr(subnet.network, subnet.prefix),
subnet.via and ("via " .. ip.format(subnet.via)) or "(ours)"))
end
return
end

if args[2] == "del" then
local network, prefix = ip.parseCidr(args[3] or "")
if not network then
printError("expected a subnet to remove, like 10.0.1.0/24")
return
end
if netkeys.removeSubnet(network, prefix) then
print("removed " .. ip.formatCidr(ip.network(network, prefix), prefix))
else
printError("no such subnet")
end
return
end

local network, prefix = ip.parseCidr(args[2])
if not network then
printError(tostring(prefix))
print("expected something like 10.0.1.0/24")
return
end



local via = nil
if args[3] == "via" then
via = ip.parse(args[4] or "")
if not via then
printError("expected an address after 'via'")
return
end
end



local delegated = nil
for i = 3, #args - 2 do
if args[i] == "band" then
local parsed, bandErr = band.parse(args[i + 1], args[i + 2])
if not parsed then
printError(tostring(bandErr))
return
end
delegated = parsed
end
end






if delegated then
local own = netkeys.band()
if not band.contains(own, delegated) then
printError(("band %s is outside our own %s"):format(
band.format(delegated), band.format(own)))
print("set this computer's band first: netadmin band <base> <size>")
return
end
end

netkeys.setSubnet(network, prefix, via, delegated)
print(("subnet %s %s"):format(
ip.formatCidr(ip.network(network, prefix), prefix),
via and ("via " .. ip.format(via)) or "served here"))
if delegated then print("  band " .. band.format(delegated)) end
print("clients pick up new routes on their next handshake")

elseif cmd == "band" then
if not args[2] then
local own = netkeys.band()
print("this computer serves: " .. band.format(own))
print(("valid range is %d..%d"):format(band.FLOOR, band.CEILING))
print("below " .. band.FLOOR .. " is fixed-channel space (computer ids)")
for _, subnet in ipairs(netkeys.subnets()) do
if subnet.band then
print(("  %-18s %s"):format(
ip.formatCidr(subnet.network, subnet.prefix),
band.format(subnet.band)))
end
end
return
end

if args[2] == "del" then
netkeys.setBand(nil)
print("band cleared -- links derive over the whole channel space again")
return
end

local parsed, bandErr = band.parse(args[2], args[3])
if not parsed then
printError(tostring(bandErr))
print("usage: netadmin band <base> <size>")
print(("  root is normally %d %d"):format(band.ROOT.base, band.ROOT.size))
return
end

netkeys.setBand(parsed)
print("band " .. band.format(parsed))
print("restart netstart for it to take effect")

elseif cmd == "address" then
local hex, keyErr = resolveKey(args[2])
if not hex then
printError(tostring(keyErr))
return
end

local addr = ip.parse(args[3] or "")
if not addr then
printError("expected an address, like 10.0.0.7")
return
end

netkeys.setAddress(hex, addr)
print(("%s... pinned to %s"):format(hex:sub(1, 16), ip.format(addr)))
print("it takes effect on that computer's next handshake")

elseif cmd == "export" then
local target = args[2] or findDisk()
if not target then
printError("no disk found -- give a path, or insert a floppy")
return
end


local path = target
if fs.exists(target) and fs.isDir(target) then
path = fs.combine(target, ("key-%d.hex"):format(os.getComputerID()))
end

local out = {"exchange " .. netkeys.toHex(netkeys.publicKey())}




if netkeys.isServer() then
out[#out + 1] = "sign " .. netkeys.toHex(netkeys.signingKey())
end





local anchor = netkeys.signerKey()
if anchor then out[#out + 1] = "root " .. netkeys.toHex(anchor) end


local hostname = netkeys.hostname()
if hostname then out[#out + 1] = "name " .. hostname end

local f = fs.open(path, "w")
if not f then
printError("could not write " .. path)
return
end
f.write(table.concat(out, "\n"))
f.close()

print("public keys written to " .. path)
for _, line in ipairs(out) do print("  " .. line:sub(1, 24) .. "...") end
print("all public data -- no secret ever leaves this computer")

elseif cmd == "pin" then
local keys, err
local arg = args[2] or ""
local trimmed = arg:gsub("%s", "")

if #trimmed == 64 and not trimmed:find("%X") then
keys = {exchange = trimmed}
elseif fs.exists(arg) and not fs.isDir(arg) then
keys, err = parseKeyFile(arg)
else
err = ("no such file: %s (and it is not a 64-character key)"):format(arg)
end

if not keys then
printError(tostring(err))
return
end

netkeys.setServerKey(keys.exchange)
print("exchange key pinned: " .. keys.exchange:sub(1, 16) .. "...")






local anchor = keys.root or keys.sign
if anchor then
netkeys.setSignerKey(anchor)
print("trust anchor pinned: " .. anchor:sub(1, 16) .. "...")
if keys.root and keys.sign and keys.root ~= keys.sign then
print("(that server is itself a delegate of this anchor)")
end
else
printError("no signer key in that file -- peer sessions will not work")
print("re-export from the server once its role is set")
end

print("a server without the matching private keys can no longer")
print("complete a handshake with this computer")

elseif cmd == "allow" then
local target = args[2]





local function admit(hex, proposed, source)
netkeys.allow(hex)
print(("allowed %s...%s"):format(hex:sub(1, 16), source and "  (" .. source .. ")" or ""))

if not proposed then return end

local assigned, reason = netkeys.assignName(hex, proposed)
if not assigned then
printError("  " .. tostring(reason))
print("  admitted anyway; assign a name with 'netadmin name'")
elseif assigned ~= proposed then


print(("  named '%s'  (asked for '%s')"):format(assigned, proposed))
else
print(("  named '%s'"):format(assigned))
end
end


if type(target) == "string" and fs.exists(target) and fs.isDir(target) then
local count = 0
for _, file in ipairs(fs.list(target)) do
if file:match("%.hex$") then
local keys, err = parseKeyFile(fs.combine(target, file))
if keys then
admit(keys.exchange, keys.name, file)
count = count + 1
else
printError(tostring(err))
end
end
end
if count == 0 then printError("no .hex key files in " .. target) end
return
end


local override = args[3]
local proposed = override

if not override and fs.exists(target or "") and not fs.isDir(target) then
local keys = parseKeyFile(target)
proposed = keys and keys.name or nil
end

local hex, err = resolveKey(target)
if not hex then
printError(tostring(err))
return
end
admit(hex, proposed)

elseif cmd == "name" then
local hex, err = resolveKey(args[2])
if not hex then
printError(tostring(err))
return
end
local ok, reason = pcall(netkeys.setName, hex, args[3] or "")
if not ok then
printError(tostring(reason))
return
end
print(("%s... is now '%s'"):format(hex:sub(1, 16), args[3]))
print("restart the server for it to appear in new vouchers")

elseif cmd == "revoke" then
local hex, err = resolveKey(args[2])
if not hex then
printError(tostring(err))
return
end
netkeys.revoke(hex)
print("revoked " .. hex:sub(1, 16) .. "...")

elseif cmd == "list" then
print("role:    " .. tostring(netkeys.role()))
print("subst:   " .. netkeys.substrate())

local ports = {}
for port in pairs(netkeys.encryptedPorts()) do ports[#ports + 1] = port end
table.sort(ports)
print("crypt:   " .. (#ports > 0 and table.concat(ports, " ") or "no ports"))
print("our key: " .. netkeys.toHex(netkeys.publicKey()))

if netkeys.isServer() then
print("signer:  " .. netkeys.toHex(netkeys.signingKey()))

local network, prefix = netkeys.authority()
local chain = netkeys.chain()
print(("grant:   %s%s"):format(ip.formatCidr(network, prefix),
#chain == 0 and "   (root -- nothing above us)" or ""))
end

local pinned = netkeys.serverKey()
print("pinned:  " .. (pinned and netkeys.toHex(pinned) or "none"))

local signer = netkeys.signerKey()
print("verify:  " .. (signer and netkeys.toHex(signer) or "none"))

print()
print("allowlist:")
local any = false
for hex in pairs(netkeys.allowed()) do
print("  " .. hex)
any = true
end
if not any then print("  (empty)") end

print()
print("subnets:")
for _, subnet in ipairs(netkeys.subnets()) do
print(("  %-18s %s"):format(ip.formatCidr(subnet.network, subnet.prefix),
subnet.via and ("via " .. ip.format(subnet.via)) or "(ours)"))
end

print()
print("addresses:")
any = false
local names = netkeys.names()
for hex, addr in pairs(netkeys.addresses()) do
print(("  %-15s %-16s %s..."):format(
ip.format(addr), names[hex] or "(unnamed)", hex:sub(1, 16)))
any = true
end
if not any then print("  (none assigned)") end

else
usage()
end
