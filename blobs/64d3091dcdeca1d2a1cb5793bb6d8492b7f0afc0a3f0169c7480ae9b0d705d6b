say(("disk: %d bytes, %d used, %d free (%d%% used)"):format(capacity,
capacity - free, free, math.floor((capacity - free) * 100 / capacity)))
else
say(("disk: %d bytes free"):format(free))
end
local top = listed("")
local files, other = 0, 0
for _, row in ipairs(top) do
if row.dir then
say(("  %8d  %s/"):format(row.bytes, row.path))
else
files, other = files + 1, other + row.bytes
end
end
say(("  %8d  %d files at the top level"):format(other, files))

if fs.isDir("/boot") then
say("/boot, the boot record and the previous generation:")
for _, row in ipairs(listed("boot")) do
say(("  %8d  %s%s"):format(row.bytes, row.path, row.dir and "/" or ""))
end
end
if fs.isDir("/mfg/state") then
say("/mfg/state, the controller's own data:")
for i, row in ipairs(listed("mfg/state")) do
if i > 12 then say("  ...") break end
say(("  %8d  %s"):format(row.bytes, row.path))
end
end
cli.paged(lines)

