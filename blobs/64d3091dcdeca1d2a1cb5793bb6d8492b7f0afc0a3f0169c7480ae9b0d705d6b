local function size(path)
if not fs.isDir(path) then return fs.getSize(path) end
local total = 0
for _, name in ipairs(fs.list(path)) do total = total + size(fs.combine(path, name)) end
return total
end
local function listed(dir)
local rows = {}
for _, name in ipairs(fs.list(dir)) do
local path = fs.combine(dir, name)

if fs.getDrive(path) == fs.getDrive("/") then
rows[#rows + 1] = {path = "/" .. path, bytes = size(path),
dir = fs.isDir(path)}
end
end
table.sort(rows, function(a, b) return a.bytes > b.bytes end)
return rows
end


