local m = fields.machines[1]
local lines = {("%s  made from %s rev %s  %s, %s"):format(m.machine, m.script,
tostring(m.rev), m.state, m.enabled and "enabled" or "disabled")}
if m.device then lines[#lines + 1] = "inventory: " .. m.device end
local chestPorts = {}
for port in pairs(m.chests or {}) do chestPorts[#chestPorts + 1] = port end
table.sort(chestPorts)
for _, port in ipairs(chestPorts) do
lines[#lines + 1] = ("chest: %s <- %s"):format(port, m.chests[port])
end
if m.limit then
lines[#lines + 1] = ("limit: pauses at %d %s, resumes below %d%s"):format(
m.limit.at, m.limit.item, m.limit.resume,
m.state == "paused" and m.pausedBy and ("  (paused: " .. m.pausedBy .. ")")
or "")
end
if m.lastError then lines[#lines + 1] = "last error: " .. m.lastError end
for _, run in ipairs(m.runs or {}) do
lines[#lines + 1] = ("  %s  %-24s %s%s"):format(
os.date("%H:%M:%S", math.floor(run.at / 1000)), run.handler,
run.status, run.reason and (": " .. run.reason) or "")
end
lines[#lines + 1] = ""
lines[#lines + 1] = m.source or ""
cli.paged(lines)

else
printError("usage: mfgctl machine enable|disable|forget|show <machine> | limit "
.. "<machine> <item> <at> [resume <n>] | machines")
end
