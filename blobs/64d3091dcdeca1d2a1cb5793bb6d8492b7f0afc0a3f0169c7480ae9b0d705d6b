local function operatorInvoke(name, params)
local actions = require("mfg.common.actions")
if not actions.get or not actions.get(name) then actions.load("controller") end
return actions.invoke(name, params, {by = "mfgctl", operator = "console"})
end




local function scriptFile(path)
if not path or not fs.exists(shell.resolve(path)) then
printError("no such file: " .. tostring(path))
return nil
end
local handle = fs.open(shell.resolve(path), "r")
local text = handle.readAll()
handle.close()
return text
end


local function problems(list, label, toError)
for _, p in ipairs(list or {}) do
local line = ("  %s line %s:%s  %s"):format(label, tostring(p.line),
tostring(p.col), p.message)
if toError then printError(line) else print(line) end
end
end


local function footprint(f)
if not f then return end
local function list(name, values)
if values and #values > 0 then
print(("  %-9s %s"):format(name, table.concat(values, ", ")))
end
end
list("supplies", f.supplies)
list("writes", f.writes)
list("collects", f.collects)
list("drives", f.drives)
end


local function loadScript(path)
local source = scriptFile(path)
if not source then return nil end
local status, fields = operatorInvoke("register_script", {source = source})
if status ~= "completed" then
problems(fields and fields.errors, "error", true)
if not (fields and fields.errors) then printError(tostring(fields and fields.reason)) end
return nil
end
problems(fields.warnings, "warning")
print(("script %s, revision %d%s"):format(fields.script, fields.rev,
#fields.machines > 0 and ("; followed by " .. table.concat(fields.machines, ", "))
or ""))
for machine, why in pairs(fields.problems or {}) do
printError(("  %s could not be refitted: %s"):format(machine, tostring(why)))
end
return fields.script
end







local function bindScriptAll(args)
local file, kind, group = args[3], args[5], args[6]
if not file or not kind then
printError("usage: mfgctl bind --script <file> --all <kind> [/<group>]")
return
end
local script = loadScript(file)
if not script then return end
group = group and group:gsub("^/", "") or script
local status, fields = operatorInvoke("add_machines", {script = script,
group = group, kind = kind})
if status ~= "completed" then printError(tostring(fields and fields.reason)) return end
print(("made %d from %s under /%s:"):format(#fields.made, script, group))
for _, name in ipairs(fields.made) do print("  " .. name) end
for _, why in ipairs(fields.failed or {}) do printError("  not made: " .. why) end
print("their signals and chest ports, if any: bind them in the HMI's Bind app")
end

local function bindScript(args)
if args[4] == "--all" then return bindScriptAll(args) end
local usageLine = "usage: mfgctl bind --script <file> /<machine> [<inventory>] "
.. "[<port>=<chest>...]"
local file, path = args[3], args[4]
if not file or not path or path:sub(1, 1) ~= "/" then
printError(usageLine)
return
end
local device, chests = nil, nil
for i = 5, #args do
local port, chest = args[i]:match("^([^=]+)=(.+)$")
if port then
chests = chests or {}
chests[port] = chest
elseif device then
printError(("one inventory only: %s and %s -- a chest is <port>=<chest>")
:format(device, args[i]))
return
else
device = args[i]
end
end
local script = loadScript(file)
if not script then return end
local machine = path:sub(2)
local status, fields = operatorInvoke("add_machine", {machine = machine,
script = script, device = device, chests = chests})
if status ~= "completed" then printError(tostring(fields and fields.reason)) return end
print(("machine %s, made from %s"):format(path, script))
for _, bound in ipairs(fields.bound or {}) do
local port = bound:match("[^/]+$")
print("  bound " .. bound .. ((chests and chests[port]) and " (interface chest)" or ""))
end
if fields.unbound and #fields.unbound > 0 then
print("still to bind:")
for _, port in ipairs(fields.unbound) do
print(("  mfgctl bind %s <device> ..."):format(port))
end
end
print(("then: mfgctl machine enable %s"):format(machine))
end




local function bindNew(path)
local hal = require("mfg.common.hal")
local binder = require("mfg.controller.binder")
if not path or path == "--new" then
printError("usage: mfgctl bind <path> --new")
return
end
local t, why = binder.target(path)
if not t then printError(tostring(why)) return end
local before = hal.peripherals().list()
print("Turn on the modem of the ONE block to bind (right-click it).")
print("If it is already on: hold Ctrl+T, turn the modem off, and start again.")
local added, deadline = {}, os.clock() + binder.WAIT
while os.clock() < deadline do
sleep(1)
added = {}
for name in pairs(hal.peripherals().list()) do
if not before[name] then added[#added + 1] = name end
end
if #added > 0 then sleep(1) break end
end
added = {}
for name in pairs(hal.peripherals().list()) do
if not before[name] then added[#added + 1] = name end
end
table.sort(added)
if #added == 0 then
printError(("nothing was added in %d seconds"):format(binder.WAIT))
return
elseif #added > 1 then
printError(("%d devices were added: %s"):format(#added, table.concat(added, ", ")))
print("turn on one modem at a time, and make sure each modem touches only one block")
return
end
local device = added[1]
local ok, bad = binder.fits(t, device)
if not ok then printError(tostring(bad)) return end
if not cli.confirm(("bind %s, %s, as %s?"):format(device, (binder.describe(device)),
path)) then
print("nothing bound")
return
end
local face = nil
if t.kind == "signal" then
local rs = hal.redstone()
local levels = {}
for f in pairs(require("mfg.storage.mount").FACES) do
levels[f] = rs.getAnalogInput(device, f)
end
print("Now flip a lever or press a button on the wire into it.")
deadline = os.clock() + binder.WAIT
while not face and os.clock() < deadline do
sleep(0.5)
for f, level in pairs(levels) do
if rs.getAnalogInput(device, f) ~= level then face = f break end
end
end
if not face then printError("no face changed -- nothing bound") return end
end
local bound, where = binder.bindDevice(path, device, face, "mfgctl")
if not bound then printError(tostring(where)) return end
print(("bound %s -> %s%s"):format(type(where) == "string" and where or path, device,
face and (" " .. face) or ""))
end

