local args = {...}
local ROUNDS = tonumber(args[1]) or 40

local function ms()
return os.epoch("utc")
end

local function stat(samples)
if #samples == 0 then return 0, 0, 0 end
local total, worst = 0, 0
for _, v in ipairs(samples) do
total = total + v
if v > worst then worst = v end
end
table.sort(samples)
return total / #samples, samples[math.ceil(#samples / 2)], worst
end

local function report(label, samples, unit, note)
local mean, median, worst = stat(samples)
print(("  %-26s %6.1f %6.1f %6.1f %s"):format(label, mean, median, worst,
unit or "ms"))
if note then print("      " .. note) end
end

print("perfcheck -- mean / median / worst")
