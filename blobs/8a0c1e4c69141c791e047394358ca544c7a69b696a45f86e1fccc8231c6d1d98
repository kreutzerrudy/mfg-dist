local function lookEntries(view)
local look = view.look
local out = {}
local function add(text, act, value)
out[#out + 1] = {label = text, value = value or text, act = act}
end
if look.inventory then
add(("Slots: %d   (watch them)"):format(look.inventory.size or 0),
{kind = "watch-add", method = "list", label = "the slots"}, "slots")
for _, slot in ipairs(look.inventory.slots or {}) do
local holds = slot.item and ("%s x%d"):format(itemWords(slot.item),
slot.count or 0) or "empty"
add(("  %d  %s%s"):format(slot.slot, holds,
slot.limit and ("   limit %d"):format(slot.limit) or ""),
{kind = "method", method = "getItemDetail", args = {tostring(slot.slot)}},
"slot " .. slot.slot .. " " .. (slot.item or ""))
end
end
if look.tanks then
add("Tanks   (watch them)", {kind = "watch-add", method = "tanks",
label = "the tanks"}, "tanks")
for i, tank in pairs(look.tanks) do
if type(tank) == "table" then
add(("  %s  %s %s"):format(tostring(i), itemWords(tank.name or "empty"),
tostring(tank.amount or 0)), nil, "tank " .. tostring(tank.name))
end
end
end
if look.energy then
add(("Energy  %s / %s   (watch it)"):format(tostring(look.energy.stored),
tostring(look.energy.capacity)), {kind = "watch-add", method = "getEnergy",
label = "energy"}, "energy")
end
if look.faces then
add("Faces   in / out", nil, "faces")
local faces = {}
for face in pairs(look.faces) do faces[#faces + 1] = face end
table.sort(faces)
for _, face in ipairs(faces) do
local f = look.faces[face]
add(("  %-6s in %s  out %s"):format(face, tostring(f.input or "-"),
tostring(f.output or "-")),
{kind = "method", method = "getAnalogInput", args = {face}}, "face " .. face)
end
end
add(("Reads, by name (a guess): %d"):format(#(look.reads or {})), nil, "reads")
for _, reading in ipairs(look.readings or {}) do
local act = {kind = "method", method = reading.method}
local text
if reading.ok then
text = ("  %s = %s"):format(reading.method, briefResult(reading))
elseif reading.hint then
local expects = reading.hint.expects
text = expects and ("  %s  needs: %s"):format(reading.method,
tostring(reading.hint.text):match("the (.+)$") or expects)
or ("  %s  %s"):format(reading.method, reading.hint.text)
act.expects = expects or true
else
text = ("  %s  error: %s"):format(reading.method, tostring(reading.error))
end
add(text, act, reading.method)
end
for _, method in ipairs(look.reads or {}) do
local shown = false
for _, reading in ipairs(look.readings or {}) do
if reading.method == method then shown = true end
end
local surface = ({size = true, list = true, tanks = true, getEnergy = true,
getEnergyCapacity = true})[method]
if not shown and surface then
add(("  %s   (above)"):format(method), {kind = "method", method = method}, method)
end
end
if #(look.rest or {}) > 0 then
add(("  read the rest (%d)"):format(#look.rest), {kind = "rest"}, "rest")
end
add(("Others, may change it: %d"):format(#(look.others or {})), nil, "others")
for _, method in ipairs(look.others or {}) do
add("  " .. method, {kind = "method", method = method}, method)
end
return out
end

