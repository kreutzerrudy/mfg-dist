local KEEP_WRAPPED = app.KEEP_STATUS - 200

local function wrapped(buttons, width, name)
local rows, row, used = {}, {doc.gap(1)}, 1
for _, button in ipairs(buttons) do
local cells = #button.label + 2
if used > 1 and used + 1 + cells > width then
rows[#rows + 1] = doc.row(row, {keep = KEEP_WRAPPED, name = name .. #rows})
row, used = {doc.gap(1)}, 1
end
if used > 1 then
row[#row + 1] = doc.gap(1)
used = used + 1
end
row[#row + 1] = button
used = used + cells
end
rows[#rows + 1] = doc.row(row, {keep = KEEP_WRAPPED, name = name .. #rows})
return rows
end

local function tryScreen(view, width, height)
local try = view.try
local size = view.look and view.look.inventory and view.look.inventory.size or 0
local rows = {app.header(view, "TEST"), backRow(view, "Try items: " .. label(view))}
local names = try.names or {}
local chosen = try.item and (names[try.item] and names[try.item].name
or itemWords(try.item)) or "pick one below"
rows[#rows + 1] = doc.row({
doc.text(" Item ", {colour = "label", truncate = doc.TRUNCATED, keep = doc.REQUIRED, name = "item-label"}),
doc.text(chosen, {colour = try.item and "title" or "dim", width = "fill",
truncate = doc.TRUNCATED, keep = doc.REQUIRED, name = "item"}),
}, {keep = doc.REQUIRED, name = "item-row"})


local slotLabel = doc.text(" Slot", {colour = "label", truncate = doc.TRUNCATED, keep = doc.REQUIRED,
name = "slot-label"})
if size <= test.SLOT_BUTTONS then
local buttons = {doc.button("any", {colour = try.slot == nil and "selected"
or "action", action = {kind = "slot"}, keep = doc.REQUIRED, name = "slot:any"})}
for slot = 1, size do
buttons[#buttons + 1] = doc.button(tostring(slot), {colour = try.slot == slot
and "selected" or "action", action = {kind = "slot", slot = slot},
keep = doc.REQUIRED, name = "slot:" .. slot})
end
rows[#rows + 1] = doc.row({slotLabel}, {keep = doc.REQUIRED, name = "slot-head"})
for _, row in ipairs(wrapped(buttons, width, "slots")) do rows[#rows + 1] = row end
else
rows[#rows + 1] = doc.row({slotLabel, doc.gap(1),
doc.button("-", {action = {kind = "slot-step", n = -1}, keep = doc.REQUIRED,
name = "slot-less"}),
doc.text((" %s "):format(try.slot and tostring(try.slot) or "any"),
{colour = "title", keep = doc.REQUIRED, name = "slot-value"}),
doc.button("+", {action = {kind = "slot-step", n = 1}, keep = doc.REQUIRED,
name = "slot-more"}),
doc.gap(1),
doc.button("any", {colour = try.slot == nil and "selected" or "action",
action = {kind = "slot"}, keep = doc.REQUIRED, name = "slot:any"}),
}, {keep = doc.REQUIRED, name = "slot-row"})
end
rows[#rows + 1] = app.quantityRow(try.count, true, "Count", 1)
local busy = view.sending ~= nil
rows[#rows + 1] = doc.row({doc.gap(1),
doc.button("Put", {colour = (try.item and not busy) and "good" or "dim",
action = {kind = "put"}, keep = doc.REQUIRED, name = "put"}),
doc.gap(1),
doc.button("Take back", {colour = busy and "dim" or "action",
action = {kind = "take"}, keep = doc.REQUIRED, name = "take"}),
doc.spacer(),
doc.text(busy and "moving.. " or "", {colour = "dim", keep = 2, name = "moving"}),
}, {keep = doc.REQUIRED, name = "try-actions"})
local said = saidRow(view)
if said then rows[#rows + 1] = said end


local parts = {}
for slot = 1, size do
local stack = try.slots and try.slots[slot]
if type(stack) == "table" then
parts[#parts + 1] = ("%d: %s x%d"):format(slot, itemWords(stack.name),
stack.count or 0)
end
end
rows[#rows + 1] = doc.text(" Now  " .. (try.slots and (#parts > 0
and table.concat(parts, "  ") or "empty") or ".."), {colour = "text", wrap = true,
keep = 650, name = "now"})

local entries = {}
for item, record in pairs(try.items or {}) do
local free = type(record) == "table" and record.free or 0
if free > 0 then
local known = names[item]
entries[#entries + 1] = {value = item, label = known and known.name
or itemWords(item), note = tostring(free), selected = try.item == item,
chip = app.chipFor(item), act = {kind = "item", item = item}}
end
end
table.sort(entries, function(a, b) return a.label:lower() < b.label:lower() end)
listing(view, rows, view.itemList, entries, "item", height,
try.items and " nothing in the pool is free" or " reading the pool..")
rows[#rows + 1] = doc.spacer()
return rows
end

function test.document(view, width, height)
local rows
local screen = view.screen
if screen == "find" then
rows = findScreen(view)
elseif screen == "look" and view.device then
rows = lookScreen(view, width, height)
elseif screen == "call" and view.call then
rows = callScreen(view, width, height)
elseif screen == "result" and view.result then
rows = resultScreen(view, width, height)
elseif screen == "history" and view.device then
rows = historyScreen(view, width, height)
elseif screen == "watch" and view.device then
rows = watchScreen(view, width, height)
elseif screen == "try" and view.try then
rows = tryScreen(view, width, height)
else
view.screen = "list"
rows = listScreen(view, width, height)
end
return doc.stack(rows, {name = "test"})
end

return test
