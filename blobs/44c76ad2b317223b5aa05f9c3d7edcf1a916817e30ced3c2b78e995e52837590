local NETWORK_REREAD = 1000

local function networkListing(device)
local now = os.epoch("utc")
local memo = netReads[device]
if memo and now - memo.at < NETWORK_REREAD then return memo.items end
local items, err = hal.network().list(device)
netReads[device] = items and {at = now, items = items} or nil
return items, err
end

local function networkMoved(device) netReads[device] = nil end





local function surveyNetwork(path, record)
local out = {
path = path, record = record, devices = {}, missing = {}, listings = {},
sizes = {}, manifest = {}, sample = {}, freeSlots = 0, only = {},
networks = {},
}
local device = record.devices[1]
local net = hal.network()
local items = net.isPresent(device) and networkListing(device) or nil
if not items then
out.missing[1] = device
return out
end
out.devices[1] = device

local paired = variants()
local stock, stored = {}, 0
for _, item in ipairs(items) do
local key = item.name
if item.hasNbt then
key = paired[item.fingerprint] or (item.name .. "@" .. item.fingerprint)
end
if stock[key] then
stock[key].count = stock[key].count + item.count
else
stock[key] = {count = item.count, fingerprint = item.fingerprint}
end
out.manifest[key] = (out.manifest[key] or 0) + item.count
stored = stored + item.count
local known = attrs[key]
if not known then
attrs[key] = {tags = item.tags or {}, displayName = item.displayName}
elseif not known.tags then
known.tags = item.tags or {}
end
end
out.networks[device] = {system = record.system, stock = stock, stored = stored}
return out
end





store.PLAYER_FIRST, store.PLAYER_LAST = 9, 35



function store.isPocket(item)
return type(item) == "string" and item:find("^computercraft:pocket_computer") ~= nil
end





local function canonical(value, out)
local kind = type(value)
if kind == "table" then
local keys = {}
for k in pairs(value) do keys[#keys + 1] = k end
table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
out[#out + 1] = "{"
for _, k in ipairs(keys) do
out[#out + 1] = tostring(k) .. "="
canonical(value[k], out)
out[#out + 1] = ";"
end
out[#out + 1] = "}"
else
out[#out + 1] = kind:sub(1, 1) .. tostring(value)
end
return out
end



local function fnv(text, seed)
local h = seed
for i = 1, #text do
h = bit32.bxor(h, text:byte(i))
h = (h * 403 + (h % 256) * 16777216) % 4294967296
end
return h
end

function store.playerPrint(nbt)
local text = table.concat(canonical(nbt, {}))
return ("pv%08x%08x"):format(fnv(text, 2166136261), fnv(text, 84696351))
end

local function playerKey(stack)
if not stack.nbt then return stack.name end
local print = store.playerPrint(stack.nbt)
return variants()[print] or (stack.name .. "@" .. print)
end



local function surveyPlayer(path, record)
local out = {
path = path, record = record, devices = {}, missing = {}, listings = {},
sizes = {}, manifest = {}, sample = {}, freeSlots = 0, only = {},
players = {},
}
local device = record.devices[1]
local backend = hal.player()
local items = backend.isPresent(device) and backend.list(device) or nil
if not items then
out.missing[1] = device
return out
end
out.devices[1] = device
local slots, pockets, free = {}, {}, 0
for slot = store.PLAYER_FIRST, store.PLAYER_LAST do
local stack = items[slot]
if not stack then
free = free + 1
elseif store.isPocket(stack.name) then
pockets[slot] = true
else
local key = playerKey(stack)
slots[slot] = {name = stack.name, count = stack.count, key = key,
maxCount = stack.maxCount}
out.manifest[key] = (out.manifest[key] or 0) + stack.count
local known = attrs[key]
if not known then
attrs[key] = {maxCount = stack.maxCount, displayName = stack.displayName,
tags = stack.tags}
else
known.maxCount = known.maxCount or stack.maxCount
known.tags = known.tags or stack.tags
end
end
end
out.freeSlots = free
out.players[device] = {record = record, slots = slots, pockets = pockets,
buffer = record.buffer, side = record.side, owner = record.owner}
return out
end





local function surveyGroup(path)
local out = {
path = path, group = true,
record = {path = path, coherence = mount.EXCLUSIVE, devices = {}},
devices = {}, missing = {}, listings = {}, sizes = {}, manifest = {},
sample = {}, freeSlots = 0, only = {},
members = {}, memberOf = {}, holds = {}, networks = {},
}
for _, member in ipairs(mount.members(path)) do
local record = mount.get(member)
local holds = record.holds and store.selector(record.holds) or nil
out.members[#out.members + 1] = {path = member, holds = holds,
text = record.holds}
if #(record.devices or {}) > 0 then
local view = survey(member)
if view then
for _, device in ipairs(view.devices) do
out.devices[#out.devices + 1] = device
out.record.devices[#out.record.devices + 1] = device
out.memberOf[device] = member
out.holds[device] = holds
out.listings[device] = view.listings[device]
out.sizes[device] = view.sizes[device]
out.only[device] = view.only[device]
out.networks[device] = view.networks and view.networks[device]
if view.players and view.players[device] then
out.players = out.players or {}
out.players[device] = view.players[device]
end
end
for _, device in ipairs(view.missing) do out.missing[#out.missing + 1] = device end
for key, count in pairs(view.manifest) do
out.manifest[key] = (out.manifest[key] or 0) + count
if not out.sample[key] then out.sample[key] = view.sample[key] end
end
out.freeSlots = out.freeSlots + view.freeSlots
end
end
end
return out
end

survey = function(path)
local record = mount.get(path)
if not record then
if mount.isGroup(path) then return surveyGroup(path) end
return nil, "no such storage: " .. tostring(path)
end
if mount.isSignal(record) then
return nil, ("%s is a signal, not a volume"):format(path)
end
if #record.devices == 0 then
return nil, ("%s is declared but UNBOUND"):format(path)
end
if record.system == "player" then return surveyPlayer(path, record) end
if record.system then return surveyNetwork(path, record) end

local present, missing
record, present, missing = devicesOf(path, record)
local useCache = cacheable(record)

local out = {
path = path,
record = record,
devices = present,
missing = missing,
listings = {},
sizes = {},
manifest = {},
sample = {},
freeSlots = 0,
only = {},
}

for _, device in ipairs(present) do
local listing, size = listingOf(device, useCache)
if listing and record.slots then

local slots, kept = {}, {}
for _, slot in ipairs(record.slots) do
if slot <= (size or 0) then
slots[#slots + 1] = slot
kept[slot] = listing[slot]
end
end
listing, size = kept, #slots
out.only[device] = slots
end


if listing and not record.slots and marks.stale(record, device, listing, size) then
marks.observe(path, device, listing, size)
record = mount.get(path)
end


local hidden, strays = nil, nil
if listing then hidden, strays = marks.hidden(record, device, listing) end


if strays and store.onStrayPage and path ~= marks.TRAY then
pcall(store.onStrayPage, path, device, strays)
end
if hidden then
local kept, gone = {}, 0
for slot, stack in pairs(listing) do
if hidden[slot] then gone = gone + 1 else kept[slot] = stack end
end
listing, size = kept, math.max(0, (size or 0) - gone)
end
if listing then
out.listings[device] = listing
out.sizes[device] = size

local occupied = 0
for slot, stack in pairs(listing) do
occupied = occupied + 1
local key = store.key(stack.name, stack.nbt)
out.manifest[key] = (out.manifest[key] or 0) + stack.count
if not out.sample[key] then
out.sample[key] = {device = device, slot = slot}
end
end
out.freeSlots = out.freeSlots + math.max(0, (size or 0) - occupied)
end
end

return out
end






function store.manifest(path)
local view, err = survey(path)
if not view then return nil, err end
return view.manifest, (#view.missing > 0) and view.missing or nil
end






function store.stock(path)
local manifest, degraded = store.manifest(path)
if not manifest then return nil, degraded end

local totals = {}
for key, count in pairs(manifest) do
local name = store.parse(key)
totals[name] = (totals[name] or 0) + count
end
return totals, degraded
end









function store.describe(path, budget)
local view, err = survey(path)
if not view then return nil, err end
budget = budget or 8
local out = {}
for key in pairs(view.manifest) do
local known = attrs[key]
if not known and budget > 0 then
local sample = view.sample[key]
if sample then
known = learn(key, sample.device, sample.slot)
budget = budget - 1
end
end



local id, nbt = store.parse(key)
if known and (not out[id] or (nbt == nil and out[id].variant)) then
out[id] = {name = known.displayName, stack = known.maxCount,
variant = nbt ~= nil or nil}
end
end
return out
end

function store.count(path, sel)
local view, err = survey(path)
if not view then return nil, err end
if not sel then
local total = 0
for _, count in pairs(view.manifest) do total = total + count end
return total
end

local selector = store.selector(sel)
if not selector then return nil, "not a selector: " .. tostring(sel) end

local total = 0
for key, count in pairs(view.manifest) do
if satisfies(selector, key, view.sample[key]) then total = total + count end
end
return total
end

function store.freeSlots(path)
local view, err = survey(path)
if not view then return nil, err end
return view.freeSlots
end















local function playerRoom(view, selector)
local total, exact = 0, true
for _, p in pairs(view.players) do
local limit, known = ASSUMED_STACK, false
for _, held in pairs(p.slots) do
if satisfies(selector, held.key) then
limit, known = held.maxCount or limit, held.maxCount ~= nil
total = total + math.max(0, limit - held.count)
end
end
local key = exactKey(selector) or (not isTag(selector) and selector.name) or nil
if not known and key and attrs[key] and attrs[key].maxCount then
limit, known = attrs[key].maxCount, true
end
total = total + view.freeSlots * limit
exact = exact and known
end
return total, exact
end

function store.room(path, sel)
local view, err = survey(path)
if not view then return nil, err end

local selector = store.selector(sel)
if not selector then return nil, "not a selector: " .. tostring(sel) end
if view.players and next(view.players) and not view.group then
return playerRoom(view, selector)
end

local best, bestExact = nil, true
local considered = false


local function freeIn(allowed)
if not allowed then return view.freeSlots end
local free = 0
for device in pairs(allowed) do
local occupied = 0
for _ in pairs(view.listings[device] or {}) do occupied = occupied + 1 end
free = free + math.max(0, (view.sizes[device] or 0) - occupied)
end
return free
end



local function networkRoom(allowed)
local free, any = 0, false
for device, net in pairs(view.networks or {}) do
if not allowed or allowed[device] then
local capacity = hal.network().capacity(device, net.stored)
if capacity then free, any = free + capacity.free, true end
end
end
return free, any
end

for key in pairs(view.manifest) do
if satisfies(selector, key, view.sample[key]) then
considered = true
local limit, known = stackLimit(key, view.sample[key])
local allowed = allowedFor(view, key, view.sample[key])


local headroom = 0
for device, listing in pairs(view.listings) do
if not allowed or allowed[device] then
for _, stack in pairs(listing) do
if store.key(stack.name, stack.nbt) == key
and stack.count < limit then
headroom = headroom + (limit - stack.count)
end
end
end
end

local netFree, anyNet = networkRoom(allowed)
local total = headroom + freeIn(allowed) * limit + netFree
if best == nil or total > best then
best, bestExact = total, known and not anyNet
end
end
end

if considered then return best, bestExact end




local limit = ASSUMED_STACK
local exact = false
local allowed = nil
if not isTag(selector) then
local key = exactKey(selector) or selector.name
if attrs[key] and attrs[key].maxCount then
limit, exact = attrs[key].maxCount, true
end
allowed = allowedFor(view, key, nil)
end
local netFree, anyNet = networkRoom(allowed)
return freeIn(allowed) * limit + netFree, exact and not anyNet
end









function store.resolve(path, sel)
local view, err = survey(path)
if not view then return nil, err end

local selector = store.selector(sel)
if not selector then return nil, "not a selector: " .. tostring(sel) end

local best, bestCount = nil, -1
for key, count in pairs(view.manifest) do
if satisfies(selector, key, view.sample[key]) and count > bestCount then
best, bestCount = key, count
end
end

if not best then
return nil, ("nothing matching %s is in %s"):format(tostring(sel), path)
end
return best, nil
end



function store.locate(sel)
local found = {}
for _, path in ipairs(mount.volumes()) do
if mount.isBound(path) then
local n = store.count(path, sel)
if n and n > 0 then
found[#found + 1] = {path = path, count = n}
end
end
end
table.sort(found, function(a, b) return a.count > b.count end)
return found
end

function store.status(path)
local record = mount.get(path)
if not record and mount.isGroup(path) then

local out = {path = path, coherence = mount.EXCLUSIVE, bound = false,
devices = {}, missing = {}, degraded = false, group = true,
members = mount.members(path)}
for _, member in ipairs(out.members) do
local sub = store.status(member)
if sub and sub.bound then out.bound = true end
for _, d in ipairs(sub and sub.devices or {}) do out.devices[#out.devices + 1] = d end
for _, d in ipairs(sub and sub.missing or {}) do out.missing[#out.missing + 1] = d end
end
out.degraded = #out.missing > 0
return out
end
if not record then return nil, "no such storage: " .. tostring(path) end

local present, missing
if #record.devices > 0 then
record, present, missing = devicesOf(path, record)
else
present, missing = mount.devices(path)
end
return {
path = path,
node = record.node,
role = record.role,
coherence = record.coherence,
bound = #record.devices > 0,
devices = present or {},
missing = missing or {},
degraded = (missing and #missing > 0) or false,
}
end













function store.audit()
local points, degraded, unbound = {}, {}, {}

for path in pairs(mount.all()) do
points[#points + 1] = path
end
table.sort(points)

local report = {points = {}, degraded = degraded, unbound = unbound}
for _, path in ipairs(points) do
local view = store.status(path)
report.points[#report.points + 1] = view
if not view.bound then
unbound[#unbound + 1] = path
elseif view.degraded then
degraded[#degraded + 1] = {path = path, missing = view.missing}
end
end

report.ok = (#degraded == 0)
return report
end







allowedFor = function(view, key, sample)
if not view.group then return nil end
local exactStore, tagStore = nil, nil
for _, member in ipairs(view.members) do
local sel = member.holds
if sel then
local tag = isTag(sel)
if (not tag or not tagStore) and satisfies(sel, key, sample) then
if tag then tagStore = tagStore or member.path
else exactStore = exactStore or member.path end
end
end
end
local want = exactStore and "exact" or (tagStore and "tag") or "general"
local set = {}
for _, device in ipairs(view.devices) do
local sel = view.holds[device]
local class = "general"
if sel then
class = satisfies(sel, key, sample) and (isTag(sel) and "tag" or "exact")
or "other"
end
if class == want then set[device] = true end
end
return set, exactStore or tagStore
end
store.allowedFor = function(path, key)
local view = survey(path)
if not view then return nil end
return allowedFor(view, key, view.sample[key])
end








local function destinations(view, key, limit, allowed)
local holding, empty, networks = {}, {}, {}

for _, device in ipairs(view.devices) do
if (not allowed or allowed[device]) and view.networks and view.networks[device] then
networks[#networks + 1] = device
elseif not allowed or allowed[device] then
local listing = view.listings[device]
local headroom, occupied = 0, 0
for _, stack in pairs(listing or {}) do
occupied = occupied + 1
if store.key(stack.name, stack.nbt) == key and stack.count < limit then
headroom = headroom + (limit - stack.count)
end
end
local free = math.max(0, (view.sizes[device] or 0) - occupied)

if headroom > 0 then
holding[#holding + 1] = {device = device, headroom = headroom, free = free}
else
empty[#empty + 1] = {device = device, free = free}
end
end
end

table.sort(holding, function(a, b) return a.headroom > b.headroom end)
table.sort(empty, function(a, b) return a.free > b.free end)

local order = {}
for _, device in ipairs(networks) do order[#order + 1] = device end
for _, entry in ipairs(holding) do order[#order + 1] = entry.device end
for _, entry in ipairs(empty) do order[#order + 1] = entry.device end
return order
end























local function sources(view, key)
local found = {}
for device, net in pairs(view.networks or {}) do
local held = net.stock[key]
if held and held.count > 0 then
found[#found + 1] = {device = device, network = true, count = held.count,
fingerprint = held.fingerprint,
rank = ((view.holds and view.holds[device]) and 2 or 0) + 1}
end
end
for device, listing in pairs(view.listings) do
local rank = (view.holds and view.holds[device]) and 2 or 0
for slot, stack in pairs(listing) do
if store.key(stack.name, stack.nbt) == key then
found[#found + 1] = {device = device, slot = slot, count = stack.count,
rank = rank}
end
end
end
table.sort(found, function(a, b)
if a.rank ~= b.rank then return a.rank < b.rank end
return a.count < b.count
end)
return found
end











local function exportInto(dest, device, src, key, limit, remaining)
local net = hal.network()
local only = dest.only and dest.only[device]
local listing = dest.listings[device] or {}
local _, _, unpaired = store.parse(key)
local slots = only
if not slots and unpaired then
for slot = 1, dest.sizes[device] or 0 do
if not listing[slot] then slots = {slot} break end
end
if not slots then return 0, nil, 0 end
end
if not slots then
local n, err = net.export(src.device, {fingerprint = src.fingerprint,
count = remaining}, device)
networkMoved(src.device)
if n and n > 0 then src.count = src.count - n end
return n, err, 1
end

local moved, calls, lastErr = 0, 0, nil
for _, slot in ipairs(slots) do
if moved >= remaining then break end
local held = listing[slot]
if not held or (store.key(held.name, held.nbt) == key and held.count < limit) then
local n, err = net.export(src.device, {fingerprint = src.fingerprint,
count = remaining - moved, toSlot = slot}, device)
calls = calls + 1
if not n then
lastErr = err
elseif n > 0 then
moved = moved + n
local name, hash = store.parse(key)
if unpaired then
local detail = hal.inventory().detail(device, slot)
calls = calls + 1
if detail then
name, hash = detail.name, detail.nbt
if hash then pairVariant(unpaired, store.key(name, hash)) end
end
end
listing[slot] = {name = name, nbt = hash,
count = (held and held.count or 0) + n}
end
end
end
networkMoved(src.device)
src.count = src.count - moved
if moved == 0 and lastErr then return nil, lastErr, calls end
return moved, nil, math.max(calls, 1)
end

local function pushInto(dest, device, src, key, limit, remaining)
local into = dest.networks and dest.networks[device]
if src.network and into then
return nil, "can't move straight between two storage networks", 0
elseif into then

local name = store.parse(key)
local n, err = hal.network().import(device, {name = name, fromSlot = src.slot,
count = math.min(remaining, src.count or remaining)}, src.device)
networkMoved(device)
return n, err, 1
elseif src.network then
return exportInto(dest, device, src, key, limit, remaining)
end

local inv = hal.inventory()
local only = dest.only and dest.only[device]
if not only then
local n, err = inv.push(src.device, device, src.slot, remaining)
return n, err, 1
end

local listing = dest.listings[device] or {}
local moved, calls, lastErr = 0, 0, nil
local want = math.min(remaining, src.count or remaining)
for _, slot in ipairs(only) do
if moved >= want then break end
local held = listing[slot]
if not held or (store.key(held.name, held.nbt) == key and held.count < limit) then
local n, err = inv.push(src.device, device, src.slot, want - moved, slot)
calls = calls + 1
if not n then
lastErr = err
elseif n > 0 then
moved = moved + n
local name, nbt = store.parse(key)
listing[slot] = {name = name, nbt = nbt,
count = (held and held.count or 0) + n}
end
end
end
if src.count then src.count = src.count - moved end
if moved == 0 and lastErr then return nil, lastErr, calls end
return moved, nil, math.max(calls, 1)
end










local function heldNow(src, key)

if src.network then
return hal.network().count(src.device, src.fingerprint), true
end
local detail = hal.inventory().detail(src.device, src.slot)
if not detail or store.key(detail.name, detail.nbt) ~= key then return 0 end
return detail.count or 0
end

local function transfer(source, dest, from, to, sel, wanted)
if #source.devices == 0 then
return 0, ("%s has no reachable devices"):format(from)
end
if #dest.devices == 0 then
return 0, ("%s has no reachable devices"):format(to)
end

local selector = store.selector(sel)
if not selector then return 0, "not a selector: " .. tostring(sel) end




local candidates = {}
for key, count in pairs(source.manifest) do
if satisfies(selector, key, source.sample[key]) then
candidates[#candidates + 1] = {key = key, count = count}
end
end
table.sort(candidates, function(a, b) return a.count > b.count end)

local moved, calls = 0, 0
local blocked = {}
local lastErr = nil
local stale = false

for _, candidate in ipairs(candidates) do
if moved >= wanted then break end
local key = candidate.key
local limit = stackLimit(key, source.sample[key])
local allowed, storePath = allowedFor(dest, key, source.sample[key])
local order = destinations(dest, key, limit, allowed)
blocked = {}


local full = storePath and ("%s is full"):format(storePath) or nil
if #order == 0 and full then lastErr = full end

for _, src in ipairs(sources(source, key)) do
if moved >= wanted then break end

local remaining = wanted - moved
local placedAny = false
local gone = false
local left = src.count or 0

for _, device in ipairs(order) do
if remaining <= 0 then break end
if not blocked[device] then
local asked = math.min(remaining, left)
local n, err, used = pushInto(dest, device, src, key, limit,
remaining)
calls = calls + (used or 1)











if not n then
lastErr = tostring(err)
else
if n > 0 then
moved = moved + n
remaining = remaining - n
left = left - n
placedAny = true
index.consumed(src.device, src.slot, n)
index.drop(device)
end
if n < asked then
local now = heldNow(src, key)
if now < left then
stale = true
index.drop(src.device)
left = now
end
if now == 0 then
gone = true
break
end



if n == 0 then blocked[device] = true end
end
end

if calls % YIELD_EVERY == 0 then sleep(0) end
end
end

if not placedAny and not gone then

if full then break end
return moved, lastErr or ("%s is full"):format(to)
end
end
end

if moved == 0 and #candidates == 0 then
return 0, ("%s holds nothing matching %s"):format(from, tostring(sel))
end
if moved < wanted and stale then
return moved, ("%s held less %s than its listing said: %d of %d found (the "
.. "listing was out of date, and is read again)"):format(from,
tostring(sel), moved, wanted)
end
return moved, lastErr
end





local function bufferView(p)
local inv = hal.inventory()
local listing = inv.list(p.buffer) or {}
local view = {path = p.buffer, record = {coherence = mount.RELAYED, devices = {p.buffer}},
devices = {p.buffer}, missing = {}, listings = {[p.buffer] = listing},
sizes = {[p.buffer] = inv.size(p.buffer) or 0}, manifest = {}, sample = {},
freeSlots = 0, only = {}}
local used = 0
for slot, stack in pairs(listing) do
used = used + 1
local key = store.key(stack.name, stack.nbt)
view.manifest[key] = (view.manifest[key] or 0) + stack.count
view.sample[key] = view.sample[key] or {device = p.buffer, slot = slot}
end
view.freeSlots = math.max(0, view.sizes[p.buffer] - used)
return view
end



local function stuck(path, p)
if store.onBufferStuck then pcall(store.onBufferStuck, path, p.buffer) end
end

local function bufferEmpty(p)
return next(hal.inventory().list(p.buffer) or {}) == nil
end



local function slotsFor(p, key, limit, n)
local out, total = {}, 0
for slot = store.PLAYER_FIRST, store.PLAYER_LAST do
local held = p.slots[slot]
if total < n and held and held.key == key and held.count < (held.maxCount or limit) then
local room = (held.maxCount or limit) - held.count
out[#out + 1] = {slot = slot, room = room, held = held}
total = total + room
end
end
for slot = store.PLAYER_FIRST, store.PLAYER_LAST do
if total < n and not p.slots[slot] and not p.pockets[slot] then
out[#out + 1] = {slot = slot, room = limit}
total = total + limit
end
end
return out, total
end



local function intoPlayer(source, dest, from, to, selector, sel, wanted)
local device = dest.devices[1]
local p = dest.players[device]
if not p.buffer then return 0, ("%s has no buffer chest bound"):format(to) end
if not bufferEmpty(p) then
stuck(to, p)
return 0, ("%s's buffer chest isn't empty: it's sent back first"):format(to)
end
local candidates = {}
for key, count in pairs(source.manifest) do
if satisfies(selector, key, source.sample[key]) then
candidates[#candidates + 1] = {key = key, count = count}
end
end
table.sort(candidates, function(a, b) return a.count > b.count end)
if #candidates == 0 then
return 0, ("%s holds nothing matching %s"):format(from, tostring(sel))
end

local players = hal.player()
local moved, lastErr = 0, nil
for _, candidate in ipairs(candidates) do
if moved >= wanted then break end
local key = candidate.key
local name = store.parse(key)
local limit = stackLimit(key, source.sample[key])
local slots, room = slotsFor(p, key, limit, wanted - moved)
if room == 0 then lastErr = ("%s is full"):format(to) break end
local got, err = transfer(source, bufferView(p), from, p.buffer, key,
math.min(wanted - moved, room))
if got == 0 then
lastErr = err
else
local left = got
for _, place in ipairs(slots) do
if left <= 0 then break end
local given, gErr = players.give(device, p.side, math.min(left, place.room),
place.slot, name)
given = given or 0
if given > 0 then
left = left - given
moved = moved + given
if place.held then
place.held.count = place.held.count + given
else
p.slots[place.slot] = {name = name, count = given, key = key,
maxCount = limit}
end
elseif gErr then
lastErr = gErr
end
end
if left > 0 then

local back = transfer(bufferView(p), source, p.buffer, from, key, left)
if back < left then stuck(to, p) end
lastErr = lastErr or ("%s is full"):format(to)
break
end
end
end
return moved, moved < wanted and lastErr or nil
end





local function outOfPlayer(source, dest, from, to, selector, sel, wanted)
local device = source.devices[1]
local p = source.players[device]
if not p.buffer then return 0, ("%s has no buffer chest bound"):format(from) end
if not bufferEmpty(p) then
stuck(from, p)
return 0, ("%s's buffer chest isn't empty: it's sent back first"):format(from)
end
local found = {}
for slot, s in pairs(p.slots) do
if satisfies(selector, s.key, nil) then
found[#found + 1] = {slot = slot, s = s}
end
end
table.sort(found, function(a, b) return a.s.count < b.s.count end)
if #found == 0 then
return 0, ("%s holds nothing matching %s"):format(from, tostring(sel))
end

local players = hal.player()
local moved, lastErr = 0, nil
for _, entry in ipairs(found) do
if moved >= wanted then break end
local s = entry.s
local n = math.min(wanted - moved, s.count)
local taken, tErr = players.take(device, p.side, n, entry.slot, s.name)
taken = taken or 0
if taken == 0 then
lastErr = tErr
else
local buffer = bufferView(p)
local bufKey
for key in pairs(buffer.manifest) do
if store.parse(key) == s.name then bufKey = key end
end
local _, _, print = store.parse(s.key)
if print and bufKey and bufKey:find("#", 1, true) then
pairVariant(print, bufKey)
end
local put, err = transfer(buffer, dest, p.buffer, to, bufKey or s.name, taken)
moved = moved + put
s.count = s.count - put
if put < taken then
local back = players.give(device, p.side, taken - put, entry.slot, s.name) or 0
if back < taken - put then stuck(from, p) end
lastErr = err or ("%s is full"):format(to)
break
end
end
end
return moved, moved < wanted and lastErr or nil
end

function store.move(from, to, sel, wanted)
local source, sErr = survey(from)
if not source then return 0, sErr end
local dest, dErr = survey(to)
if not dest then return 0, dErr end


local function isPlayer(view)
if view.group then return view.players ~= nil and next(view.players) ~= nil end
return view.record and view.record.system == "player"
end
local intoP, outP = isPlayer(dest), isPlayer(source)
if intoP or outP then
if intoP and outP then return 0, "can't move straight between two players" end
if source.group and outP or dest.group and intoP then
return 0, "move to or from a player's inventory, not the group it's in"
end
local view = intoP and dest or source
if #view.devices == 0 then
return 0, ("%s is not online"):format(intoP and to or from)
end
local selector = store.selector(sel)
if not selector then return 0, "not a selector: " .. tostring(sel) end
if intoP then return intoPlayer(source, dest, from, to, selector, sel, wanted) end
return outOfPlayer(source, dest, from, to, selector, sel, wanted)
end
return transfer(source, dest, from, to, sel, wanted)
end








local LOADOUT_OFFSET = store.PLAYER_FIRST - 1


local function playerOf(path)
local view, err = survey(path)
if not view then return nil, err end
if not view.record or view.record.system ~= "player" then
return nil, path .. " isn't a player's inventory"
end
if #view.devices == 0 then return nil, path .. " is not online" end
local device = view.devices[1]
return view, device, view.players[device]
end


local function freeSlot(listing, size)
for slot = 1, size do if not listing[slot] then return slot end end
return nil
end




function store.unloadInventory(playerPath, chestPath)
local view, device, p = playerOf(playerPath)
if not view then return 0, device end
local chest = mount.get(chestPath)
local target = chest and chest.devices and chest.devices[1]
if not target then return 0, chestPath .. " is not bound" end
if not bufferEmpty(p) then
stuck(playerPath, p)
return 0, ("%s's buffer chest isn't empty"):format(playerPath)
end
local inv, players = hal.inventory(), hal.player()
local listing = inv.list(target) or {}
local size = inv.size(target) or 0
local moved, why = 0, nil
for slot = store.PLAYER_FIRST, store.PLAYER_LAST do
local s = p.slots[slot]
if s then
local into = slot - LOADOUT_OFFSET
if into > size or listing[into] then into = freeSlot(listing, size) end
if not into then why = chestPath .. " is full" break end
local taken = players.take(device, p.side, s.count, slot, s.name) or 0
if taken > 0 then
local put = 0
for bslot, stack in pairs(inv.list(p.buffer) or {}) do
if stack.name == s.name then
put = put + (inv.push(p.buffer, target, bslot, stack.count, into) or 0)
end
end
if put > 0 then listing[into] = {name = s.name, count = put} end
moved = moved + put
if put < taken then
local back = players.give(device, p.side, taken - put, slot, s.name) or 0
if back < taken - put then stuck(playerPath, p) end
why = why or ("%s couldn't take all of slot %d"):format(chestPath, slot)
end
end
end
end
index.drop(target)
return moved, why
end




function store.loadInventory(chestPath, playerPath)
local view, device, p = playerOf(playerPath)
if not view then return 0, device end
local chest = mount.get(chestPath)
local source = chest and chest.devices and chest.devices[1]
if not source then return 0, chestPath .. " is not bound" end
if not bufferEmpty(p) then
stuck(playerPath, p)
return 0, ("%s's buffer chest isn't empty"):format(playerPath)
end
local inv, players = hal.inventory(), hal.player()
local taken = {}
for slot in pairs(p.slots) do taken[slot] = true end
for slot in pairs(p.pockets) do taken[slot] = true end
local moved, why = 0, nil
local listing = inv.list(source) or {}
local order = {}
for slot in pairs(listing) do order[#order + 1] = slot end
table.sort(order)
for _, k in ipairs(order) do
local stack = listing[k]
local into = k + LOADOUT_OFFSET
if into > store.PLAYER_LAST or taken[into] then
into = nil
for slot = store.PLAYER_FIRST, store.PLAYER_LAST do
if not taken[slot] then into = slot break end
end
end
if not into then why = playerPath .. " is full" break end
local got = inv.push(source, p.buffer, k, stack.count) or 0
if got > 0 then
local given = players.give(device, p.side, got, into, stack.name) or 0
moved = moved + given
if given > 0 then taken[into] = true end
if given < got then
for bslot, left in pairs(inv.list(p.buffer) or {}) do
inv.push(p.buffer, source, bslot, left.count, k)
end
if not bufferEmpty(p) then stuck(playerPath, p) end
why = why or ("%s couldn't take all of it"):format(playerPath)
end
end
end
index.drop(source)
return moved, why
end




function store.returnBuffer(playerPath)
local view, device, p = playerOf(playerPath)
if not view then return 0 end
local taken = {}
for slot in pairs(p.slots) do taken[slot] = true end
for slot in pairs(p.pockets) do taken[slot] = true end
local players, moved = hal.player(), 0
for _, stack in pairs(hal.inventory().list(p.buffer) or {}) do
for slot = store.PLAYER_FIRST, store.PLAYER_LAST do
if not taken[slot] then
local given = players.give(device, p.side, stack.count, slot, stack.name) or 0
if given > 0 then taken[slot] = true moved = moved + given break end
end
end
end
if not bufferEmpty(p) then stuck(playerPath, p) end
return moved
end



function store.flushBuffer(path, to)
local record = mount.get(path)
if not record or not record.buffer then return 0 end
local p = {buffer = record.buffer}
local buffer = bufferView(p)
local dest = survey(to)
if not dest then return 0 end
local moved = 0
for key, count in pairs(buffer.manifest) do
moved = moved + (transfer(bufferView(p), dest, record.buffer, to, key, count) or 0)
end
return moved
end














function store.slots(path)
local view, err = survey(path)
if not view then return nil, err end

local total, occupied = 0, 0
local perKey = {}

for device, listing in pairs(view.listings) do
total = total + (view.sizes[device] or 0)
for _, stack in pairs(listing) do
occupied = occupied + 1
local key = store.key(stack.name, stack.nbt)
perKey[key] = (perKey[key] or 0) + 1
end
end

local keys, reclaimable = 0, 0
for _, count in pairs(perKey) do
keys = keys + 1
reclaimable = reclaimable + (count - 1)
end

return {
total = total,
used = occupied,
free = total - occupied,
keys = keys,
reclaimable = reclaimable,
degraded = #view.missing > 0,
}
end











function store.summary(path)
local record = mount.get(path)
if not record and mount.isGroup(path) then
record = {coherence = mount.EXCLUSIVE, devices = {"group"}}
end
if not record then return nil, "no such storage: " .. tostring(path) end

local out = {
path = path,
coherence = record.coherence,
node = record.node,
role = record.role,
bound = #record.devices > 0,
devices = {},
missing = {},
degraded = false,
}

if not out.bound then return out end





local view, err = survey(path)
if not view then return out, err end

out.devices = view.devices or {}
out.missing = view.missing or {}
out.degraded = #out.missing > 0



local total, occupied, items = 0, 0, 0
for _, count in pairs(view.manifest) do items = items + count end
local perKey = {}
for device, listing in pairs(view.listings) do
total = total + (view.sizes[device] or 0)
for _, stack in pairs(listing) do
occupied = occupied + 1
local key = store.key(stack.name, stack.nbt)
perKey[key] = (perKey[key] or 0) + 1
end
end

local keys, reclaimable = 0, 0
for _, count in pairs(perKey) do
keys = keys + 1
reclaimable = reclaimable + (count - 1)
end

out.manifest = view.manifest
out.items = items
out.slots = {total = total, used = occupied, free = total - occupied,
keys = keys, reclaimable = reclaimable, degraded = out.degraded}
return out
end


























function store.defrag(path, opts)
opts = opts or {}
local record = mount.get(path)
if not record and mount.isGroup(path) then


local total = {merged = 0, slotsFreed = 0, calls = 0, keys = 0}
for _, member in ipairs(mount.members(path)) do
local r = mount.isBound(member) and store.defrag(member, opts)
if r then
for k in pairs(total) do total[k] = total[k] + (r[k] or 0) end
end
end
return total
end
if not record then return nil, "no such storage: " .. tostring(path) end



if record.coherence ~= mount.EXCLUSIVE then
return nil, ("%s is %s -- only an exclusive volume may be defragmented "
.. "(S8.2)"):format(path, tostring(record.coherence))
end

local view, err = survey(path)
if not view then return nil, err end

local inv = hal.inventory()
local result = {merged = 0, slotsFreed = 0, calls = 0, keys = 0}


local byKey = {}
for device, listing in pairs(view.listings) do
for slot, stack in pairs(listing) do
local key = store.key(stack.name, stack.nbt)
byKey[key] = byKey[key] or {}
table.insert(byKey[key], {device = device, slot = slot, count = stack.count})
end
end

for key, slots in pairs(byKey) do
if #slots > 1 then
result.keys = result.keys + 1


table.sort(slots, function(a, b) return a.count < b.count end)

local lo, hi = 1, #slots
while lo < hi do
local from, to = slots[lo], slots[hi]

if from.count <= 0 then
lo = lo + 1
else
local moved = inv.push(from.device, to.device, from.slot,
from.count, to.slot)
result.calls = result.calls + 1

if not moved or moved == 0 then





hi = hi - 1
else
from.count = from.count - moved
to.count = to.count + moved
result.merged = result.merged + moved
index.consumed(from.device, from.slot, moved)
index.drop(to.device)

if from.count <= 0 then
result.slotsFreed = result.slotsFreed + 1
lo = lo + 1
end
end

if result.calls % YIELD_EVERY == 0 then sleep(0) end
end
end
end
end

return result
end


function store.drain(from, to)
local manifest, err = store.manifest(from)
if not manifest then return nil, err end

local drained = {}
for key, count in pairs(manifest) do
local moved = store.move(from, to, key, count)
if moved > 0 then
local name = store.parse(key)
drained[name] = (drained[name] or 0) + moved
end
end
return drained
end






