function store.key(name, nbt)
if nbt == nil or nbt == "" then return name end
return name .. "#" .. nbt
end





function store.parse(key)
local name, sep, rest = key:match("^([^#@]+)([#@])(.+)$")
if name then
if sep == "#" then return name, rest, nil end
return name, nil, rest
end
return key, nil, nil
end






















function store.selector(sel)
if type(sel) == "table" then return sel end
if type(sel) ~= "string" or sel == "" then return nil end
if sel:sub(1, 1) == "#" then return {name = sel} end
local name, hash, fingerprint = store.parse(sel)
return {name = name, hash = hash, fingerprint = fingerprint}
end

local function isTag(selector)
return type(selector.name) == "string" and selector.name:sub(1, 1) == "#"
end


local function exactKey(selector)
if isTag(selector) or not selector.name then return nil end
if selector.hash then return store.key(selector.name, selector.hash) end
if selector.fingerprint then return selector.name .. "@" .. selector.fingerprint end
return nil
end







local VARIANTS = "variants"
local variantPairs = nil

local function variants()
if not variantPairs then
variantPairs = state.read(VARIANTS, {})
if type(variantPairs) ~= "table" then variantPairs = {} end
end
return variantPairs
end

local function pairVariant(fingerprint, key)
local known = variants()
if known[fingerprint] == key then return end
known[fingerprint] = key
state.write(VARIANTS, known)
end












local attrs = {}

local netReads = {}

function store.forget()
attrs = {}
netReads = {}
variantPairs = nil
index.reset()
end









local function learn(key, device, slot)
local known = attrs[key]
if known and known.maxCount then return known end
if not device or not slot then return known end

local detail = hal.inventory().detail(device, slot)
if not detail then return known end

attrs[key] = {
maxCount = detail.maxCount,
tags = detail.tags or (known and known.tags) or {},
displayName = (known and known.displayName) or detail.displayName,
}
return attrs[key]
end



local function stackLimit(key, sample)
local known = attrs[key]
if (not known or not known.maxCount) and sample then
known = learn(key, sample.device, sample.slot)
end
if known and known.maxCount then return known.maxCount, true end
return ASSUMED_STACK, false
end

local function tagsOf(key, sample)
local known = attrs[key]
if not known and sample then known = learn(key, sample.device, sample.slot) end
return known and known.tags or nil
end






local function satisfies(selector, key, sample)


if selector.plain then
local _, hash, fingerprint = store.parse(key)
if hash or fingerprint then return false, true end
end
if isTag(selector) then
local tags = tagsOf(key, sample)
if not tags then return false, false end
return tags[selector.name:sub(2)] == true, true
end
local name, hash, fingerprint = store.parse(key)
if selector.name and name ~= selector.name then return false, true end
if selector.hash then return hash == selector.hash, true end
if selector.fingerprint then

return fingerprint == selector.fingerprint
or variants()[selector.fingerprint] == key, true
end
return selector.name ~= nil, true
end






local function cacheable(record)
return record.coherence == mount.EXCLUSIVE
end

local function listingOf(device, useCache)
if useCache then
local entry = index.get(device)
if entry then return entry.listing, entry.size end
end

local inv = hal.inventory()
local listing = inv.list(device)
if not listing then return nil, nil end
local size = inv.size(device) or 0

if useCache then index.put(device, listing, size) end
return listing, size
end
















local function devicesOf(path, record)
local present, missing = mount.devices(path)
if missing and #missing > 0 and record.marks and not mount.isSignal(record) then
local rebound = marks.recover(path, missing)
if #rebound > 0 then
if store.onRebind then
for _, event in ipairs(rebound) do pcall(store.onRebind, path, event) end
end
record = mount.get(path)
present, missing = mount.devices(path)
end
end
return record, present or {}, missing or {}
end

